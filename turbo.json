{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".prettierrc*",
    "tsconfig.json",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsup.config.*", "package.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "@anipotts/www#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "tsconfig.json",
        "package.json",
        "astro.config.mjs",
        "wrangler.toml"
      ],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "PUBLIC_POSTHOG_KEY", "PUBLIC_TURNSTILE_SITE_KEY"]
    },
    "@anipotts/admin#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "next.config.ts",
        "tailwind.config.mjs"
      ],
      "env": [
        "NODE_ENV",
        "ADMIN_PASSWORD",
        "ADMIN_TOTP_SECRET",
        "BUTTONDOWN_API_KEY",
        "TYPEFULLY_API_KEY",
        "TYPEFULLY_SOCIAL_SET_ID",
        "QUANTERCISE_ADMIN_TOKEN",
        "QUANTERCISE_BASE_URL"
      ]
    },
    "@anipotts/labs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "content/experiments/**",
        "tsconfig.json",
        "package.json",
        "next.config.ts",
        "tailwind.config.mjs"
      ],
      "env": ["NODE_ENV", "SKIP_LABS_FETCH"]
    },
    "@anipotts/admin-solid#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "app.config.ts",
        "wrangler.toml"
      ],
      "outputs": [".output/**", ".vinxi/**"],
      "env": ["NODE_ENV", "PUBLIC_STATE_API"]
    },
    "@anipotts/state#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "wrangler.toml"],
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "eslint.config.*", "package.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.*", "package.json"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
