{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".prettierrc*",
    "tsconfig.json",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsup.config.*", "package.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "@anipotts/www#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "next.config.ts",
        "tailwind.config.mjs"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "RESEND_API_KEY",
        "GITHUB_TOKEN"
      ]
    },
    "@anipotts/admin#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "next.config.ts",
        "tailwind.config.mjs"
      ],
      "env": [
        "NODE_ENV",
        "ADMIN_PASSWORD",
        "ADMIN_TOTP_SECRET",
        "BUTTONDOWN_API_KEY",
        "TYPEFULLY_API_KEY",
        "TYPEFULLY_SOCIAL_SET_ID"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "eslint.config.*", "package.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.*", "package.json"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
