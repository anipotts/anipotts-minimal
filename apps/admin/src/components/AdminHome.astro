---
import AdminLayout from "../layouts/AdminLayout.astro";
import { SourceMark } from "./SourceMark";
import AttentionRow from "./AttentionRow.astro";
import { readAdminInbox, type AdminInboxItem } from "../data/inbox";
import { readOperatorWorkProjection } from "../data/operator-work";

const [inbox, work] = await Promise.all([
  readAdminInbox(Astro.locals.runtime?.env.DB),
  Promise.resolve(readOperatorWorkProjection()),
]);

const categories = ["work", "content", "life", "fleet", "system"] as const;
const requestedCategory = Astro.url.searchParams.get("category");
const selectedCategory = categories.find(
  (category) => category === requestedCategory,
);
const visibleItems = selectedCategory
  ? inbox.items.filter((item) => item.category === selectedCategory)
  : inbox.items;
const topItems = visibleItems.slice(0, 4);
const remainingItems = visibleItems.slice(4);
const beingHandled = work.task_states.filter(
  (task) =>
    task.operator_state === "working" || task.operator_state === "review",
);

const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
const humanize = (value: string) => value.replaceAll("_", " ");
const domainHref = (item: AdminInboxItem) => {
  if (item.category === "work") {
    return `/work?view=now&entity=${encodeURIComponent(item.entity_id)}`;
  }
  if (item.category === "content") {
    return `/content?entity=${encodeURIComponent(item.entity_id)}`;
  }
  if (item.category === "life") {
    return `/life?entity=${encodeURIComponent(item.entity_id)}`;
  }
  if (item.category === "fleet") {
    return `/fleet?entity=${encodeURIComponent(item.entity_id)}`;
  }
  return item.href.startsWith("/") ? item.href : "/proof";
};
const linkedTaskFor = (item: AdminInboxItem) =>
  work.task_states.find(
    (task) =>
      task.attention_ref === item.id ||
      task.primary_entity_ref === item.entity_id ||
      task.entity_refs.includes(item.entity_id),
  );
---

<AdminLayout title="inbox" hideHeader>
  <main class="operator-page operator-inbox-page">
    <header class="operator-page-header">
      <div>
        <p class="operator-eyebrow">attention</p>
        <h1 class:list={[import.meta.env.DEV && "ap-structural-candidate"]}>
          Inbox
        </h1>
      </div>
      <div class="operator-header-actions">
        <span class={`operator-freshness is-${inbox.mode}`}>
          <span aria-hidden="true"></span>
          {inbox.mode}
        </span>
        <a class="operator-search-link" href="/knowledge">
          search
          <kbd>⌘K</kbd>
        </a>
      </div>
    </header>

    <div class="operator-inbox-summary" aria-label="attention summary">
      <strong>{inbox.counts.total}</strong>
      <span>open</span>
      <span>{inbox.counts.high} urgent</span>
      <time datetime={inbox.generated_at}>
        checked {displayTime(inbox.generated_at)}
      </time>
    </div>

    <nav
      class="operator-segmented-filter inbox-category-filter"
      aria-label="filter attention by domain"
    >
      <a
        href="/"
        class:list={[!selectedCategory && "is-active"]}
        aria-current={!selectedCategory ? "page" : undefined}>all</a
      >
      {
        categories.map((category) => (
          <a
            href={`/?category=${category}`}
            class:list={[selectedCategory === category && "is-active"]}
            aria-current={selectedCategory === category ? "page" : undefined}
          >
            {category}
          </a>
        ))
      }
    </nav>

    <section
      class="operator-attention"
      aria-labelledby="attention-title"
      data-attention-projection
    >
      <div class="operator-section-heading">
        <div>
          <h2 id="attention-title">
            {selectedCategory ? humanize(selectedCategory) : "ranked actions"}
          </h2>
        </div>
        <span>{visibleItems.length}</span>
      </div>

      <ol class="operator-attention-list">
        {
          topItems.map((item, index) => (
            <AttentionRow
              item={item}
              index={index}
              linkedTask={linkedTaskFor(item)}
              domainHref={domainHref(item)}
            />
          ))
        }
      </ol>
    </section>

    <section class="operator-handled" aria-labelledby="being-handled-title">
      <div class="operator-section-heading">
        <div>
          <h2 id="being-handled-title">being handled</h2>
        </div>
        <a href="/work?view=now">open Work</a>
      </div>
      <div class="operator-handled-strip">
        {
          beingHandled.map((task) => (
            <a
              href={`/work?view=now#task-${task.task_id}`}
              class="operator-handled-item"
            >
              <SourceMark provider={task.provider} compact />
              <div>
                <strong>{task.canonical_title}</strong>
                <span>{task.bounded_goal}</span>
              </div>
              <time datetime={task.last_observed_at}>
                {displayTime(task.last_observed_at)}
              </time>
            </a>
          ))
        }
      </div>
    </section>

    {
      remainingItems.length > 0 && (
        <details class="operator-attention-more">
          <summary>
            <span>later and waiting</span>
            <strong>{remainingItems.length}</strong>
          </summary>
          <ol class="operator-attention-list is-secondary">
            {remainingItems.map((item, index) => (
              <AttentionRow
                item={item}
                index={index + topItems.length}
                linkedTask={linkedTaskFor(item)}
                domainHref={domainHref(item)}
              />
            ))}
          </ol>
        </details>
      )
    }
  </main>

  <script is:inline data-astro-rerun>
    (() => {
      const itemId = new URLSearchParams(location.search).get("item");
      if (!itemId) return;
      const item = document.querySelector(
        `[data-attention-id="${CSS.escape(itemId)}"]`,
      );
      if (item instanceof HTMLElement) {
        item.dataset.linked = "true";
        item.scrollIntoView({ block: "center" });
      }
    })();
  </script>
</AdminLayout>
