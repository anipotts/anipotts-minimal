---
import apMarkDark from "../../assets/ap-mark-dark-blue.svg?url";

type Props = {
  title: string;
  subtitle: string;
  eyebrow?: string;
};

const { title, subtitle, eyebrow } = Astro.props;
---

<div class="passkey-entry">
  <aside class="passkey-entry__rail" aria-label="anipotts admin">
    <img
      class="passkey-entry__mark"
      src={apMarkDark}
      alt=""
      aria-hidden="true"
    />
  </aside>

  <section class="passkey-entry__main" aria-labelledby="auth-title">
    <div class="passkey-entry__content">
      {eyebrow && <p class="passkey-entry__eyebrow">{eyebrow}</p>}
      <h1 id="auth-title" data-auth-title>{title}</h1>
      <p class="passkey-entry__subtitle" data-auth-subtitle>{subtitle}</p>
      <div class="passkey-entry__actions">
        <slot />
      </div>
    </div>
  </section>
</div>

<style is:global>
  .admin-auth-frame:has(.passkey-entry) {
    display: block;
    min-height: 100svh;
    padding: 0;
    background: #ffffff;
  }

  .admin-auth-card:has(.passkey-entry) {
    width: 100%;
    min-height: 100svh;
  }

  .passkey-entry {
    --auth-ink: #11111b;
    --auth-muted: #6c6d79;
    --auth-surface: #ffffff;
    --auth-rail: #11111b;
    --auth-focus: #1677ff;
    display: flex;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--auth-surface);
    color: var(--auth-ink);
    font-family: var(
      --font-family-body,
      "Instrument Sans Variable",
      sans-serif
    );
  }

  .passkey-entry__rail {
    flex: 0 0 clamp(248px, 20vw, 320px);
    min-height: 100svh;
    padding: clamp(72px, 9.5vh, 104px) clamp(48px, 6.5vw, 96px);
    background: var(--auth-rail);
  }

  .passkey-entry__mark {
    display: block;
    width: 39px;
    height: auto;
    margin-top: 5px;
    filter: brightness(0) invert(1);
  }

  .passkey-entry__main {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    min-width: 0;
    min-height: 100svh;
    padding: 0 24px 0 clamp(88px, 16vw, 232px);
  }

  .passkey-entry__content {
    width: min(530px, 100%);
    transform: translateY(2vh);
  }

  .passkey-entry__eyebrow,
  .passkey-entry__content h1,
  .passkey-entry__subtitle,
  .auth-message,
  .auth-detail {
    margin: 0;
  }

  .passkey-entry__eyebrow {
    margin-bottom: 14px;
    color: var(--auth-muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .passkey-entry__content h1 {
    color: var(--auth-ink);
    font-size: clamp(42px, 3.35vw, 52px);
    font-weight: 680;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .passkey-entry__subtitle {
    margin-top: 20px;
    color: var(--auth-muted);
    font-size: 20px;
    line-height: 1.4;
  }

  .passkey-entry__actions {
    margin-top: 42px;
  }

  .auth-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 88px;
    border: 1px solid var(--auth-ink);
    border-radius: 12px;
    background: var(--auth-ink);
    color: #ffffff;
    padding: 18px 24px;
    font: inherit;
    font-size: 20px;
    font-weight: 620;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }

  .auth-primary:hover {
    background: #1a1a26;
  }

  .auth-primary:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .auth-primary:focus-visible,
  .auth-link:focus-visible,
  .auth-input:focus-visible,
  .auth-quiet-button:focus-visible {
    outline: 2px solid var(--auth-focus);
    outline-offset: 3px;
  }

  .auth-link-row {
    display: flex;
    align-items: center;
    gap: 44px;
    margin-top: 38px;
  }

  .auth-link,
  .auth-quiet-button {
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--auth-muted);
    padding: 9px 0;
    font: inherit;
    font-size: 18px;
    line-height: 1.4;
    text-decoration: none;
    cursor: pointer;
  }

  .auth-link:hover,
  .auth-quiet-button:hover {
    color: var(--auth-ink);
  }

  .auth-message,
  .auth-detail {
    color: var(--auth-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .auth-message {
    min-height: 24px;
    margin-top: 22px;
  }

  .auth-form {
    display: grid;
    gap: 18px;
  }

  .auth-field {
    display: grid;
    gap: 9px;
  }

  .auth-field span {
    color: var(--auth-muted);
    font-size: 14px;
    font-weight: 580;
  }

  .auth-input {
    width: 100%;
    min-height: 56px;
    border: 1px solid #d6d7dc;
    border-radius: 10px;
    background: transparent;
    color: var(--auth-ink);
    padding: 14px 16px;
    font: inherit;
    font-size: 17px;
  }

  .auth-phone {
    display: grid;
    gap: 24px;
  }

  .auth-qr-frame {
    display: grid;
    place-items: center;
    width: 204px;
    min-height: 204px;
    border: 1px solid #e1e1e5;
    border-radius: 12px;
    background: #ffffff;
    padding: 12px;
  }

  .auth-qr-frame img {
    display: block;
    width: 180px;
    height: 180px;
  }

  .auth-qr-frame img[hidden] {
    display: none;
  }

  .auth-qr-label {
    width: 150px;
    color: #6c6d79;
    font-size: 14px;
    line-height: 1.45;
    text-align: center;
  }

  .auth-state[hidden] {
    display: none;
  }

  html[data-theme="dark"] .passkey-entry {
    --auth-ink: #f5f5f7;
    --auth-muted: #a9a9b3;
    --auth-surface: #11111b;
    --auth-rail: #08080f;
  }

  html[data-theme="dark"] .admin-auth-frame:has(.passkey-entry) {
    background: #11111b;
  }

  html[data-theme="dark"] .auth-primary {
    border-color: #f5f5f7;
    background: #f5f5f7;
    color: #11111b;
  }

  html[data-theme="dark"] .auth-primary:hover {
    background: #ffffff;
  }

  html[data-theme="dark"] .auth-input {
    border-color: #373743;
  }

  @media (max-width: 820px) {
    .passkey-entry {
      display: block;
      overflow: visible;
    }

    .passkey-entry__rail {
      display: flex;
      align-items: center;
      min-height: 112px;
      padding: 0 24px;
    }

    .passkey-entry__mark {
      width: 29px;
      margin-top: 0;
    }

    .passkey-entry__main {
      display: block;
      min-height: calc(100svh - 112px);
      padding: clamp(86px, 14vh, 118px) 24px 48px;
    }

    .passkey-entry__content {
      width: 100%;
      margin: 0;
      transform: none;
    }

    .passkey-entry__content h1 {
      font-size: clamp(38px, 11vw, 44px);
    }

    .passkey-entry__subtitle {
      margin-top: 14px;
      font-size: 17px;
    }

    .passkey-entry__actions {
      margin-top: 34px;
    }

    .auth-primary {
      min-height: 58px;
      border-radius: 10px;
      font-size: 17px;
    }

    .auth-link-row {
      justify-content: flex-start;
      gap: 30px;
      margin-top: 24px;
    }

    .auth-link,
    .auth-quiet-button {
      font-size: 16px;
    }
  }

  @media (max-width: 390px) {
    .passkey-entry__main {
      padding-top: 78px;
    }

    .auth-link-row {
      gap: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .passkey-entry *,
    .passkey-entry *::before,
    .passkey-entry *::after {
      scroll-behavior: auto !important;
      transition: none !important;
      animation: none !important;
    }
  }
</style>
