---
import { SourceMark } from "./SourceMark";
import type { OperatorTaskState } from "../data/operator-work";

type Props = {
  task: OperatorTaskState;
};

const { task } = Astro.props;
const humanize = (value: string) => value.replaceAll("_", " ");
const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
---

<tr id={`task-${task.task_id}`} data-task-id={task.task_id}>
  <td data-label="work">
    <div class="operator-task-identity">
      <SourceMark provider={task.provider} compact />
      <div>
        <strong>{task.canonical_title}</strong>
        <span>{task.project_label} · {task.owner}</span>
      </div>
    </div>
  </td>
  <td data-label="state">
    <span
      class={`operator-state is-${task.operator_state}`}
      title={`${task.runtime_state} runtime; ${task.lifecycle} lifecycle`}
    >
      <span aria-hidden="true"></span>
      {humanize(task.operator_state)}
    </span>
    <small>{humanize(task.runtime_state)} runtime</small>
  </td>
  <td data-label="now">
    <div class="operator-cell-stack">
      <strong>{task.bounded_goal}</strong>
      <span>{task.next_action}</span>
    </div>
  </td>
  <td data-label="observed">
    <div class="operator-cell-stack">
      <time datetime={task.last_observed_at}>
        {displayTime(task.last_observed_at)}
      </time>
      <span>{task.host}</span>
    </div>
  </td>
  <td class="operator-row-actions">
    <div class="operator-row-actions-inner">
      {
        task.attention_ref ? (
          <a
            href={`/?item=${encodeURIComponent(task.attention_ref)}`}
            aria-label={`open linked Inbox item for ${task.canonical_title}`}
          >
            inbox
          </a>
        ) : (
          <a href="/work?view=now">surface</a>
        )
      }
      <button
        type="button"
        data-inspect-task={task.task_id}
        aria-label={`inspect ${task.canonical_title}`}
      >
        inspect
      </button>
    </div>
  </td>
</tr>
