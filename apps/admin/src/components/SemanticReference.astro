---
import { iconForSemanticReference } from "./admin-icons";
import {
  isKnownSemanticReference,
  renderSemanticReference,
  semanticStateLabel,
  type SemanticReference,
} from "../data/semantic-reference";

type Props = {
  reference: SemanticReference;
  variant?: "value" | "compact" | "action";
  label?: string;
  showState?: boolean;
  class?: string;
};

const {
  reference,
  variant = "value",
  label,
  showState = false,
  class: className,
} = Astro.props;
const descriptor = renderSemanticReference(reference);
const Icon = iconForSemanticReference[reference.kind];
const stateLabel = semanticStateLabel(reference.source_state);
const rawValue = isKnownSemanticReference(reference)
  ? reference.value
  : stateLabel;
const formattedValue =
  isKnownSemanticReference(reference) &&
  ["calendar_event", "deadline", "source_time"].includes(reference.kind) &&
  Number.isFinite(Date.parse(reference.value))
    ? new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
      }).format(new Date(reference.value))
    : rawValue;
const visibleLabel =
  label ?? (variant === "action" ? descriptor.action_label : formattedValue);
const shouldShowState = showState && visibleLabel !== stateLabel;
const classes = [
  "semantic-reference",
  `is-${variant}`,
  `state-${reference.source_state}`,
  className,
];
---

{
  descriptor.element === "link" ? (
    <a
      class:list={classes}
      href={descriptor.href!}
      target={descriptor.target ?? undefined}
      rel={descriptor.rel ?? undefined}
      title={descriptor.title}
      aria-label={descriptor.aria_label}
      data-semantic-reference={reference.id}
      data-semantic-authority={reference.authority.kind}
    >
      <Icon
        size={variant === "compact" ? 16 : 18}
        weight="regular"
        aria-hidden="true"
      />
      <span>{visibleLabel}</span>
      {shouldShowState && <small>{stateLabel}</small>}
    </a>
  ) : descriptor.element === "button" ? (
    <button
      type="button"
      class:list={classes}
      title={descriptor.title}
      aria-label={descriptor.aria_label}
      data-semantic-open={reference.id}
      data-semantic-reference={reference.id}
      data-semantic-authority={reference.authority.kind}
    >
      <Icon
        size={variant === "compact" ? 16 : 18}
        weight="regular"
        aria-hidden="true"
      />
      <span>{visibleLabel}</span>
      {shouldShowState && <small>{stateLabel}</small>}
    </button>
  ) : (
    <span
      class:list={classes}
      title={descriptor.title}
      aria-label={descriptor.aria_label}
      data-semantic-reference={reference.id}
      data-semantic-authority={reference.authority.kind}
    >
      <Icon
        size={variant === "compact" ? 16 : 18}
        weight="regular"
        aria-hidden="true"
      />
      <span>{visibleLabel}</span>
      {shouldShowState && <small>{stateLabel}</small>}
    </span>
  )
}
