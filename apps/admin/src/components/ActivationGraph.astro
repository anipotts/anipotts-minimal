---
import type {
  ActivationGraphProjection,
  OperationalProjection,
} from "../data/activation-graph";

type Props = {
  projection: ActivationGraphProjection;
  selectedView: OperationalProjection | null;
};

const { projection, selectedView } = Astro.props;
const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
const humanize = (value: string) => value.replaceAll("_", " ");
---

<section class="activation-surface" aria-labelledby="activation-title">
  <header class="activation-focus">
    <div>
      <p>suggested foreground</p>
      <h2 id="activation-title">
        {projection.foreground?.title ?? "No current focus suggestion"}
      </h2>
      <span>{projection.foreground_reason}</span>
    </div>
    {
      projection.foreground && (
        <a href={projection.foreground.href}>open next surface</a>
      )
    }
  </header>

  <nav class="activation-lanes" aria-label="operational state projections">
    {
      projection.lanes.map((lane) => (
        <a
          href={lane.href}
          class:list={[
            `lane-${lane.key}`,
            lane.source_state === "stale" && "is-stale",
            selectedView === lane.key && "is-active",
          ]}
          aria-current={selectedView === lane.key ? "page" : undefined}
          title={lane.basis}
        >
          <strong>{lane.count}</strong>
          <span>{lane.label}</span>
          <small>
            {lane.source_state === "stale" ? "last verified" : "current"}
          </small>
        </a>
      ))
    }
  </nav>

  {
    projection.nodes.length > 0 && (
      <div class="activation-graph" data-activation-graph>
        {projection.nodes.map((node, index) => (
          <div class="activation-node-wrap">
            <article class={`activation-node layer-${node.layer}`}>
              <header>
                <span>{node.layer}</span>
                <small>{humanize(node.label)}</small>
              </header>
              <h3>{node.title}</h3>
              <p>{node.detail}</p>
              <footer>
                <span>{node.source}</span>
                {node.href && <a href={node.href}>inspect</a>}
              </footer>
            </article>
            {index < projection.nodes.length - 1 && (
              <span class="activation-edge" aria-hidden="true">
                <i />
                <small>
                  {humanize(projection.connections[index]!.relation)}
                </small>
              </span>
            )}
          </div>
        ))}
      </div>
    )
  }

  <footer class="activation-contract">
    <span>lanes are overlapping projections, not stored top-level states</span>
    <span>
      work last verified {displayTime(projection.work_last_verified_at)} · {
        projection.mode
      } attention source
    </span>
  </footer>
</section>
