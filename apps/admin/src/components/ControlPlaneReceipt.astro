---
import { readControlPlane } from "../data/control-plane";

const state = await readControlPlane(
  Astro.locals.runtime?.env.COMMAND_RELAY,
  2,
);
const latest = state.snapshot.commands[0] ?? null;
const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
---

<section
  class="operator-handled"
  aria-labelledby="control-plane-title"
  data-control-plane-receipt
  data-control-plane-state={latest?.state ?? "idle"}
>
  <div class="operator-section-heading">
    <div>
      <h2 id="control-plane-title">local execution proof</h2>
      <p>
        {
          state.snapshot.device_connected
            ? "ap-mini connected"
            : "ap-mini connection not currently verified"
        }
      </p>
    </div>
    <button
      type="button"
      class="operator-primary-action"
      data-control-plane-submit
      disabled={!state.available}>prove round trip</button
    >
  </div>

  <div class="operator-handled-strip">
    <article class="operator-handled-item">
      <span class="operator-source-mark" aria-label="ap-mini executor">
        <span class="operator-source-glyph" aria-hidden="true">AP</span>
        <span class="operator-source-label">ap-mini</span>
      </span>
      <div>
        <strong
          >{latest?.outcome?.summary ?? "no verified round trip yet"}</strong
        >
        <span>
          {
            latest
              ? `${latest.state} · ${latest.kind}`
              : (state.error ?? "ready for the first proof command")
          }
        </span>
      </div>
      {
        latest ? (
          <time datetime={latest.updated_at}>
            {displayTime(latest.updated_at)}
          </time>
        ) : (
          <span>idle</span>
        )
      }
    </article>

    <article class="operator-handled-item">
      <span class="operator-source-mark" aria-label="local journal proof">
        <span class="operator-source-glyph" aria-hidden="true">J</span>
        <span class="operator-source-label">journal</span>
      </span>
      <div>
        <strong>
          {latest?.proof ? "journal proof acknowledged" : "proof pending"}
        </strong>
        <span>
          {
            latest?.proof
              ? `${latest.proof.evidence_ref} · ${latest.proof.journal_head_hash.slice(0, 12)}`
              : "relay acknowledgement will appear here"
          }
        </span>
      </div>
      <a href="/proof">inspect</a>
    </article>
  </div>
  <p class="sr-only" aria-live="polite" data-control-plane-live></p>
</section>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector("[data-control-plane-receipt]");
    const button = root?.querySelector("[data-control-plane-submit]");
    const live = root?.querySelector("[data-control-plane-live]");
    if (!(button instanceof HTMLButtonElement) || !root) return;

    button.addEventListener("click", async () => {
      button.disabled = true;
      if (live) live.textContent = "Sending one proof command to ap-mini.";
      try {
        const idempotencyStorageKey = "admin:control-plane:idempotency";
        const idempotencyKey =
          sessionStorage.getItem(idempotencyStorageKey) ?? crypto.randomUUID();
        sessionStorage.setItem(idempotencyStorageKey, idempotencyKey);
        const response = await fetch("/api/admin/control-plane", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            idempotency_key: idempotencyKey,
            reason: "verify the admin to ap-mini durable execution round trip",
          }),
        });
        if (!response.ok) throw new Error("command was not accepted");
        const acceptedCommand = await response.json();
        const commandId = acceptedCommand?.command_id;
        if (!commandId) throw new Error("relay omitted the command identity");
        if (live)
          live.textContent = "Command accepted. Waiting for local proof.";
        const deadline = Date.now() + 30_000;
        while (Date.now() < deadline) {
          await new Promise((resolve) => window.setTimeout(resolve, 1_000));
          const snapshot = await fetch("/api/admin/control-plane", {
            headers: { accept: "application/json" },
          });
          if (!snapshot.ok) continue;
          const payload = await snapshot.json();
          const command = payload?.snapshot?.commands?.find(
            (entry) => entry.command_id === commandId,
          );
          if (command?.state === "succeeded" && command?.proof) {
            sessionStorage.removeItem(idempotencyStorageKey);
            if (live) live.textContent = "ap-mini proof acknowledged.";
            location.reload();
            return;
          }
          if (["failed", "expired"].includes(command?.state)) {
            throw new Error(`command ${command.state}`);
          }
        }
        throw new Error("proof acknowledgement timed out");
      } catch (error) {
        if (live) {
          live.textContent =
            error instanceof Error
              ? error.message
              : "control-plane request failed";
        }
        button.disabled = false;
      }
    });
  })();
</script>
