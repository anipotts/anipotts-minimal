---
import type { AdminInboxItem } from "../data/inbox";
import type { OperatorTaskState } from "../data/operator-work";

type Props = {
  item: AdminInboxItem;
  index: number;
  linkedTask?: OperatorTaskState;
  domainHref: string;
};

const { item, index, linkedTask, domainHref } = Astro.props;
const hasObservedTime = !item.updated_at.startsWith("1970-01-01");
const displayTime = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(value));
---

<li
  class={`operator-attention-row risk-${item.risk}`}
  data-attention-id={item.id}
  data-entity-id={item.entity_id}
  data-attention-status={item.status}
  data-attention-updated={item.updated_at}
>
  <span class="operator-attention-rank">
    {String(index + 1).padStart(2, "0")}
  </span>
  <a class="operator-domain-link" href={domainHref}>
    <span>{item.category}</span>
    <strong>{item.title}</strong>
  </a>
  <div class="operator-attention-reason">
    <span>{item.next_action}</span>
    <small>{item.summary}</small>
  </div>
  <div class="operator-attention-meta">
    <strong>{item.owner}</strong>
    <span>
      {
        linkedTask
          ? `${linkedTask.operator_state} · ${linkedTask.host}`
          : item.timeframe
      }
    </span>
    {
      hasObservedTime ? (
        <time datetime={item.updated_at}>{displayTime(item.updated_at)}</time>
      ) : (
        <span>source time unknown</span>
      )
    }
  </div>
  <a
    class="operator-primary-action"
    href={item.href}
    aria-label={`review ${item.title}`}
  >
    review
  </a>
</li>
