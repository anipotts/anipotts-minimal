---
import "@astryxdesign/core/reset.css";
import "@astryxdesign/core/astryx.css";
import "@astryxdesign/theme-neutral/theme.css";
import "../styles/admin.css";
import { AdminShell } from "../components/astryx/AdminShell";
import { navItems, routeTitle } from "../data/admin";
import candidateFaviconDark from "../assets/ap-structural-candidate/v0.1.0-candidate.1/icons/favicon-dark.svg?url";
import candidateFaviconLight from "../assets/ap-structural-candidate/v0.1.0-candidate.1/icons/favicon-light.svg?url";

let candidateStyles: string | undefined;
if (import.meta.env.DEV) {
  const [{ default: rawStyles }, { default: woff2Url }, { default: ttfUrl }] =
    await Promise.all([
      import("../assets/ap-structural-candidate/v0.1.0-candidate.1/css/ap-structural.css?raw"),
      import("../assets/ap-structural-candidate/v0.1.0-candidate.1/fonts/APStructuralDisplayBlack-v0.1.0-candidate.1.woff2?url"),
      import("../assets/ap-structural-candidate/v0.1.0-candidate.1/fonts/APStructuralDisplayBlack-v0.1.0-candidate.1.ttf?url"),
    ]);
  candidateStyles = rawStyles
    .replace(
      "../fonts/APStructuralDisplayBlack-v0.1.0-candidate.1.woff2",
      woff2Url,
    )
    .replace("../fonts/APStructuralDisplayBlack-v0.1.0-candidate.1.ttf", ttfUrl)
    .concat(
      '\n.operator-page-header h1.ap-structural-candidate { font-family: "AP Structural", "Urbanist", sans-serif; }\n',
    );
}

type Props = {
  title?: string;
  deck?: string;
  chrome?: "admin" | "auth";
  hideHeader?: boolean;
};

const {
  title = routeTitle(Astro.url.pathname),
  deck = "",
  chrome = "admin",
  hideHeader = false,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentRoute = `${currentPath}${Astro.url.search}`;
---

<!doctype html>
<html lang="en" data-astryx-theme="neutral">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-light-32.png?v=20260717a"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-dark-32.png?v=20260717a"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href="/favicon.svg?v=20260717a"
      type="image/svg+xml"
      sizes="any"
    />
    <link
      rel="icon"
      href="/favicon-light.svg?v=20260717a"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/favicon-dark.svg?v=20260717a"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=20260717a"
    />
    {
      import.meta.env.DEV && (
        <>
          <style
            is:inline
            data-font-candidate="ap-structural"
            set:html={candidateStyles}
          />
          <link
            rel="icon"
            href={candidateFaviconLight}
            type="image/svg+xml"
            media="(prefers-color-scheme: light)"
            data-font-candidate="ap-structural"
          />
          <link
            rel="icon"
            href={candidateFaviconDark}
            type="image/svg+xml"
            media="(prefers-color-scheme: dark)"
            data-font-candidate="ap-structural"
          />
        </>
      )
    }
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#11111b"
    />
    <title>{title} | anipotts admin</title>
    <script is:inline>
      (() => {
        const readPreference = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const stored =
          readPreference("admin-theme:v1") ?? readPreference("theme");
        const theme =
          stored === "dark" || stored === "light"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;

        document.documentElement.dataset.font = "instrument";
      })();
    </script>
  </head>
  <body>
    <AdminShell
      chrome={chrome}
      currentRoute={currentRoute}
      deck={deck}
      hideHeader={hideHeader}
      navItems={navItems}
      title={title}
    >
      <slot />
    </AdminShell>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggles = document.querySelectorAll("[data-theme-toggle]");

        const syncToggleLabels = () => {
          const isDark = root.dataset.theme === "dark";
          for (const toggle of toggles) {
            toggle.setAttribute("aria-pressed", String(isDark));
            const label = toggle.querySelector("[data-theme-label]");
            if (label) label.textContent = isDark ? "light mode" : "dark mode";
          }
        };

        const setTheme = (theme) => {
          root.dataset.theme = theme;
          try {
            localStorage.setItem("admin-theme:v1", theme);
          } catch {
            // The visible toggle still works for this page session.
          }
          syncToggleLabels();
        };

        for (const toggle of toggles) {
          toggle.addEventListener("click", () => {
            setTheme(root.dataset.theme === "dark" ? "light" : "dark");
          });
        }

        syncToggleLabels();
      })();
    </script>
  </body>
</html>
