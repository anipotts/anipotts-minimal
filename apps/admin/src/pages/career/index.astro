---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { CareerView } from "../../components/astryx/UnifiedShellViews";
import { loadAdminControlSnapshot } from "@anipotts/lib/admin-control";
import { selectAdminControlSource } from "../../data/admin-control-source";

const source = selectAdminControlSource(
  Astro.locals.runtime?.env.DB,
  Astro.url,
);
const snapshot = await loadAdminControlSnapshot(source.database);
---

<AdminLayout
  title="career"
  deck="Current search, commitments, and source state."
>
  <CareerView snapshot={snapshot} fixtureMode={source.fixtureMode} />
</AdminLayout>
