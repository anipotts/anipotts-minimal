---
import AdminLayout from "../layouts/AdminLayout.astro";
import { loadRuntimeOverlayResponse } from "../data/runtime";

const runtime = await loadRuntimeOverlayResponse();
const machines = ["ap-pro", "ap-mini"].map((name) => {
  const repos = runtime.overlays.filter((row) => row.machine === name);
  return {
    name,
    state:
      repos.length > 0 ? (runtime.available ? "live" : "stale") : "unknown",
    role: name === "ap-pro" ? "operator workstation" : "runtime host",
    repos,
    dirty: repos.reduce(
      (total, row) => total + (row.dirty_tracked_count ?? 0),
      0,
    ),
    drift: repos.filter((row) => (row.ahead ?? 0) > 0 || (row.behind ?? 0) > 0)
      .length,
  };
});
---

<AdminLayout title="fleet" hideHeader>
  <main class="quiet-page quiet-fleet-page">
    <header class="quiet-page-header">
      <h1 class:list={[import.meta.env.DEV && "ap-structural-candidate"]}>
        Fleet
      </h1>
      <span>
        reconciled {
          runtime.generated_at
            ? new Date(runtime.generated_at).toLocaleString()
            : "unknown"
        }
      </span>
    </header>

    <section class="quiet-machine-grid" aria-label="machines">
      {
        machines.map((machine) => (
          <article>
            <header>
              <h2>{machine.name}</h2>
              <span class={`quiet-machine-state is-${machine.state}`}>
                {machine.state}
              </span>
            </header>
            <p>{machine.role}</p>
            <dl>
              <div>
                <dt>repositories</dt>
                <dd>{machine.repos.length || "unknown"}</dd>
              </div>
              <div>
                <dt>tracked changes</dt>
                <dd>{machine.repos.length ? machine.dirty : "unknown"}</dd>
              </div>
              <div>
                <dt>drift</dt>
                <dd>{machine.repos.length ? machine.drift : "unknown"}</dd>
              </div>
              <div>
                <dt>agents</dt>
                <dd>see Work</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </section>

    <section class="quiet-fleet-matrix" aria-labelledby="repo-health-heading">
      <header>
        <h2 id="repo-health-heading">Repository health</h2>
        <a href="/repos">all repositories</a>
      </header>
      {
        runtime.overlays.length > 0 ? (
          <div role="table" aria-label="runtime repository health">
            <div role="row" class="quiet-matrix-header">
              <span role="columnheader">repository</span>
              <span role="columnheader">host</span>
              <span role="columnheader">branch</span>
              <span role="columnheader">pressure</span>
              <span role="columnheader">impact</span>
            </div>
            {runtime.overlays.map((row) => (
              <div role="row">
                <strong role="cell">{row.repo}</strong>
                <span role="cell">{row.machine}</span>
                <span role="cell">{row.branch || "unknown"}</span>
                <span role="cell">
                  {(row.dirty_tracked_count ?? 0) + (row.untracked_count ?? 0)}
                </span>
                <span role="cell">{row.deploy_impact}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="quiet-empty-state">
            No current repository state is available.
          </p>
        )
      }
    </section>

    {
      runtime.error && (
        <aside class="quiet-inline-notice">
          Runtime state is unavailable. The last known view remains read only.
        </aside>
      )
    }
  </main>
</AdminLayout>
