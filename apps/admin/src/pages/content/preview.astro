---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout
  title="content preview"
  deck="Preview route placeholder for D1-backed drafts before public-site publish."
>
  <section class="grid">
    <article class="panel">
      <p>draft model</p>
      <h2>not writing yet</h2>
      <p>
        Preview should read draft records, compare them to current public
        content, and show route-level impact.
      </p>
    </article>
    <article class="panel">
      <p>publish model</p>
      <h2>future gate</h2>
      <p>
        Publish stays explicit, logged, reversible, and proof-backed.
      </p>
    </article>
  </section>
</AdminLayout>
