---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readPageContentInventoryStore } from "../../../data/content";
import { readContentEditorState } from "../../../lib/content-editor";

const requestedPageKey = safeDecodePageKey(Astro.params.pageKey);
const pageKey =
  requestedPageKey === "new" || requestedPageKey === "writing:new"
    ? "writing:new"
    : requestedPageKey;
const pageContentState = await readPageContentInventoryStore(
  Astro.locals.runtime?.env.DB,
);
const pageRow = pageContentState.rows.find((row) => row.page_key === pageKey);
const editorState = await readContentEditorState(
  Astro.locals.runtime?.env.DB,
  pageKey,
);
const current = editorState.current;
const isNew = pageKey === "writing:new";
const latestDraft = editorState.latest_draft;
const latestDraftPublishable = latestDraft?.status === "published";
const tagText = current.tags.join(", ");
const currentRollbackReference =
  editorState.current_version > 0
    ? `page_content:${editorState.page_key}@v${editorState.current_version}`
    : `new_private_draft:${editorState.page_key}`;
const currentPublicRoute = routeForEditor(current.page_key, current.slug);

function safeDecodePageKey(value: string | undefined): string {
  if (!value) return "writing:new";
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
}

function routeForEditor(pageKey: string, slug: string): string {
  if (pageKey.startsWith("writing:")) return `/writing/${slug}`;
  if (pageKey.startsWith("project:")) return `/projects/${slug}`;
  if (pageKey === "home") return "/";
  return `/${pageKey.replaceAll("_", "/").replaceAll(":", "/")}`;
}
---

<AdminLayout
  title={isNew ? "new writing draft" : `edit ${editorState.page_key}`}
  deck="Focused writing surface. Save starts private; preview and history stay one click away."
>
  <section class="meta-strip" aria-label="content edit state">
    <span>{pageContentState.mode}</span>
    <span>{pageRow ? `${pageRow.field_count} source fields` : "new draft"}</span
    >
    <span>{editorState.current_version} public versions</span>
    <span>{editorState.revisions.length} revisions</span>
    <span>passkey session required</span>
  </section>

  <section class="editor-workspace" aria-labelledby="editor-fields-heading">
    <form
      class="owner-editor-form"
      aria-label={`${editorState.page_key} content editor`}
      data-editor-form
    >
      <input type="hidden" name="kind" value={current.kind} />
      <input type="hidden" name="page_key" value={current.page_key} />

      <div class="editor-main">
        <section class="editor-panel">
          <div class="section-head">
            <div>
              <p>{isNew ? "writing surface" : `${current.kind} content`}</p>
              <h2 id="editor-fields-heading">
                {isNew ? "write new draft" : current.title}
              </h2>
            </div>
            <span>{isNew ? "private default" : current.visibility}</span>
          </div>

          <div class="editor-field-grid">
            <label>
              <span>title</span>
              <input
                name="title"
                value={isNew ? "" : current.title}
                maxlength="160"
                required
              />
            </label>
            <label>
              <span>slug</span>
              <input
                name="slug"
                value={isNew ? "" : current.slug}
                maxlength="96"
                required
              />
            </label>
            <label>
              <span>date</span>
              <input name="date" type="date" value={current.date} required />
            </label>
            <label>
              <span>visibility</span>
              <select name="visibility">
                {
                  ["private", "draft", "hidden", "published"].map((option) => (
                    <option
                      value={option}
                      selected={
                        isNew
                          ? option === "private"
                          : current.visibility === option
                      }
                    >
                      {option}
                    </option>
                  ))
                }
              </select>
            </label>
            <label class="wide-field">
              <span>summary</span>
              <textarea name="summary" rows="3" maxlength="600" required>
                {isNew ? "" : current.summary}
              </textarea>
            </label>
            <label class="wide-field">
              <span>tags</span>
              <input
                name="tags"
                value={isNew ? "" : tagText}
                placeholder="agents, codex, admin"
              />
            </label>
            <label class="wide-field">
              <span>body</span>
              <textarea name="body" rows="18" required>
                {isNew ? "" : current.body}
              </textarea>
            </label>
          </div>

          <div class="draft-control-row page-editor-actions">
            <button class="button" type="button" data-save-draft>
              save draft
            </button>
            <a
              class:list={[
                "button",
                "secondary",
                !latestDraft && "disabled-link",
              ]}
              href={latestDraft?.view_href ?? "#"}
              data-preview-link
            >
              preview draft
            </a>
            <button
              class="button secondary danger"
              type="button"
              data-publish-draft
              data-operation-id={latestDraft?.id ?? ""}
              data-publish-route={currentPublicRoute}
              data-publish-version={String(editorState.current_version + 1)}
              data-publish-visibility={latestDraft?.status ??
                current.visibility}
              data-publish-rollback={latestDraft?.rollback_target ??
                currentRollbackReference}
              disabled={!latestDraftPublishable}
            >
              publish selected draft
            </button>
            <span data-editor-status>
              {
                latestDraft
                  ? `latest draft ${latestDraft.id}`
                  : "new content starts as a private draft"
              }
            </span>
          </div>
        </section>

        <section class="table-card operation-card">
          <div class="section-head">
            <div>
              <p>current public record</p>
              <h2>{pageRow ? pageRow.summary : "none yet"}</h2>
            </div>
            <span>{pageRow?.published ? "published" : "not public"}</span>
          </div>
          <div class="record-list">
            <article class="record-row">
              <div>
                <p>
                  {editorState.page_key} / v{editorState.current_version}
                </p>
                <h3>
                  {
                    pageRow
                      ? "publishing creates a new page_content version"
                      : "saving does not create public page_content"
                  }
                </h3>
              </div>
              <dl>
                <div>
                  <dt>source</dt>
                  <dd>{pageRow?.source_ref ?? "new D1 draft"}</dd>
                </div>
                <div>
                  <dt>updated</dt>
                  <dd>{pageRow?.updated_at || "not published"}</dd>
                </div>
                <div>
                  <dt>updated by</dt>
                  <dd>{pageRow?.updated_by || "unknown"}</dd>
                </div>
                <div>
                  <dt>draft storage</dt>
                  <dd>content_draft_operations</dd>
                </div>
                <div>
                  <dt>public visibility</dt>
                  <dd>
                    {
                      current.visibility === "published"
                        ? "publish can make this public"
                        : "private, draft, and hidden stay out of public readers"
                    }
                  </dd>
                </div>
              </dl>
            </article>
          </div>
        </section>
      </div>
    </form>

    <aside class="editor-side">
      <section class="table-card">
        <div class="section-head">
          <div>
            <p>revision history</p>
            <h2>{editorState.revisions.length} entries</h2>
          </div>
          <span>rollback reference only</span>
        </div>
        <div class="record-list">
          {
            editorState.revisions.length === 0 ? (
              <article class="record-row">
                <div>
                  <p>empty</p>
                  <h3>No saved revisions for this page key yet.</h3>
                </div>
              </article>
            ) : (
              editorState.revisions.map((revision) => (
                <article class="record-row revision-row">
                  <div>
                    <p>
                      {revision.source} / {revision.status}
                    </p>
                    <h3>{revision.summary}</h3>
                  </div>
                  <dl>
                    <div>
                      <dt>time</dt>
                      <dd>{revision.timestamp}</dd>
                    </div>
                    <div>
                      <dt>author</dt>
                      <dd>{revision.author}</dd>
                    </div>
                    <div>
                      <dt>rollback reference</dt>
                      <dd>{revision.rollback_target}</dd>
                    </div>
                    <div>
                      <dt>action</dt>
                      <dd>
                        <a href={revision.view_href}>view version</a>
                      </dd>
                    </div>
                  </dl>
                </article>
              ))
            )
          }
        </div>
      </section>

      <nav class="inline-actions" aria-label="content editor navigation">
        <a class="button secondary" href="/content"> inventory </a>
        <a class="button secondary" href="/content/edit/new"> new writing </a>
        <a class="button secondary" href="/content/drafts"> drafts </a>
        <a class="button secondary" href="/content/preview"> preview </a>
        <a class="button secondary" href="/content/operations"> history </a>
      </nav>
    </aside>
  </section>

  <dialog class="publish-dialog" data-publish-dialog>
    <div class="publish-dialog-inner">
      <div>
        <p>publish selected draft</p>
        <h2 data-publish-title>{current.title}</h2>
      </div>
      <dl>
        <div>
          <dt>route</dt>
          <dd data-publish-dialog-route>{currentPublicRoute}</dd>
        </div>
        <div>
          <dt>version</dt>
          <dd data-publish-dialog-version>
            v{editorState.current_version + 1}
          </dd>
        </div>
        <div>
          <dt>visibility</dt>
          <dd data-publish-dialog-visibility>
            {latestDraft?.status ?? current.visibility}
          </dd>
        </div>
        <div>
          <dt>rollback reference</dt>
          <dd data-publish-dialog-rollback>
            {latestDraft?.rollback_target ?? currentRollbackReference}
          </dd>
        </div>
      </dl>
      <p>
        publish writes public page_content and content_publish_events only. it
        does not send newsletters, deploy, or write source files.
      </p>
      <div class="publish-dialog-actions">
        <button class="button ghost" type="button" data-cancel-publish>
          cancel
        </button>
        <button class="button danger" type="button" data-confirm-publish>
          confirm publish
        </button>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script>
  type EditorResponse = {
    ok?: boolean;
    operation_id?: string;
    preview_href?: string;
    publishable?: boolean;
    public_route?: string;
    next_version?: number;
    rollback_ref?: string;
    visibility?: string;
    title?: string;
    slug?: string;
    version?: number;
    error?: string;
  };

  const form = document.querySelector<HTMLFormElement>("[data-editor-form]");
  const saveButton =
    document.querySelector<HTMLButtonElement>("[data-save-draft]");
  const publishButton = document.querySelector<HTMLButtonElement>(
    "[data-publish-draft]",
  );
  const previewLink = document.querySelector<HTMLAnchorElement>(
    "[data-preview-link]",
  );
  const statusNode = document.querySelector<HTMLElement>(
    "[data-editor-status]",
  );
  const publishDialog = document.querySelector<HTMLDialogElement>(
    "[data-publish-dialog]",
  );
  const confirmPublishButton = document.querySelector<HTMLButtonElement>(
    "[data-confirm-publish]",
  );
  const cancelPublishButton = document.querySelector<HTMLButtonElement>(
    "[data-cancel-publish]",
  );

  saveButton?.addEventListener("click", () => void saveDraft());
  publishButton?.addEventListener("click", () => openPublishDialog());
  confirmPublishButton?.addEventListener("click", () => void publishDraft());
  cancelPublishButton?.addEventListener("click", () => publishDialog?.close());

  async function saveDraft() {
    if (!form || !saveButton) return;
    saveButton.disabled = true;
    setText(statusNode, "saving draft to D1");

    try {
      const data = await postEditor({
        action: "save_draft",
        ...Object.fromEntries(new FormData(form).entries()),
      });
      if (!data.ok || !data.operation_id) {
        throw new Error(data.error ?? "draft save failed");
      }
      if (previewLink && data.preview_href) {
        previewLink.href = data.preview_href;
        previewLink.classList.remove("disabled-link");
      }
      if (publishButton) {
        publishButton.dataset.operationId = data.operation_id;
        if (data.public_route) {
          publishButton.dataset.publishRoute = data.public_route;
        }
        if (data.next_version) {
          publishButton.dataset.publishVersion = String(data.next_version);
        }
        if (data.rollback_ref) {
          publishButton.dataset.publishRollback = data.rollback_ref;
        }
        if (data.visibility) {
          publishButton.dataset.publishVisibility = data.visibility;
        }
        publishButton.disabled = !data.publishable;
      }
      updatePublishDialog(data);
      setText(statusNode, `saved ${data.operation_id}`);
    } catch (error) {
      setText(
        statusNode,
        error instanceof Error ? error.message : "draft save failed",
      );
    } finally {
      saveButton.disabled = false;
    }
  }

  async function publishDraft() {
    if (!publishButton || !confirmPublishButton) return;
    const operationId = publishButton.dataset.operationId;
    if (!operationId) return;
    publishButton.disabled = true;
    confirmPublishButton.disabled = true;
    setText(statusNode, "publishing selected draft");

    try {
      const data = await postEditor({
        action: "publish",
        operation_id: operationId,
      });
      if (!data.ok) throw new Error(data.error ?? "publish failed");
      setText(
        statusNode,
        `published v${data.version} to ${data.public_route ?? "public route"}`,
      );
      publishDialog?.close();
    } catch (error) {
      setText(
        statusNode,
        error instanceof Error ? error.message : "publish failed",
      );
      publishButton.disabled = false;
      confirmPublishButton.disabled = false;
    }
  }

  function openPublishDialog() {
    if (!publishButton || publishButton.disabled) return;
    updatePublishDialog({});
    if (publishDialog?.showModal) {
      publishDialog.showModal();
    } else {
      void publishDraft();
    }
  }

  function updatePublishDialog(data: Partial<EditorResponse>) {
    if (!publishButton) return;
    const route = data.public_route ?? publishButton.dataset.publishRoute ?? "";
    const version =
      data.next_version ?? Number(publishButton.dataset.publishVersion || "0");
    const visibility =
      data.visibility ?? publishButton.dataset.publishVisibility ?? "draft";
    const rollback =
      data.rollback_ref ?? publishButton.dataset.publishRollback ?? "";
    const title =
      data.title ??
      String(form ? new FormData(form).get("title") : "selected draft");

    setText(document.querySelector("[data-publish-title]"), title);
    setText(document.querySelector("[data-publish-dialog-route]"), route);
    setText(
      document.querySelector("[data-publish-dialog-version]"),
      version ? `v${version}` : "next version",
    );
    setText(
      document.querySelector("[data-publish-dialog-visibility]"),
      visibility,
    );
    setText(document.querySelector("[data-publish-dialog-rollback]"), rollback);
  }

  async function postEditor(body: Record<string, FormDataEntryValue | string>) {
    const response = await fetch("/api/admin/content/editor", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(body),
    });
    const data = (await response.json()) as EditorResponse;
    if (!response.ok) {
      throw new Error(data.error ?? "content editor request failed");
    }
    return data;
  }

  function setText(node: Element | null, value: string) {
    if (node) node.textContent = value;
  }
</script>
