---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  contentInventory,
  contentInventorySource,
  readPageContentInventoryStore,
} from "../../data/content";
import {
  sourceContentRecords,
  sourceContentSummary,
} from "../../data/source-content";

const surfaces = [
  "homepage",
  "projects",
  "writing",
  "newsletter",
  "orchestrating",
] as const;
const pageContentState = await readPageContentInventoryStore(
  Astro.locals.runtime?.env.DB,
);
---

<AdminLayout
  title="content inventory"
  deck="Current editable public-site surfaces and their source refs. This is read-only inventory from the shared content model."
>
  <section class="meta-strip" aria-label="content inventory source">
    <span>{contentInventory.length} rows</span>
    <span>{pageContentState.row_count} page_content</span>
    <span>{pageContentState.published_count} published</span>
    <span>{pageContentState.mode}</span>
    <span>{contentInventorySource.mode}</span>
    <span>{contentInventorySource.source_doc}</span>
    <span>{sourceContentSummary.visible_projects} visible projects</span>
    <span>{sourceContentSummary.published_writing} published writing</span>
  </section>

  <section class="table-card">
    <div class="section-head">
      <div>
        <p>d1 page_content</p>
        <h2>{pageContentState.row_count} records</h2>
      </div>
      <span>read only</span>
    </div>
    <div class="record-list">
      {
        pageContentState.rows.length === 0 ? (
          <article class="record-row">
            <div>
              <p>{pageContentState.mode}</p>
              <h3>No published page_content rows are visible yet.</h3>
            </div>
            <dl>
              <div>
                <dt>source</dt>
                <dd>D1 page_content</dd>
              </div>
              <div>
                <dt>next</dt>
                <dd>
                  seed stable public copy before enabling any save or publish
                  path
                </dd>
              </div>
            </dl>
          </article>
        ) : (
          pageContentState.rows.map((row) => (
            <article class="record-row">
              <div>
                <p>
                  {row.page_key} / v{row.version} /{" "}
                  {row.published ? "published" : "draft"}
                </p>
                <h3>{row.summary}</h3>
              </div>
              <dl>
                <div>
                  <dt>source</dt>
                  <dd>{row.source_ref}</dd>
                </div>
                <div>
                  <dt>fields</dt>
                  <dd>{row.field_count}</dd>
                </div>
                <div>
                  <dt>source-backed</dt>
                  <dd>{row.source_backed_fields.length}</dd>
                </div>
                <div>
                  <dt>updated</dt>
                  <dd>{row.updated_at || "unknown"}</dd>
                </div>
                <div>
                  <dt>write state</dt>
                  <dd>no admin save or publish endpoint</dd>
                </div>
              </dl>
              <div class="inline-actions">
                <a
                  class="button secondary"
                  href={`/content/edit/${encodeURIComponent(row.page_key)}`}
                >
                  open editor
                </a>
              </div>
              <div class="field-grid" aria-label={`${row.page_key} d1 fields`}>
                {row.fields.slice(0, 16).map((field) => (
                  <div class="field-chip">
                    <span>{field.path}</span>
                    <strong>{field.value}</strong>
                    <small>{field.kind}</small>
                  </div>
                ))}
                {row.fields.length > 16 && (
                  <div class="field-chip muted-chip">
                    <span>more</span>
                    <strong>{row.fields.length - 16} fields hidden</strong>
                    <small>truncated</small>
                  </div>
                )}
              </div>
              {row.source_backed_fields.length > 0 && (
                <div class="field-gap">
                  <span>source-backed until schema exists</span>
                  <p>{row.source_backed_fields.join(", ")}</p>
                </div>
              )}
            </article>
          ))
        )
      }
    </div>
  </section>

  <section class="table-card operation-card">
    <div class="section-head">
      <div>
        <p>source content collections</p>
        <h2>
          {sourceContentSummary.projects} projects / {
            sourceContentSummary.writing
          }
          writing
        </h2>
      </div>
      <span>bundled read only</span>
    </div>
    <div class="record-list">
      {
        sourceContentRecords.map((record) => (
          <article class="record-row">
            <div>
              <p>
                {record.surface} / {record.status} / {record.body_words} words
              </p>
              <h3>{record.title}</h3>
            </div>
            <dl>
              <div>
                <dt>route</dt>
                <dd>{record.route}</dd>
              </div>
              <div>
                <dt>source</dt>
                <dd>{record.source_ref}</dd>
              </div>
              <div>
                <dt>summary</dt>
                <dd>{record.summary}</dd>
              </div>
              <div>
                <dt>body state</dt>
                <dd>{record.body_state}</dd>
              </div>
              <div>
                <dt>sections</dt>
                <dd>{record.body_section_count}</dd>
              </div>
              <div>
                <dt>next</dt>
                <dd>{record.next_safe_action}</dd>
              </div>
            </dl>
            <div class="body-preview">
              <span>markdown body preview</span>
              <p>{record.body_preview}</p>
            </div>
            <div class="field-grid" aria-label={`${record.slug} source fields`}>
              {record.fields.slice(0, 14).map((field) => (
                <div class="field-chip">
                  <span>{field.path}</span>
                  <strong>{field.value}</strong>
                  <small>{field.kind}</small>
                </div>
              ))}
              {record.fields.length > 14 && (
                <div class="field-chip muted-chip">
                  <span>more</span>
                  <strong>{record.fields.length - 14} fields hidden</strong>
                  <small>truncated</small>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <div class="surface-grid">
    {
      surfaces.map((surface) => {
        const rows = contentInventory.filter((row) => row.surface === surface);

        return (
          <section class="table-card">
            <div class="section-head">
              <div>
                <p>{surface}</p>
                <h2>{rows.length} fields</h2>
              </div>
              <span>
                {rows.filter((row) => row.editability === "ready").length} ready
              </span>
            </div>
            <div class="record-list">
              {rows.map((row) => (
                <article class="record-row">
                  <div>
                    <p>{row.title}</p>
                    <h3>{row.current_value}</h3>
                  </div>
                  <dl>
                    <div>
                      <dt>source</dt>
                      <dd>{row.source_ref}</dd>
                    </div>
                    <div>
                      <dt>editability</dt>
                      <dd>{row.editability}</dd>
                    </div>
                    <div>
                      <dt>risk</dt>
                      <dd>{row.risk_level}</dd>
                    </div>
                    <div>
                      <dt>next</dt>
                      <dd>{row.next_safe_action}</dd>
                    </div>
                  </dl>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</AdminLayout>
