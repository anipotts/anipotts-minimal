---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  contentInventory,
  contentInventorySource,
  readPageContentInventoryStore,
} from "../../data/content";

const surfaces = ["homepage", "projects", "writing", "newsletter"] as const;
const pageContentState = await readPageContentInventoryStore(
  Astro.locals.runtime?.env.DB,
);
---

<AdminLayout
  title="content inventory"
  deck="Current editable public-site surfaces and their source refs. This is read-only inventory from the shared content model."
>
  <section class="meta-strip" aria-label="content inventory source">
    <span>{contentInventory.length} rows</span>
    <span>{pageContentState.row_count} page_content</span>
    <span>{pageContentState.published_count} published</span>
    <span>{pageContentState.mode}</span>
    <span>{contentInventorySource.mode}</span>
    <span>{contentInventorySource.source_doc}</span>
  </section>

  <section class="table-card">
    <div class="section-head">
      <div>
        <p>d1 page_content</p>
        <h2>{pageContentState.row_count} records</h2>
      </div>
      <span>read only</span>
    </div>
    <div class="record-list">
      {
        pageContentState.rows.length === 0 ? (
          <article class="record-row">
            <div>
              <p>{pageContentState.mode}</p>
              <h3>No published page_content rows are visible yet.</h3>
            </div>
            <dl>
              <div>
                <dt>source</dt>
                <dd>D1 page_content</dd>
              </div>
              <div>
                <dt>next</dt>
                <dd>
                  seed stable public copy before enabling any save or publish
                  path
                </dd>
              </div>
            </dl>
          </article>
        ) : (
          pageContentState.rows.map((row) => (
            <article class="record-row">
              <div>
                <p>
                  {row.page_key} / v{row.version} /{" "}
                  {row.published ? "published" : "draft"}
                </p>
                <h3>{row.summary}</h3>
              </div>
              <dl>
                <div>
                  <dt>source</dt>
                  <dd>{row.source_ref}</dd>
                </div>
                <div>
                  <dt>fields</dt>
                  <dd>{row.field_count}</dd>
                </div>
                <div>
                  <dt>updated</dt>
                  <dd>{row.updated_at || "unknown"}</dd>
                </div>
                <div>
                  <dt>write state</dt>
                  <dd>no admin save or publish endpoint</dd>
                </div>
              </dl>
            </article>
          ))
        )
      }
    </div>
  </section>

  <div class="surface-grid">
    {
      surfaces.map((surface) => {
        const rows = contentInventory.filter((row) => row.surface === surface);

        return (
          <section class="table-card">
            <div class="section-head">
              <div>
                <p>{surface}</p>
                <h2>{rows.length} fields</h2>
              </div>
              <span>
                {rows.filter((row) => row.editability === "ready").length} ready
              </span>
            </div>
            <div class="record-list">
              {rows.map((row) => (
                <article class="record-row">
                  <div>
                    <p>{row.title}</p>
                    <h3>{row.current_value}</h3>
                  </div>
                  <dl>
                    <div>
                      <dt>source</dt>
                      <dd>{row.source_ref}</dd>
                    </div>
                    <div>
                      <dt>editability</dt>
                      <dd>{row.editability}</dd>
                    </div>
                    <div>
                      <dt>risk</dt>
                      <dd>{row.risk_level}</dd>
                    </div>
                    <div>
                      <dt>next</dt>
                      <dd>{row.next_safe_action}</dd>
                    </div>
                  </dl>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</AdminLayout>
