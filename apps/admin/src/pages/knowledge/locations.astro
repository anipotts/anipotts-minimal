---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readAdminKnowledge } from "../../data/knowledge";
import { loadRuntimeOverlayResponse } from "../../data/runtime";
import {
  DesktopTowerIcon,
  HardDrivesIcon,
  NavigationArrowIcon,
} from "@phosphor-icons/react";

const [runtime, knowledge] = await Promise.all([
  loadRuntimeOverlayResponse(),
  readAdminKnowledge(Astro.locals.runtime?.env.DB),
]);
const viewer = runtime.machine ?? "this device";
const machineNames = ["ap-pro", "ap-mini"] as const;
const machines = machineNames.map((name) => {
  const repos = runtime.overlays.filter((row) => row.machine === name);
  return {
    name,
    current: name === runtime.machine,
    role: name === "ap-pro" ? "operator workstation" : "runtime host",
    state:
      repos.length > 0 ? (runtime.available ? "live" : "stale") : "unknown",
    repos: repos.length,
  };
});
const places = knowledge.cards.filter((card) => card.kind === "place");
const displayTime = (value?: string | null) =>
  value
    ? new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
      }).format(new Date(value))
    : "unknown";
---

<AdminLayout title="locations" hideHeader>
  <main class="quiet-page quiet-locations-page">
    <header class="quiet-page-header">
      <h1 class:list={[import.meta.env.DEV && "ap-structural-candidate"]}>
        Locations
      </h1>
      <span>viewing from {viewer}</span>
    </header>

    <section class="quiet-location-overview" aria-labelledby="fleet-map-title">
      <header>
        <h2 id="fleet-map-title">Fleet map</h2>
        <span>{runtime.available ? "current" : "last known"}</span>
      </header>
      <div class="quiet-location-viewer">
        <NavigationArrowIcon size={20} weight="fill" aria-hidden="true" />
        <div>
          <strong>{viewer}</strong>
          <span>viewing from this device</span>
        </div>
      </div>
      <div class="quiet-location-machines" aria-label="fleet topology">
        {
          machines.map((machine) => (
            <article
              class:list={[
                "quiet-location-machine",
                machine.current && "is-current",
              ]}
              data-admin-focus-record={JSON.stringify({
                id: machine.name,
                kind: "machine",
                title: machine.name,
                currentFact: machine.role,
                status: machine.state,
                source: "runtime",
                href: `/fleet?entity=${encodeURIComponent(machine.name)}`,
                proof: `${machine.repos} repository observations`,
              })}
            >
              {machine.name === "ap-pro" ? (
                <DesktopTowerIcon
                  size={22}
                  weight="regular"
                  aria-hidden="true"
                />
              ) : (
                <HardDrivesIcon size={22} weight="regular" aria-hidden="true" />
              )}
              <div>
                <strong>{machine.name}</strong>
                <small>{machine.role}</small>
              </div>
              <span class={`quiet-machine-state is-${machine.state}`}>
                {machine.state}
              </span>
            </article>
          ))
        }
      </div>
      <footer>
        <span>
          physical location stays private until a trusted source provides it
        </span>
        <a href="/fleet">open Fleet</a>
      </footer>
    </section>

    <section class="quiet-known-places" aria-labelledby="known-places-title">
      <header>
        <h2 id="known-places-title">Known places</h2>
        <span>{places.length}</span>
      </header>
      {
        places.length > 0 ? (
          <div>
            {places.map((place) => (
              <article>
                <span>{place.source_system}</span>
                <strong>{place.title}</strong>
                <p>{place.summary}</p>
                <time datetime={place.observed_at ?? undefined}>
                  {displayTime(place.observed_at)}
                </time>
              </article>
            ))}
          </div>
        ) : (
          <p class="quiet-empty-state">
            No verified place records are available.
          </p>
        )
      }
    </section>
  </main>
</AdminLayout>
