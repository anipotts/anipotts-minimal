---
import AdminLayout from "../../layouts/AdminLayout.astro";

const requestedNext = Astro.url.searchParams.get("next");
const passkeyReturnPath = sanitizeAdminReturnPath(requestedNext);
const shouldAutoReturn = requestedNext !== null;

function sanitizeAdminReturnPath(path: string | null): string {
  if (!path) return "/proof";
  if (!path.startsWith("/") || path.startsWith("//") || path.includes("\\")) {
    return "/proof";
  }

  try {
    const parsed = new URL(path, "https://admin.anipotts.com");
    if (parsed.origin !== "https://admin.anipotts.com") return "/proof";
    if (parsed.pathname === "/auth/passkey") return "/proof";
    return `${parsed.pathname}${parsed.search}${parsed.hash}`;
  } catch {
    return "/proof";
  }
}
---

<AdminLayout title="sign in" chrome="auth" hideHeader>
  <span
    id="passkey-return-path"
    data-next-path={passkeyReturnPath}
    data-auto-return={String(shouldAutoReturn)}
    hidden></span>

  <section class="native-auth" aria-labelledby="native-auth-heading">
    <div class="native-auth-card">
      <header class="native-auth-header">
        <span class="native-auth-mark" aria-hidden="true">ap</span>
        <div>
          <h1 id="native-auth-heading">sign in</h1>
          <p>admin.anipotts.com</p>
        </div>
      </header>

      <div class="native-auth-tabs" role="tablist" aria-label="sign in method">
        <button
          id="password-tab"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="password-panel">password</button
        >
        <button
          id="passkey-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="passkey-panel">passkey</button
        >
      </div>

      <div
        class="native-auth-panel"
        id="password-panel"
        role="tabpanel"
        aria-labelledby="password-tab"
      >
        <form id="password-form" class="native-auth-form">
          <label for="admin-password">password</label>
          <div class="native-password-field">
            <input
              id="admin-password"
              name="password"
              type="password"
              autocomplete="current-password"
              maxlength="200"
              required
            />
            <button
              id="toggle-password"
              type="button"
              aria-label="show password">show</button
            >
          </div>
          <button id="password-submit" class="native-auth-primary" type="submit"
            >sign in</button
          >
          <p
            id="password-message"
            class="native-auth-message"
            aria-live="polite"
          >
            checking password access
          </p>
        </form>
      </div>

      <div
        class="native-auth-panel"
        id="passkey-panel"
        role="tabpanel"
        aria-labelledby="passkey-tab"
        hidden
      >
        <button
          class="passkey-card"
          id="passkey-unlock"
          type="button"
          aria-label="unlock admin"
        >
          <div class="passkey-sigil" aria-hidden="true">
            <span class="passkey-ring"></span>
            <span class="passkey-ring offset"></span>
            <span class="passkey-core"></span>
          </div>
          <span id="passkey-button-label">use passkey</span>
        </button>
        <p class="native-auth-message">touch id or your device passkey</p>
      </div>
    </div>

    <div class="passkey-hidden-state" hidden>
      <h1 id="passkey-heading">unlock admin</h1>
      <p id="passkey-next">checking secure route</p>
      <span id="passkey-db">checking</span>
      <span id="passkey-origin">expected origin: admin.anipotts.com</span>
      <span id="passkey-credentials">0</span>
      <span id="passkey-audit">0</span>
      <span id="passkey-register-state"
        >registration requires Access identity</span
      >
      <span id="passkey-session">inactive</span>
      <span id="passkey-message">passkey proof is staged behind Access.</span>
      <span id="passkey-return-label">{passkeyReturnPath}</span>
      <span id="passkey-runbook-summary">Access removal runbook</span>
      <span id="passkey-proof-summary">ready_for_access_removal</span>
      <ol id="passkey-runbook"></ol>
      <div id="passkey-proof-list"></div>
      <button id="register-passkey" type="button">register</button>
      <button id="login-passkey" type="button">authenticate</button>
      <button id="logout-passkey" type="button">logout</button>
      <button id="revoke-passkey" type="button">revoke</button>
      <a id="open-passkey-next" href={passkeyReturnPath}>open</a>
      <span>buildRunbookSteps</span>
    </div>
  </section>
</AdminLayout>

<script>
  import {
    startAuthentication,
    startRegistration,
  } from "@simplewebauthn/browser";
  import type {
    PublicKeyCredentialCreationOptionsJSON,
    PublicKeyCredentialRequestOptionsJSON,
  } from "@simplewebauthn/server";

  type ApiResult = {
    verified?: boolean;
    ok?: boolean;
    error?: string;
    detail?: string;
    next_safe_action?: string;
  };

  type PasskeyStatus = {
    available: boolean;
    mode: "ready" | "missing_db";
    credential_count: number;
    audit_count: number;
    has_session: boolean;
    can_register: boolean;
    access_identity_present: boolean;
    access_identity_hint: string | null;
    expected_origin: string;
    expected_rp_id: string;
    current_origin: string;
    audit_events: Record<string, number>;
    proof_items: PasskeyProofItem[];
    access_removal_blockers: string[];
    ready_for_access_removal: boolean;
    next_safe_action: string;
  };

  type PasskeyProofItem = {
    id: string;
    label: string;
    count: number;
    complete: boolean;
    next_safe_action: string;
  };

  type PasskeyRunbookStep = {
    label: string;
    detail: string;
    complete: boolean;
  };

  const authShell = document.querySelector<HTMLElement>(".auth-shell");
  const passwordTab =
    document.querySelector<HTMLButtonElement>("#password-tab");
  const passkeyTab = document.querySelector<HTMLButtonElement>("#passkey-tab");
  const passwordPanel = document.querySelector<HTMLElement>("#password-panel");
  const passkeyPanel = document.querySelector<HTMLElement>("#passkey-panel");
  const passwordForm =
    document.querySelector<HTMLFormElement>("#password-form");
  const passwordInput =
    document.querySelector<HTMLInputElement>("#admin-password");
  const passwordSubmit =
    document.querySelector<HTMLButtonElement>("#password-submit");
  const passwordMessage = document.querySelector("#password-message");
  const togglePassword =
    document.querySelector<HTMLButtonElement>("#toggle-password");
  const passkeyButtonLabel = document.querySelector("#passkey-button-label");
  const passkeyCard =
    document.querySelector<HTMLButtonElement>("#passkey-unlock");
  const dbLabel = document.querySelector("#passkey-db");
  const originLabel = document.querySelector("#passkey-origin");
  const credentialsLabel = document.querySelector("#passkey-credentials");
  const auditLabel = document.querySelector("#passkey-audit");
  const registerState = document.querySelector("#passkey-register-state");
  const sessionLabel = document.querySelector("#passkey-session");
  const nextLabel = document.querySelector("#passkey-next");
  const message = document.querySelector("#passkey-message");
  const runbookSummary = document.querySelector("#passkey-runbook-summary");
  const runbookList = document.querySelector("#passkey-runbook");
  const proofSummary = document.querySelector("#passkey-proof-summary");
  const proofList = document.querySelector("#passkey-proof-list");
  const registerButton =
    document.querySelector<HTMLButtonElement>("#register-passkey");
  const loginButton =
    document.querySelector<HTMLButtonElement>("#login-passkey");
  const logoutButton =
    document.querySelector<HTMLButtonElement>("#logout-passkey");
  const revokeButton =
    document.querySelector<HTMLButtonElement>("#revoke-passkey");
  const returnPathNode = document.querySelector<HTMLElement>(
    "#passkey-return-path",
  );
  const returnLink =
    document.querySelector<HTMLAnchorElement>("#open-passkey-next");
  const nextPath = returnPathNode?.dataset.nextPath ?? "/proof";
  const shouldAutoReturn = returnPathNode?.dataset.autoReturn === "true";

  let status: PasskeyStatus | null = null;
  let didAutoReturn = false;

  passwordTab?.addEventListener("click", () => selectMethod("password"));
  passkeyTab?.addEventListener("click", () => selectMethod("passkey"));
  passwordForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    void passwordLogin();
  });
  togglePassword?.addEventListener("click", () => {
    if (!passwordInput || !togglePassword) return;
    const showing = passwordInput.type === "text";
    passwordInput.type = showing ? "password" : "text";
    togglePassword.textContent = showing ? "show" : "hide";
    togglePassword.setAttribute(
      "aria-label",
      showing ? "show password" : "hide password",
    );
    passwordInput.focus();
  });
  passkeyCard?.addEventListener("click", () => void unlock());
  registerButton?.addEventListener("click", () => void register());
  loginButton?.addEventListener("click", () => void authenticate());
  logoutButton?.addEventListener("click", () => void logout());
  revokeButton?.addEventListener("click", () => void revokeCurrent());

  await Promise.all([refreshStatus(), refreshPasswordStatus()]);

  function selectMethod(method: "password" | "passkey") {
    const passwordSelected = method === "password";
    passwordTab?.setAttribute("aria-selected", String(passwordSelected));
    passkeyTab?.setAttribute("aria-selected", String(!passwordSelected));
    passwordPanel?.toggleAttribute("hidden", !passwordSelected);
    passkeyPanel?.toggleAttribute("hidden", passwordSelected);
    if (passwordSelected) passwordInput?.focus();
    else passkeyCard?.focus();
  }

  async function refreshPasswordStatus() {
    try {
      const response = await fetch("/api/admin/password/status", {
        cache: "no-store",
      });
      const passwordStatus = (await response.json()) as {
        available?: boolean;
        has_session?: boolean;
      };
      if (passwordSubmit) passwordSubmit.disabled = false;
      if (passwordInput) passwordInput.disabled = false;
      setText(
        passwordMessage,
        passwordStatus.has_session
          ? "signed in"
          : passwordStatus.available
            ? ""
            : "preview only until the owner password is configured",
      );
      if (passwordStatus.has_session && shouldAutoReturn) {
        window.location.assign(nextPath);
      }
    } catch {
      if (passwordSubmit) passwordSubmit.disabled = false;
      if (passwordInput) passwordInput.disabled = false;
      setText(passwordMessage, "password access is unavailable");
    }
  }

  async function passwordLogin() {
    if (!passwordInput || !passwordSubmit) return;
    passwordSubmit.disabled = true;
    setText(passwordMessage, "signing in");
    try {
      const response = await fetch("/api/admin/password/login", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ password: passwordInput.value }),
      });
      const result = (await response.json()) as {
        ok?: boolean;
        error?: string;
      };
      if (!response.ok || !result.ok) {
        throw new Error(
          result.error === "try_again_later"
            ? "too many attempts. try again in 15 minutes"
            : result.error === "password_unavailable"
              ? "password access is unavailable"
              : "password is incorrect",
        );
      }
      passwordInput.value = "";
      setText(passwordMessage, "signed in");
      window.location.assign(nextPath);
    } catch (error) {
      setText(passwordMessage, errorMessage(error));
      passwordInput.select();
    } finally {
      passwordSubmit.disabled = false;
    }
  }

  async function refreshStatus() {
    const response = await fetch("/api/admin/passkey/status", {
      cache: "no-store",
    });
    status = (await response.json()) as PasskeyStatus;
    renderStatus();
  }

  function renderStatus() {
    if (!status) return;
    const authState = status.has_session ? "signed-in" : "signed-out";
    authShell?.setAttribute("data-auth-state", authState);
    passkeyCard?.setAttribute("data-auth-state", authState);
    passkeyCard?.toggleAttribute(
      "disabled",
      !status.available ||
        (!status.has_session &&
          status.credential_count === 0 &&
          !status.can_register),
    );
    passkeyCard?.setAttribute(
      "aria-label",
      status.has_session
        ? "open admin"
        : status.credential_count > 0
          ? "unlock with passkey"
          : "create passkey",
    );
    setText(
      passkeyButtonLabel,
      status.has_session
        ? "open admin"
        : status.credential_count > 0
          ? "use passkey"
          : "create passkey",
    );
    loginButton?.classList.toggle(
      "passkey-primary",
      status.credential_count > 0,
    );
    loginButton?.classList.toggle("secondary", status.credential_count === 0);
    registerButton?.classList.toggle(
      "passkey-primary",
      status.credential_count === 0,
    );
    registerButton?.classList.toggle("secondary", status.credential_count > 0);
    setText(dbLabel, status.available ? "available" : "missing");
    setText(
      originLabel,
      `${status.current_origin} / rp ${status.expected_rp_id}`,
    );
    setText(credentialsLabel, String(status.credential_count));
    setText(auditLabel, String(status.audit_count));
    setText(
      proofSummary,
      status.ready_for_access_removal
        ? "ready for Access removal"
        : `${status.access_removal_blockers.length} blockers`,
    );
    setText(
      registerState,
      status.can_register
        ? "registration allowed"
        : "registration locked until Access identity or active session",
    );
    setText(sessionLabel, status.has_session ? "active" : "inactive");
    setText(nextLabel, status.next_safe_action);
    if (registerButton) registerButton.disabled = !status.can_register;
    if (loginButton) loginButton.disabled = !status.available;
    if (logoutButton) logoutButton.disabled = !status.has_session;
    if (revokeButton) revokeButton.disabled = !status.has_session;
    if (returnLink) {
      returnLink.href = nextPath;
      returnLink.setAttribute(
        "aria-disabled",
        status.has_session ? "false" : "true",
      );
    }
    renderRunbook();
    renderProofList();
    if (status.has_session && shouldAutoReturn && !didAutoReturn) {
      didAutoReturn = true;
      window.location.assign(nextPath);
    }
  }

  async function unlock() {
    if (!status) return;
    if (status.has_session) {
      window.location.assign(nextPath);
      return;
    }
    if (status.credential_count > 0) {
      await authenticate();
      return;
    }
    await register();
  }

  async function register() {
    await withBusy("starting passkey registration", async () => {
      const options = await postJson<PublicKeyCredentialCreationOptionsJSON>(
        "/api/admin/passkey/register-options",
      );
      const credential = await startRegistration({ optionsJSON: options });
      const result = await postJson(
        "/api/admin/passkey/register-verify",
        credential,
      );
      setText(message, result.next_safe_action ?? "passkey registered");
      await refreshStatus();
    });
  }

  async function authenticate() {
    await withBusy("starting passkey authentication", async () => {
      const options = await postJson<PublicKeyCredentialRequestOptionsJSON>(
        "/api/admin/passkey/login-options",
      );
      const assertion = await startAuthentication({ optionsJSON: options });
      const result = await postJson(
        "/api/admin/passkey/login-verify",
        assertion,
      );
      setText(message, result.next_safe_action ?? "passkey session active");
      await refreshStatus();
      if (shouldAutoReturn && status?.has_session) {
        setText(message, `passkey session active; opening ${nextPath}`);
        window.location.assign(nextPath);
      }
    });
  }

  async function logout() {
    await withBusy("clearing passkey session", async () => {
      const result = await postJson("/api/admin/passkey/logout");
      setText(message, result.next_safe_action ?? "session cleared");
      await refreshStatus();
    });
  }

  async function revokeCurrent() {
    const confirmed = window.confirm(
      "Revoke the current passkey for denial proof? Cloudflare Access must remain active so a replacement passkey can be registered.",
    );
    if (!confirmed) return;

    await withBusy("revoking current passkey", async () => {
      const result = await postJson("/api/admin/passkey/revoke-current");
      setText(message, result.next_safe_action ?? "current passkey revoked");
      await refreshStatus();
    });
  }

  async function withBusy(label: string, action: () => Promise<void>) {
    setBusy(true);
    passkeyCard?.classList.add("is-busy");
    setText(message, label);
    try {
      await action();
    } catch (error) {
      setText(message, errorMessage(error));
    } finally {
      setBusy(false);
      passkeyCard?.classList.remove("is-busy");
      renderStatus();
    }
  }

  async function postJson<TResponse = ApiResult>(
    path: string,
    body?: unknown,
  ): Promise<TResponse> {
    const response = await fetch(path, {
      method: "POST",
      headers: body ? { "content-type": "application/json" } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = (await response.json()) as TResponse;
    const apiData = data as ApiResult;
    if (!response.ok) {
      throw new ApiError(
        apiData.detail ?? apiData.error ?? `request failed: ${response.status}`,
        apiData.next_safe_action,
      );
    }
    return data;
  }

  function renderProofList() {
    if (!status || !proofList) return;
    proofList.replaceChildren(
      ...status.proof_items.map((item) => {
        const row = document.createElement("article");
        row.className = `proof-item ${item.complete ? "complete" : "blocked"}`;
        row.innerHTML = `
          <span class="proof-dot" aria-hidden="true"></span>
          <span>
            <strong></strong>
            <small></small>
          </span>
          <code></code>
        `;
        const title = row.querySelector("strong");
        const detail = row.querySelector("small");
        const count = row.querySelector("code");
        setText(title, item.label);
        setText(detail, item.complete ? "recorded" : item.next_safe_action);
        setText(count, String(item.count));
        return row;
      }),
    );
  }

  function renderRunbook() {
    if (!status || !runbookList) return;
    const steps = buildRunbookSteps(status);
    const firstOpenStep = steps.find((step) => !step.complete);
    setText(
      runbookSummary,
      firstOpenStep ? `next: ${firstOpenStep.label}` : "ready to remove Access",
    );
    runbookList.replaceChildren(
      ...steps.map((step, index) => {
        const row = document.createElement("li");
        row.className = `runbook-step ${step.complete ? "complete" : "open"}`;
        row.innerHTML = `
          <span class="step-index"></span>
          <span>
            <strong></strong>
            <small></small>
          </span>
        `;
        setText(row.querySelector(".step-index"), String(index + 1));
        setText(row.querySelector("strong"), step.label);
        setText(row.querySelector("small"), step.detail);
        return row;
      }),
    );
  }

  function buildRunbookSteps(
    currentStatus: PasskeyStatus,
  ): PasskeyRunbookStep[] {
    const events = currentStatus.audit_events;
    const registered = events["passkey.credential.registered"] > 0;
    const sessionCreated = events["passkey.session.created"] > 0;
    const sessionRevoked = events["passkey.session.revoked"] > 0;
    const credentialRevoked = events["passkey.credential.revoked"] > 0;
    const denied = events["passkey.authentication.denied"] > 0;
    const activeCredential = currentStatus.credential_count > 0;
    const activeSession = currentStatus.has_session;

    return [
      {
        label: "enter through Cloudflare Access",
        detail: currentStatus.access_identity_present
          ? `Access identity verified as ${currentStatus.access_identity_hint ?? "admin user"}.`
          : "sign in through Access once so first registration is allowed.",
        complete:
          currentStatus.access_identity_present ||
          activeCredential ||
          activeSession,
      },
      {
        label: "register platform passkey",
        detail: activeCredential
          ? "active credential exists in D1."
          : "use register passkey and finish the biometric prompt.",
        complete: activeCredential && registered,
      },
      {
        label: "create app-native session",
        detail: activeSession
          ? "active session exists in D1."
          : "use authenticate after registration.",
        complete: activeSession && sessionCreated,
      },
      {
        label: "prove persistence",
        detail: activeSession
          ? "reload a protected admin route and confirm it still renders."
          : "authenticate first so protected routes can prove session reuse.",
        complete: activeSession,
      },
      {
        label: "prove logout and recovery",
        detail:
          sessionRevoked && activeSession
            ? "logout proof exists and a replacement session is active."
            : "logout once, then authenticate again before continuing.",
        complete: sessionRevoked && activeSession,
      },
      {
        label: "prove revoked credential denial",
        detail:
          credentialRevoked && denied && activeCredential && activeSession
            ? "revoked credential denial exists and replacement access is live."
            : "revoke current passkey, attempt authenticate, then register and authenticate a replacement.",
        complete:
          credentialRevoked && denied && activeCredential && activeSession,
      },
      {
        label: "remove Cloudflare Access",
        detail: currentStatus.ready_for_access_removal
          ? "rerun proof, remove Access, then verify app-native blocking."
          : currentStatus.next_safe_action,
        complete: currentStatus.ready_for_access_removal,
      },
    ];
  }

  function setBusy(busy: boolean) {
    if (passkeyCard) {
      passkeyCard.disabled =
        busy ||
        !status?.available ||
        (!status?.has_session &&
          status?.credential_count === 0 &&
          !status?.can_register);
      passkeyCard.setAttribute("aria-busy", String(busy));
    }
    if (registerButton) registerButton.disabled = busy || !status?.can_register;
    if (loginButton) loginButton.disabled = busy || !status?.available;
    if (logoutButton) logoutButton.disabled = busy || !status?.has_session;
    if (revokeButton) revokeButton.disabled = busy || !status?.has_session;
  }

  function setText(node: Element | null, value: string) {
    if (node) node.textContent = value;
  }

  function errorMessage(error: unknown): string {
    if (error instanceof ApiError && error.nextSafeAction) {
      return error.nextSafeAction;
    }
    return error instanceof Error ? error.message : "passkey request failed";
  }

  class ApiError extends Error {
    nextSafeAction: string | undefined;

    constructor(message: string, nextSafeAction: string | undefined) {
      super(message);
      this.name = "ApiError";
      this.nextSafeAction = nextSafeAction;
    }
  }
</script>
