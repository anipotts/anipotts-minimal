---
import AuthFrame from "../../../components/auth/AuthFrame.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";

const requestId = Astro.params.requestId ?? "";
---

<AdminLayout title="approve sign in" chrome="auth" hideHeader>
  <AuthFrame
    title="approve sign in"
    subtitle="check the browser requesting admin access."
  >
    <div id="device-review" data-request-id={requestId}>
      <section class="auth-state" data-review-state="loading">
        <p class="auth-detail" aria-live="polite">checking request</p>
      </section>

      <section class="auth-state" data-review-state="ready" hidden>
        <p class="auth-detail">
          <strong id="requesting-device"></strong><br />
          <span id="requesting-time"></span>
        </p>
        <button class="auth-primary" id="approve-device" type="button">
          approve this browser
        </button>
        <p class="auth-message" id="approval-message" aria-live="polite"></p>
      </section>

      <section class="auth-state" data-review-state="approved" hidden>
        <a class="auth-primary" href="/">open admin</a>
        <p class="auth-message">you can return to the requesting browser.</p>
      </section>

      <section class="auth-state" data-review-state="expired" hidden>
        <a class="auth-primary" href="/auth">back to sign in</a>
      </section>
    </div>
  </AuthFrame>
</AdminLayout>

<style>
  [data-review-state="ready"] .auth-primary {
    margin-top: 30px;
  }

  #requesting-device {
    color: var(--auth-ink);
    font-size: 18px;
    font-weight: 620;
  }
</style>

<script>
  import {
    adminMutationFetch,
    adminStepUpPath,
  } from "../../../lib/admin-client-auth";

  type Review = {
    state: "pending" | "approved" | "denied" | "claimed";
    requesting_device: string;
    requested_at: string;
  };

  const root = document.querySelector<HTMLElement>("#device-review");
  const requestId = root?.dataset.requestId ?? "";
  const device = document.querySelector<HTMLElement>("#requesting-device");
  const requestedTime = document.querySelector<HTMLElement>("#requesting-time");
  const message = document.querySelector<HTMLElement>("#approval-message");
  const approve = document.querySelector<HTMLButtonElement>("#approve-device");

  approve?.addEventListener("click", () => void approveRequest());
  void loadRequest();

  async function loadRequest() {
    if (!requestId) {
      setState("expired");
      return;
    }
    try {
      const response = await fetch(
        `/api/admin/device/review?request_id=${encodeURIComponent(requestId)}`,
        {
          cache: "no-store",
          credentials: "same-origin",
          headers: { accept: "application/json" },
        },
      );
      const data = (await response.json().catch(() => null)) as Review | null;
      if (!response.ok || !data || data.state !== "pending") {
        if (data?.state === "approved") setState("approved");
        else setState("expired");
        return;
      }
      setText(device, data.requesting_device);
      setText(
        requestedTime,
        `requested ${new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date(data.requested_at))}`,
      );
      setState("ready");
    } catch {
      setState("expired");
    }
  }

  async function approveRequest() {
    if (!approve) return;
    approve.disabled = true;
    setText(message, "approving");
    try {
      const response = await adminMutationFetch("/api/admin/device/approve", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ request_id: requestId }),
      });
      const data = (await response.json().catch(() => null)) as {
        error?: string;
      } | null;
      if (!response.ok) {
        if (data?.error === "fresh_passkey_required") {
          window.location.assign(adminStepUpPath());
          return;
        }
        throw new Error(data?.error ?? "approval_failed");
      }
      setState("approved");
    } catch {
      setText(message, "couldn’t approve this request.");
      approve.disabled = false;
    }
  }

  function setState(state: "loading" | "ready" | "approved" | "expired") {
    for (const panel of document.querySelectorAll<HTMLElement>(
      "[data-review-state]",
    )) {
      panel.hidden = panel.dataset.reviewState !== state;
    }
    const stateCopy = {
      loading: ["approve sign in", "checking the request."],
      ready: ["approve sign in", "check the browser requesting admin access."],
      approved: ["approved", "this browser can now open admin."],
      expired: [
        "request expired",
        "start a new phone approval from the browser.",
      ],
    } as const;
    setText(document.querySelector("[data-auth-title]"), stateCopy[state][0]);
    setText(
      document.querySelector("[data-auth-subtitle]"),
      stateCopy[state][1],
    );
  }

  function setText(node: Element | null, value: string) {
    if (node) node.textContent = value;
  }
</script>
