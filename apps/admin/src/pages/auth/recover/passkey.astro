---
import AuthFrame from "../../../components/auth/AuthFrame.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="replace passkey" chrome="auth" hideHeader>
  <AuthFrame
    title="replace passkey"
    subtitle="create one new passkey. every old owner session and passkey will be revoked."
  >
    <button class="auth-primary" id="replace-passkey" type="button">
      create new passkey
    </button>
    <p class="auth-message" id="replace-message" aria-live="polite"></p>
  </AuthFrame>
</AdminLayout>

<script>
  import { startRegistration } from "@simplewebauthn/browser";
  import type { PublicKeyCredentialCreationOptionsJSON } from "@simplewebauthn/server";
  import { adminMutationFetch } from "../../../lib/admin-client-auth";

  type RegistrationEnvelope = {
    options: PublicKeyCredentialCreationOptionsJSON;
    challenge_id: string;
  };

  const button = document.querySelector<HTMLButtonElement>("#replace-passkey");
  const message = document.querySelector<HTMLElement>("#replace-message");

  button?.addEventListener("click", () => void replacePasskey());

  async function replacePasskey() {
    if (!button) return;
    button.disabled = true;
    setText(message, "opening passkey");
    try {
      const envelope = await postJson<RegistrationEnvelope>(
        "/api/admin/recovery/passkey/options",
      );
      const credential = await startRegistration({
        optionsJSON: envelope.options,
      });
      await postJson("/api/admin/recovery/passkey/verify", {
        challenge_id: envelope.challenge_id,
        credential,
      });
      window.location.assign("/");
    } catch (error) {
      if (error instanceof DOMException && error.name === "NotAllowedError") {
        setText(message, "passkey prompt closed. try again when ready.");
      } else {
        setText(message, "couldn’t replace the passkey. start recovery again.");
      }
      button.disabled = false;
    }
  }

  async function postJson<T>(path: string, body?: unknown): Promise<T> {
    const headers = new Headers({ accept: "application/json" });
    if (body !== undefined) headers.set("content-type", "application/json");
    const response = await adminMutationFetch(path, {
      method: "POST",
      headers,
      body: body === undefined ? undefined : JSON.stringify(body),
    });
    const data = (await response.json().catch(() => null)) as T | null;
    if (!response.ok || !data) throw new Error("recovery_request_failed");
    return data;
  }

  function setText(node: Element | null, value: string) {
    if (node) node.textContent = value;
  }
</script>
