---
import AuthFrame from "../../components/auth/AuthFrame.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";

const inviteCode = Astro.url.searchParams.get("token") ?? "";
---

<AdminLayout title="join admin" chrome="auth" hideHeader>
  <AuthFrame
    title="join admin"
    subtitle="create a passkey to finish your invitation."
  >
    <div id="invite-flow" data-token={inviteCode}>
      <section class="auth-state" data-invite-state="loading">
        <p class="auth-detail" aria-live="polite">checking invitation</p>
      </section>

      <section class="auth-state" data-invite-state="ready" hidden>
        <form class="auth-form" id="invite-form">
          <label class="auth-field">
            <span>your name</span>
            <input
              class="auth-input"
              id="invite-name"
              name="display_name"
              autocomplete="name"
              maxlength="80"
              required
            />
          </label>
          <button class="auth-primary" id="invite-submit" type="submit">
            create passkey
          </button>
        </form>
        <p class="auth-message" id="invite-message" aria-live="polite"></p>
      </section>

      <section class="auth-state" data-invite-state="pending" hidden>
        <a class="auth-primary" href="/auth">back to sign in</a>
      </section>

      <section class="auth-state" data-invite-state="expired" hidden>
        <a class="auth-primary" href="/auth">back to sign in</a>
        <p class="auth-message">ask the owner for a new invitation.</p>
      </section>

      <section class="auth-state" data-invite-state="error" hidden>
        <button class="auth-primary" id="invite-retry" type="button">
          try again
        </button>
        <div class="auth-link-row">
          <a class="auth-link" href="/auth">back to sign in</a>
        </div>
      </section>
    </div>
  </AuthFrame>
</AdminLayout>

<script>
  import { startRegistration } from "@simplewebauthn/browser";
  import type { PublicKeyCredentialCreationOptionsJSON } from "@simplewebauthn/server";

  type InviteStatus = {
    role: "operator" | "viewer";
    state:
      | "ready"
      | "pending_owner_approval"
      | "approved"
      | "expired"
      | "revoked";
  };

  type RegistrationEnvelope = {
    options: PublicKeyCredentialCreationOptionsJSON;
    challenge_id: string;
  };

  const flow = document.querySelector<HTMLElement>("#invite-flow");
  const token = flow?.dataset.token ?? "";
  const title = document.querySelector<HTMLElement>("[data-auth-title]");
  const subtitle = document.querySelector<HTMLElement>("[data-auth-subtitle]");
  const form = document.querySelector<HTMLFormElement>("#invite-form");
  const nameInput = document.querySelector<HTMLInputElement>("#invite-name");
  const submit = document.querySelector<HTMLButtonElement>("#invite-submit");
  const message = document.querySelector<HTMLElement>("#invite-message");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    void enroll();
  });
  document
    .querySelector<HTMLButtonElement>("#invite-retry")
    ?.addEventListener("click", () => void loadInvite());

  void loadInvite();

  async function loadInvite() {
    if (!token) {
      setState("expired");
      return;
    }
    setState("loading");
    try {
      const status = await getJson<InviteStatus>(
        `/api/admin/invites/status?token=${encodeURIComponent(token)}`,
      );
      if (status.state === "ready") {
        setText(subtitle, `create a passkey to join as ${status.role}.`);
        setState("ready");
        nameInput?.focus();
        return;
      }
      if (status.state === "pending_owner_approval") {
        setState("pending");
        return;
      }
      setState("expired");
    } catch {
      setState("expired");
    }
  }

  async function enroll() {
    if (!nameInput || !submit) return;
    submit.disabled = true;
    setText(message, "opening passkey");
    try {
      const envelope = await postJson<RegistrationEnvelope>(
        "/api/admin/invites/register-options",
        { token, display_name: nameInput.value },
      );
      const credential = await startRegistration({
        optionsJSON: envelope.options,
      });
      await postJson("/api/admin/invites/register-verify", {
        challenge_id: envelope.challenge_id,
        credential,
      });
      setState("pending");
    } catch (error) {
      if (error instanceof InviteApiError && error.status === 410) {
        setState("expired");
      } else if (
        error instanceof DOMException &&
        error.name === "NotAllowedError"
      ) {
        setText(message, "passkey prompt closed. try again when ready.");
      } else {
        setText(message, "couldn’t create the passkey. try again.");
      }
    } finally {
      submit.disabled = false;
    }
  }

  function setState(
    state: "loading" | "ready" | "pending" | "expired" | "error",
  ) {
    for (const panel of document.querySelectorAll<HTMLElement>(
      "[data-invite-state]",
    )) {
      panel.hidden = panel.dataset.inviteState !== state;
    }
    const stateCopy = {
      loading: ["join admin", "checking your invitation."],
      ready: ["join admin", "create a passkey to finish your invitation."],
      pending: [
        "waiting for approval",
        "your passkey is ready. ani still needs to approve access.",
      ],
      expired: [
        "invitation expired",
        "this invitation is no longer available.",
      ],
      error: ["couldn’t continue", "nothing changed. try again."],
    } as const;
    setText(title, stateCopy[state][0]);
    setText(subtitle, stateCopy[state][1]);
  }

  async function getJson<T>(path: string): Promise<T> {
    return responseJson<T>(
      await fetch(path, {
        cache: "no-store",
        credentials: "same-origin",
        headers: { accept: "application/json" },
      }),
    );
  }

  async function postJson<T>(path: string, body: unknown): Promise<T> {
    return responseJson<T>(
      await fetch(path, {
        method: "POST",
        credentials: "same-origin",
        headers: {
          accept: "application/json",
          "content-type": "application/json",
        },
        body: JSON.stringify(body),
      }),
    );
  }

  async function responseJson<T>(response: Response): Promise<T> {
    const data = (await response.json().catch(() => null)) as T | null;
    if (!response.ok || !data) throw new InviteApiError(response.status);
    return data;
  }

  function setText(node: Element | null, value: string) {
    if (node) node.textContent = value;
  }

  class InviteApiError extends Error {
    readonly status: number;

    constructor(status: number) {
      super("invite_request_failed");
      this.name = "InviteApiError";
      this.status = status;
    }
  }
</script>
