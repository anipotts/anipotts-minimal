---
import AuthFrame from "../../components/auth/AuthFrame.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="recover access" chrome="auth" hideHeader>
  <AuthFrame
    title="recover access"
    subtitle="verify with Google, then replace your owner passkeys."
  >
    <button class="auth-primary" id="start-recovery" type="button">
      continue with Google
    </button>
    <div class="auth-link-row">
      <a class="auth-link" href="/auth">back to sign in</a>
    </div>
    <p class="auth-message" id="recovery-message" aria-live="polite"></p>
  </AuthFrame>
</AdminLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>("#start-recovery");
  const message = document.querySelector<HTMLElement>("#recovery-message");

  button?.addEventListener("click", () => void startRecovery());

  async function startRecovery() {
    if (!button) return;
    button.disabled = true;
    setText(message, "opening Google");
    try {
      const response = await fetch("/api/admin/recovery/google/start", {
        method: "POST",
        credentials: "same-origin",
        headers: { accept: "application/json" },
      });
      const data = (await response.json().catch(() => null)) as {
        authorization_url?: unknown;
        error?: unknown;
      } | null;
      if (!response.ok || !data || typeof data.authorization_url !== "string") {
        throw new Error(
          data?.error === "google_recovery_not_configured"
            ? "recovery isn’t available in this preview."
            : "recovery couldn’t start. try again.",
        );
      }
      window.location.assign(data.authorization_url);
    } catch (error) {
      setText(
        message,
        error instanceof Error
          ? error.message
          : "recovery couldn’t start. try again.",
      );
      button.disabled = false;
    }
  }

  function setText(node: Element | null, value: string) {
    if (node) node.textContent = value;
  }
</script>
