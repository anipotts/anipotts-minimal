---
import {
  findAdminProjectState,
  loadAdminControlSnapshot,
} from "@anipotts/lib/admin-control";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { ProjectDetailView } from "../../components/astryx/UnifiedShellViews";
import { selectAdminControlSource } from "../../data/admin-control-source";
const source = selectAdminControlSource(
  Astro.locals.runtime?.env.DB,
  Astro.url,
);
const snapshot = await loadAdminControlSnapshot(source.database);
const project = findAdminProjectState(snapshot, Astro.params.projectId ?? "");
if (!project) Astro.response.status = 404;
---

<AdminLayout
  title={project?.display_name ?? "project unavailable"}
  deck="Read-only project state."
>
  {
    project ? (
      <ProjectDetailView
        snapshot={snapshot}
        project={project}
        fixtureMode={source.fixtureMode}
      />
    ) : (
      <section class="notice">Project unavailable.</section>
    )
  }
</AdminLayout>
