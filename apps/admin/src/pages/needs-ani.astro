---
import AdminLayout from "../layouts/AdminLayout.astro";
import { needsAniBuckets, needsAniItems } from "../data/needs";
---

<AdminLayout
  title="needs ani"
  deck="Typed human decision queue from the current static syscall feed. It shows exactly what Ani can answer next without exposing private payloads."
>
  <section class="meta-strip" aria-label="needs ani queue source">
    <span>{needsAniItems.length} open items</span>
    <span>coord/NEEDS-ANI.md</span>
    <span>read-only</span>
  </section>

  <div class="needs-grid">
    {
      needsAniBuckets.map((group) => {
        const rows = needsAniItems.filter(
          (item) => item.bucket === group.bucket,
        );

        return (
          <section class="table-card">
            <div class="section-head">
              <div>
                <p>{group.detail}</p>
                <h2>{group.title}</h2>
              </div>
              <span>{rows.length} items</span>
            </div>
            <div class="record-list">
              {rows.map((item) => (
                <article class="need-row">
                  <div>
                    <p>
                      {item.owner} / {item.type}
                    </p>
                    <h3>{item.id}</h3>
                    <span>{item.why}</span>
                  </div>
                  <dl>
                    <div>
                      <dt>Ani action</dt>
                      <dd>{item.ani_action}</dd>
                    </div>
                    <div>
                      <dt>agent next</dt>
                      <dd>{item.agent_next}</dd>
                    </div>
                    <div>
                      <dt>stale</dt>
                      <dd>{item.expires_stale}</dd>
                    </div>
                    <div>
                      <dt>source</dt>
                      <dd>{item.source}</dd>
                    </div>
                  </dl>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</AdminLayout>
