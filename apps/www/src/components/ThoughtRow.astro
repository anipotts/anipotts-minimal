---
import { formatDate, thoughtSlug, type Thought } from "../lib/content";

interface Props {
  thought: Thought;
}

const { thought } = Astro.props;
const slug = thoughtSlug(thought);
const { title, summary, published_at, tags } = thought.data;
---

<a href={`/thoughts/${slug}`} class="row-link">
  <span class="row-title">{title}</span>
  <span class="row-meta mono">
    {published_at && <span>{formatDate(published_at)}</span>}
    {tags.slice(0, 3).map((t) => <span>{t}</span>)}
  </span>
  <span class="row-dek">{summary}</span>
</a>

<style>
  .row-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .row-dek {
    color: var(--ink-muted);
    font-size: var(--p-small);
    max-width: var(--measure);
  }
</style>
