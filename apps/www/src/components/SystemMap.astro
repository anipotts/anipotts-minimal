---
import type { SystemsPageContent } from "@anipotts/content/public";

interface Props {
  workflow: SystemsPageContent["workflow"];
}
const { workflow } = Astro.props;
---

<figure class="workflow" aria-label="How I work with agents">
  <div class="diagram">
    <ol class="steps">
      {
        workflow.steps.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">
              {index + 1}
            </span>
            <h2>{step.label}</h2>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <span class="return-route" aria-hidden="true"></span>
    <p class="feedback">{workflow.feedback}</p>
  </div>
  <figcaption>{workflow.caption}</figcaption>
</figure>

<style>
  .workflow {
    margin: 0;
  }
  .diagram {
    position: relative;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    min-width: 0;
    padding: 1.1rem 0 1rem;
    border-top: 1px solid var(--border-strong);
  }
  .step-number {
    display: block;
    color: var(--ink-muted);
    font-size: 0.875rem;
    margin-bottom: 1.1rem;
  }
  .step h2 {
    min-height: 2.5em;
    font-family: var(--sans);
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    font-weight: 650;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }
  .step p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
  }
  .step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -1.65rem;
    top: 0.9rem;
    color: var(--ink);
  }
  .return-route {
    display: block;
    position: relative;
    height: 1.75rem;
    margin: 0.75rem 12.5% 0;
    border: 1px solid var(--border-strong);
    border-top: 0;
  }
  .return-route::before {
    content: "";
    position: absolute;
    top: 0;
    left: -4px;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
    transform: rotate(45deg);
  }
  .feedback {
    font-size: 0.85rem;
    color: var(--ink-muted);
    text-align: center;
    margin: 0.65rem 0 0;
  }
  figcaption {
    max-width: 65ch;
    margin: 2rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }
  @media (max-width: 699px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.8rem;
      padding-left: 2rem;
    }
    .step {
      display: grid;
      grid-template-columns: 1.2rem 1fr;
      column-gap: 0.6rem;
      padding: 0.9rem 0 0;
    }
    .step-number {
      margin: 0.1rem 0 0;
      grid-row: 1 / 3;
    }
    .step h2 {
      min-height: 0;
      font-size: 1.18rem;
      margin-bottom: 0.5rem;
      text-wrap: initial;
    }
    .step p {
      grid-column: 2;
      max-width: 42ch;
    }
    .step:not(:last-child)::after {
      content: "↓";
      right: auto;
      left: 1.8rem;
      top: auto;
      bottom: -1.55rem;
    }
    .return-route {
      position: absolute;
      top: 1.6rem;
      bottom: 2.9rem;
      left: 0;
      width: 1rem;
      height: auto;
      margin: 0;
      border: 1px solid var(--border-strong);
      border-right: 0;
    }
    .return-route::before {
      top: -4px;
      left: auto;
      right: 0;
      transform: rotate(135deg);
    }
    .feedback {
      margin-top: 1.7rem;
      padding-left: 2rem;
      text-align: left;
    }
    figcaption {
      margin-top: 1.5rem;
    }
  }
</style>
