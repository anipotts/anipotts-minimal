---
import type {
  SystemsAuthorityMode,
  SystemsMapDevice,
  SystemsMapDomain,
  SystemsMapFoundation,
  SystemsMapNode,
  SystemsMapRelationship,
  SystemsMapSource,
} from "@anipotts/content/public";
import { Icon } from "astro-icon/components";
import AgentMark from "./AgentMark.astro";
import SystemSemantics from "./systems/SystemSemantics.astro";

interface Props {
  label: string;
  principle: string;
  domains: SystemsMapDomain[];
  nodes: SystemsMapNode[];
  foundationLabel: string;
  foundations: SystemsMapFoundation[];
  deviceLabel: string;
  devices: SystemsMapDevice[];
  authorityLabel: string;
  authorityModes: SystemsAuthorityMode[];
  relationships: SystemsMapRelationship[];
}

const {
  label,
  principle,
  domains,
  nodes,
  foundationLabel,
  foundations,
  deviceLabel,
  devices,
  authorityLabel,
  authorityModes,
  relationships,
} = Astro.props;

const nodeById = Object.fromEntries(
  nodes.map((node) => [node.id, node]),
) as Record<SystemsMapNode["id"], SystemsMapNode>;
const foundationById = Object.fromEntries(
  foundations.map((foundation) => [foundation.id, foundation]),
) as Record<SystemsMapFoundation["id"], SystemsMapFoundation>;
const deviceById = Object.fromEntries(
  devices.map((device) => [device.id, device]),
) as Record<SystemsMapDevice["id"], SystemsMapDevice>;

const sourceIcons: Record<SystemsMapSource["id"], string> = {
  gmail: "logos:google-gmail",
  linkedin: "logos:linkedin-icon",
  x: "logos:x",
  instagram: "logos:instagram-icon",
  github: "logos:github-icon",
  nyu: "ph:graduation-cap-fill",
  chrome: "logos:chrome",
  apple_books: "ph:book-open-text-fill",
  withings: "ph:heartbeat-fill",
  zocdoc: "ph:first-aid-fill",
  imessage: "simple-icons:imessage",
  real_life: "ph:eye-fill",
  files: "ph:folder-simple-fill",
  apple_health: "ph:heart-straight-fill",
  physical_measurement: "ph:scales-fill",
  people: "ph:users-three-fill",
  notes: "ph:note-fill",
};

const sourceImages: Partial<Record<SystemsMapSource["id"], string>> = {
  nyu: "/brand/sources/nyu.png",
  withings: "/brand/sources/withings.jpg",
  zocdoc: "/brand/sources/zocdoc.jpg",
  files: "/brand/sources/files.png",
  notes: "/brand/sources/notes.png",
};

const calendarTitle = foundationById.calendar.title;
const macMiniTitle = deviceById.mac_mini.title;
const externalSsdTitle = foundationById.external_ssd.title;
---

<figure class="system-map" aria-labelledby="system-map-heading">
  <figcaption class="system-map__caption">
    <h2 id="system-map-heading" class="section-label">{label}</h2>
    <span class="sr-only">{principle}</span>
  </figcaption>

  <div class="topology" aria-hidden="true">
    <svg
      class="routes routes--desktop"
      viewBox="0 0 1200 960"
      role="presentation"
    >
      <g class="route route--signal">
        <path d="M150 205V245M450 205V245M750 205V245M1050 205V245"></path>
        <path d="M150 245H1050M600 245V318"></path>
      </g>
      <path class="route route--scheduled" d="M600 272V318"></path>
      <path class="route route--authorized" d="M600 405V494"></path>
      <path
        class="route route--needs-human"
        d="M785 525C1015 525 962 361 690 361"></path>
      <path class="route route--credential" d="M600 552V642"></path>
      <path class="route route--transport" d="M600 684V752"></path>
      <path class="route route--verified" d="M600 800V857H1138V245H1050"></path>
      <path class="route route--archive" d="M600 857V918"></path>
      <circle class="route-packet" r="4">
        <animateMotion
          dur="16s"
          repeatCount="indefinite"
          path="M600 405V494M600 552V642M600 684V752M600 800V857H1138V245H1050"
        ></animateMotion>
      </circle>
    </svg>

    <svg
      class="routes routes--mobile"
      viewBox="0 0 1200 1100"
      role="presentation"
    >
      <g class="route route--signal">
        <path d="M150 314V354M450 314V354M750 314V354M1050 314V354"></path>
        <path d="M150 354H1050M600 354V429"></path>
      </g>
      <path class="route route--scheduled" d="M600 381V429"></path>
      <path class="route route--authorized" d="M600 518V604"></path>
      <path
        class="route route--needs-human"
        d="M790 635C1014 635 978 475 692 475"></path>
      <path class="route route--credential" d="M600 664V743"></path>
      <path class="route route--transport" d="M600 782V860"></path>
      <path class="route route--verified" d="M600 910V974H1145V354H1050"></path>
      <path class="route route--archive" d="M600 974V1042"></path>
      <circle class="route-packet" r="4">
        <animateMotion
          dur="18s"
          repeatCount="indefinite"
          path="M600 518V604M600 664V743M600 782V860M600 910V974H1145V354H1050"
        ></animateMotion>
      </circle>
    </svg>

    <div class="domain-grid">
      {
        domains.map((domain) => {
          const signals = domain.sources.filter(
            ({ kind }) => kind === "signal",
          );
          const records = domain.sources.filter(
            ({ kind }) => kind === "record",
          );
          return (
            <section class="domain" title={domain.detail}>
              <h3>{domain.label}</h3>
              <div class="source-list source-list--signals">
                {signals.map((source) => (
                  <span
                    class:list={["source-mark", `source-mark--${source.id}`]}
                    title={source.label}
                  >
                    {sourceImages[source.id] ? (
                      <img
                        src={sourceImages[source.id]}
                        alt=""
                        width="512"
                        height="512"
                        loading="eager"
                      />
                    ) : (
                      <Icon
                        name={sourceIcons[source.id]}
                        size={28}
                        aria-hidden="true"
                      />
                    )}
                  </span>
                ))}
              </div>
              <div class="source-list source-list--records">
                {records.map((source) => (
                  <span
                    class:list={[
                      "source-mark",
                      "source-mark--record",
                      `source-mark--${source.id}`,
                    ]}
                    title={source.label}
                  >
                    {sourceImages[source.id] ? (
                      <img
                        src={sourceImages[source.id]}
                        alt=""
                        width="512"
                        height="512"
                        loading="eager"
                      />
                    ) : (
                      <Icon
                        name={sourceIcons[source.id]}
                        size={30}
                        aria-hidden="true"
                      />
                    )}
                  </span>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>

    <span class="flow-label flow-label--signals">signals</span>

    <div class="calendar" title={foundationById.calendar.detail}>
      <span class="calendar__line"></span>
      <span class="system-icon system-icon--calendar">
        <Icon name="logos:google-calendar" size={31} aria-hidden="true" />
      </span>
      <span class="node-copy">
        <strong>{calendarTitle}</strong>
        <small>scheduled</small>
      </span>
    </div>

    <section class="ani" title={nodeById.ani.detail}>
      <img src="/brand/ap-mark-blue.svg?v=20260717" alt="" />
      <strong>ani</strong>
      <small>human authority</small>
    </section>

    <span class="flow-label flow-label--authorized">authorized work</span>
    <span class="flow-label flow-label--needs">needs me</span>

    <div class="agents" title={nodeById.agents.detail}>
      <div class="agent agent--claude">
        <span><AgentMark provider="claude" size={33} /></span>
        <strong>claude</strong>
      </div>
      <div class="agent agent--codex">
        <span><AgentMark provider="openai" size={33} /></span>
        <strong>codex</strong>
      </div>
    </div>

    <div class="credential" title={foundationById.one_password.detail}>
      <span class="system-icon system-icon--one-password">
        <Icon name="simple-icons:1password" size={28} aria-hidden="true" />
      </span>
      <span class="node-copy">
        <strong>1Password</strong>
        <small>credentials</small>
      </span>
    </div>

    <section class="infrastructure" title={foundationById.tailnet.detail}>
      <div class="tailnet-label">
        <Icon name="simple-icons:tailscale" size={21} aria-hidden="true" />
        <strong>{deviceLabel}</strong>
      </div>
      <div class="device device--iphone" title={deviceById.iphone.detail}>
        <span class="device__icon"
          ><Icon name="ph:device-mobile" size={28} aria-hidden="true" /></span
        >
        <small>iphone</small>
      </div>
      <div class="device device--mac-mini" title={deviceById.mac_mini.detail}>
        <span class="device__icon device__icon--mac-mini">
          <img
            src="/brand/sources/mac-mini.png"
            alt=""
            width="660"
            height="660"
            loading="eager"
          />
        </span>
        <span class="node-copy">
          <strong>{macMiniTitle}</strong>
          <small>always on</small>
        </span>
      </div>
      <div class="device device--macbook" title={deviceById.macbook.detail}>
        <span class="device__icon"
          ><Icon name="ph:laptop" size={32} aria-hidden="true" /></span
        >
        <small>macbook</small>
      </div>
    </section>

    <div class="persist" title={nodeById.record.detail}>
      <Icon name="ph:seal-check-fill" size={27} aria-hidden="true" />
      <strong>verify + persist</strong>
    </div>
    <span class="flow-label flow-label--verified">verified update</span>

    <div class="archive" title={foundationById.external_ssd.detail}>
      <Icon name="ph:hard-drive" size={28} aria-hidden="true" />
      <span class="node-copy">
        <strong>{externalSsdTitle}</strong>
        <small>planned archive</small>
      </span>
    </div>
  </div>

  <SystemSemantics
    id="systems-map-description"
    {principle}
    {domains}
    {nodes}
    {foundationLabel}
    {foundations}
    {deviceLabel}
    {devices}
    {authorityLabel}
    {authorityModes}
    {relationships}
  />
</figure>

<style>
  .system-map {
    display: grid;
    gap: var(--s-2);
    margin: 0;
  }

  .system-map__caption {
    display: block;
  }

  .topology {
    --line: color-mix(in srgb, var(--paper-muted) 60%, transparent);
    --line-soft: color-mix(in srgb, var(--paper-muted) 34%, transparent);
    --blue: #1769e0;
    --orange: #d96542;
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    min-height: 60rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--paper-muted) 24%, transparent);
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--paper-muted) 6%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        color-mix(in srgb, var(--paper-muted) 6%, transparent) 1px,
        transparent 1px
      ),
      color-mix(in srgb, var(--paper-surface) 98%, var(--paper-ink) 2%);
    background-size: 2rem 2rem;
    box-shadow: var(--paper-shadow);
    color: var(--paper-ink);
    container-type: inline-size;
  }

  .routes {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .routes--mobile {
    display: none;
  }

  .route {
    fill: none;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .route--signal,
  .route--transport {
    stroke: var(--line);
    stroke-width: 1.4;
  }

  .route--scheduled {
    stroke: #2f8f6c;
    stroke-width: 2;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }

  .route--authorized,
  .route--credential,
  .route--verified {
    stroke: var(--blue);
    stroke-width: 2.5;
  }

  .route--needs-human {
    stroke: var(--orange);
    stroke-width: 2;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }

  .route--archive {
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
  }

  .route-packet {
    fill: var(--blue);
    opacity: 0.78;
  }

  .domain-grid {
    position: absolute;
    z-index: 2;
    top: 1.5rem;
    right: clamp(1rem, 3vw, 2.2rem);
    left: clamp(1rem, 3vw, 2.2rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 3vw, 2.6rem);
    height: 11.6rem;
  }

  .domain {
    display: grid;
    grid-template-rows: auto 3.15rem 4.35rem;
    min-width: 0;
    align-content: start;
    text-align: center;
  }

  .domain h3 {
    margin: 0;
    font-size: clamp(0.78rem, 1.45vw, 1.02rem);
    font-weight: 720;
    line-height: 1;
  }

  .source-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.28rem, 0.75vw, 0.55rem);
    min-width: 0;
  }

  .source-list--signals {
    align-self: center;
  }

  .source-list--records {
    align-self: end;
    padding-top: 0.78rem;
    border-top: 1px solid var(--line-soft);
  }

  .source-mark,
  .system-icon,
  .device__icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    box-sizing: border-box;
    overflow: hidden;
    background: #fff;
    color: #121721;
  }

  .source-mark {
    width: clamp(1.85rem, 3.2vw, 2.3rem);
    aspect-ratio: 1;
    border: 1px solid #d9dee6;
    border-radius: 0.52rem;
    box-shadow: 0 1px 3px rgb(9 20 36 / 10%);
  }

  .source-mark--record {
    width: clamp(2.15rem, 3.7vw, 2.65rem);
    border-color: color-mix(in srgb, var(--blue) 32%, #d9dee6);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--blue) 7%, transparent);
  }

  .source-mark :global(svg) {
    width: 70%;
    height: 70%;
  }

  .source-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .source-mark--nyu img,
  .source-mark--files img,
  .source-mark--notes img {
    object-fit: contain;
  }

  .source-mark--apple_books {
    border-color: #e86f16;
    background: #f47a20;
    color: #fff;
  }

  .source-mark--imessage {
    color: #22a947;
  }

  .source-mark--apple_health {
    color: #ff375f;
  }

  .source-mark--physical_measurement {
    color: #4f6578;
  }

  .source-mark--real_life,
  .source-mark--people {
    color: #263240;
  }

  .calendar,
  .credential,
  .archive,
  .persist,
  .ani,
  .agents,
  .infrastructure,
  .flow-label {
    position: absolute;
    z-index: 3;
    transform: translate(-50%, -50%);
  }

  .calendar,
  .credential,
  .archive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: color-mix(in srgb, var(--paper-surface) 94%, transparent);
  }

  .calendar {
    top: 28.7%;
    left: 50%;
    padding: 0.25rem 0.55rem;
  }

  .calendar__line {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: min(44vw, 27rem);
    height: 1px;
    background: var(--line-soft);
    transform: translate(-50%, -50%);
  }

  .system-icon {
    width: 2.45rem;
    aspect-ratio: 1;
    border: 1px solid #d9dee6;
    border-radius: 0.52rem;
  }

  .node-copy {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .node-copy strong,
  .node-copy small {
    white-space: nowrap;
  }

  .node-copy strong {
    font-size: 0.76rem;
    font-weight: 680;
    line-height: 1;
  }

  .node-copy small {
    color: var(--paper-muted);
    font-size: 0.6rem;
    line-height: 1;
  }

  .ani {
    top: 38%;
    left: 50%;
    display: grid;
    place-content: center;
    width: clamp(5.8rem, 10vw, 7rem);
    aspect-ratio: 1;
    border: 1.5px solid var(--blue);
    border-radius: 50%;
    background: var(--paper-surface);
    box-shadow: 0 0.55rem 1.4rem
      color-mix(in srgb, var(--blue) 13%, transparent);
    text-align: center;
  }

  .ani img {
    width: 72%;
    height: 2.9rem;
    margin: -0.28rem auto -0.14rem;
    object-fit: contain;
    transform: scale(1.35);
  }

  .ani strong {
    font-size: 0.78rem;
    line-height: 1;
  }

  .ani small {
    margin-top: 0.28rem;
    color: var(--paper-muted);
    font-size: 0.56rem;
    font-weight: 620;
    line-height: 1;
  }

  .agents {
    top: 54.7%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(5.8rem, 19vw, 12rem);
    width: min(70%, 38rem);
  }

  .agents::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 1.45rem;
    left: 15%;
    width: 70%;
    height: 1px;
    background: var(--line);
  }

  .agent {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }

  .agent > span {
    display: grid;
    place-items: center;
    width: 3rem;
    aspect-ratio: 1;
    border-radius: 50%;
    color: #fff;
    box-shadow: 0 0 0 0.32rem var(--paper-surface);
  }

  .agent--claude > span {
    background: var(--orange);
  }

  .agent--codex > span {
    background: var(--blue);
  }

  .agent strong {
    padding: 0.12rem 0.3rem;
    background: var(--paper-surface);
    font-size: 0.72rem;
    line-height: 1;
  }

  .credential {
    top: 65.2%;
    left: 50%;
    padding: 0.25rem 0.55rem;
  }

  .system-icon--one-password {
    border-color: #c7ddf7;
    color: #0572ec;
  }

  .infrastructure {
    top: 77.5%;
    left: 50%;
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    align-items: center;
    width: min(68%, 37rem);
    min-width: 24rem;
  }

  .infrastructure::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 50%;
    right: 10%;
    left: 10%;
    height: 1px;
    background: var(--line);
  }

  .tailnet-label {
    position: absolute;
    bottom: calc(100% + 0.55rem);
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.2rem 0.35rem;
    background: var(--paper-surface);
    color: var(--paper-muted);
    transform: translateX(-50%);
  }

  .tailnet-label strong {
    font-size: 0.65rem;
    font-weight: 720;
    line-height: 1;
    text-transform: lowercase;
  }

  .device {
    display: grid;
    justify-items: center;
    gap: 0.24rem;
    min-width: 0;
  }

  .device__icon {
    width: 2.7rem;
    aspect-ratio: 1;
    border: 1px solid #d9dee6;
    border-radius: 0.52rem;
  }

  .device__icon--mac-mini {
    width: 3.7rem;
  }

  .device__icon--mac-mini img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .device small {
    padding: 0.1rem 0.25rem;
    background: var(--paper-surface);
    color: var(--paper-muted);
    font-size: 0.58rem;
    font-weight: 620;
    line-height: 1;
  }

  .device--mac-mini {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }

  .persist {
    top: 87.6%;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.24rem 0.48rem;
    background: var(--paper-surface);
    color: var(--blue);
  }

  .persist strong {
    color: var(--paper-ink);
    font-size: 0.72rem;
    font-weight: 680;
    line-height: 1;
  }

  .archive {
    top: 95.1%;
    left: 50%;
    padding: 0.22rem 0.48rem;
  }

  .flow-label {
    padding: 0.13rem 0.3rem;
    background: var(--paper-surface);
    color: var(--paper-muted);
    font-size: clamp(0.55rem, 0.85vw, 0.67rem);
    font-weight: 680;
    line-height: 1;
    white-space: nowrap;
  }

  .flow-label--signals {
    top: 25.5%;
    left: 20%;
  }

  .flow-label--authorized {
    top: 47%;
    left: 52.5%;
    color: var(--blue);
  }

  .flow-label--needs {
    top: 48.8%;
    left: 76%;
    color: var(--orange);
  }

  .flow-label--verified {
    top: 87.6%;
    left: 82%;
    color: var(--blue);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 620px) {
    .topology {
      min-height: 68.75rem;
      background-size: 1.45rem 1.45rem;
    }

    .routes--desktop {
      display: none;
    }

    .routes--mobile {
      display: block;
    }

    .domain-grid {
      top: 1.1rem;
      right: 0.6rem;
      left: 0.6rem;
      gap: 0.22rem;
      height: 18rem;
    }

    .domain {
      grid-template-rows: auto 7rem 6rem;
    }

    .domain h3 {
      overflow: hidden;
      font-size: clamp(0.55rem, 2.75vw, 0.72rem);
      text-overflow: clip;
    }

    .source-list {
      flex-direction: column;
      gap: 0.28rem;
    }

    .source-list--records {
      align-self: stretch;
      justify-content: flex-start;
      padding-top: 0.58rem;
    }

    .source-mark {
      width: 1.75rem;
      border-radius: 0.42rem;
    }

    .source-mark--record {
      width: 2rem;
    }

    .calendar {
      top: 35.8%;
    }

    .calendar__line {
      width: 64vw;
    }

    .ani {
      top: 43.2%;
      width: 5.7rem;
    }

    .agents {
      top: 57.8%;
      gap: min(25vw, 6rem);
