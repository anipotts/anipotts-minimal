---
import type { SystemsPageContent } from "@anipotts/content/public";
import { Icon } from "astro-icon/components";

interface Props {
  workflow: SystemsPageContent["workflow"];
}
const { workflow } = Astro.props;

const stepMarks: Record<
  string,
  Array<{ icon?: string; image?: string; label: string; monochrome?: boolean }>
> = {
  outcome: [
    { image: "/brand/sources/notes.png", label: "Apple Notes" },
    { icon: "simple-icons:linear", label: "Linear", monochrome: true },
  ],
  context: [
    { image: "/brand/sources/files.png", label: "Finder" },
    { icon: "logos:google-gmail", label: "Gmail" },
    { icon: "logos:google-calendar", label: "Google Calendar" },
  ],
  check: [
    { icon: "simple-icons:github", label: "GitHub", monochrome: true },
    { icon: "simple-icons:linear", label: "Linear", monochrome: true },
  ],
  work: [
    { icon: "simple-icons:openai", label: "Codex", monochrome: true },
    { icon: "logos:claude-icon", label: "Claude Code" },
  ],
};
---

<figure class="workflow" aria-label="How I work with agents">
  <div class="diagram">
    <ol class="steps">
      {
        workflow.steps.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">
              {index + 1}
            </span>
            <h2>
              <span>{step.label}</span>
              <span class="step-mark">
                {stepMarks[step.id]?.map((mark) => (
                  <span
                    class:list={[
                      "app-mark",
                      { "app-mark--monochrome": mark.monochrome },
                    ]}
                    title={mark.label}
                  >
                    {mark.image ? (
                      <img
                        src={mark.image}
                        alt={mark.label}
                        width="30"
                        height="30"
                        loading="lazy"
                      />
                    ) : (
                      <Icon name={mark.icon!} size={30} title={mark.label} />
                    )}
                  </span>
                ))}
              </span>
            </h2>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <span class="return-route" aria-hidden="true"></span>
    <p class="feedback">{workflow.feedback}</p>
  </div>
</figure>

<style>
  .workflow {
    margin: 0;
  }
  .diagram {
    position: relative;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    min-width: 0;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border-strong);
  }
  .step-number {
    display: block;
    color: var(--ink-muted);
    font-size: 0.875rem;
    margin-bottom: 1.1rem;
  }
  .step h2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    min-height: 2.5em;
    font-family: var(--sans);
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    font-weight: 650;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }
  .step-mark {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 1.2em;
    color: currentColor;
    gap: 0.5rem;
  }
  .app-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #fff;
    color: #171717;
    box-shadow: 0 1px 3px rgb(0 0 0 / 10%);
  }
  :global([data-theme="dark"]) .app-mark {
    background: #242424;
  }
  :global([data-theme="dark"]) .app-mark--monochrome {
    color: #fff;
  }
  .step-mark img {
    display: block;
    width: 30px;
    height: 30px;
    object-fit: contain;
  }
  .step p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
  }
  .step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -1.65rem;
    top: 0.9rem;
    color: var(--ink);
  }
  .return-route {
    display: block;
    position: relative;
    height: 1.75rem;
    margin: 0.75rem 12.5% 0;
    border: 1px solid var(--border-strong);
    border-top: 0;
  }
  .return-route::before {
    content: "";
    position: absolute;
    top: 0;
    left: -4px;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
    transform: rotate(45deg);
  }
  .feedback {
    font-size: 0.85rem;
    color: var(--ink-muted);
    text-align: center;
    margin: 0.65rem 0 0;
  }
  @media (max-width: 699px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-left: 2rem;
    }
    .step {
      display: grid;
      grid-template-columns: 1.2rem 1fr;
      column-gap: 0.6rem;
      row-gap: 0.5rem;
      padding: 1.35rem 0;
    }
    .step-number {
      margin: 0.1rem 0 0;
      grid-row: 1 / 3;
    }
    .step h2 {
      min-height: 0;
      font-size: 1.18rem;
      margin: 0;
      text-wrap: initial;
    }
    .step p {
      grid-column: 2;
      max-width: 42ch;
    }
    .step:not(:last-child)::after {
      content: none;
    }
    .step + .step {
      border-top-color: transparent;
    }
    .step + .step::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        to right,
        var(--border-strong) 0 1.45rem,
        transparent 1.45rem 2.95rem,
        var(--border-strong) 2.95rem
      );
    }
    .step + .step::after {
      content: "↓";
      right: auto;
      left: 1.45rem;
      top: -1px;
      bottom: auto;
      width: 1.5rem;
      line-height: 1.5rem;
      text-align: center;
      position: absolute;
      color: var(--ink);
      transform: translateY(-50%);
    }
    .return-route {
      position: absolute;
      top: 1.6rem;
      bottom: 2.9rem;
      left: 0;
      width: 1rem;
      height: auto;
      margin: 0;
      border: 1px solid var(--border-strong);
      border-right: 0;
    }
    .return-route::before {
      top: -4px;
      left: auto;
      right: 0;
      transform: rotate(135deg);
    }
    .feedback {
      margin-top: 1.7rem;
      padding-left: 2rem;
      text-align: left;
    }
  }
</style>
