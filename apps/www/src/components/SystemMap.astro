---
import type {
  SystemsAuthorityMode,
  SystemsMapDomain,
  SystemsMapFoundation,
  SystemsMapNode,
  SystemsMapRelationship,
} from "@anipotts/content/public";
import { Icon } from "astro-icon/components";
import AgentMark from "./AgentMark.astro";

interface Props {
  label: string;
  principle: string;
  domains: SystemsMapDomain[];
  nodes: SystemsMapNode[];
  foundationLabel: string;
  foundations: SystemsMapFoundation[];
  authorityLabel: string;
  authorityModes: SystemsAuthorityMode[];
  relationships: SystemsMapRelationship[];
}

const {
  label,
  principle,
  domains,
  nodes,
  foundationLabel,
  foundations,
  authorityLabel,
  authorityModes,
  relationships,
} = Astro.props;

const domainIcons: Record<string, string> = {
  career: "ph:briefcase",
  learning: "ph:book-open-text",
  wellbeing: "ph:heart",
  personal: "ph:user-circle",
};
const foundationIcons: Record<string, string> = {
  calendar: "ph:calendar-dots",
  github: "ph:github-logo",
  mac_mini: "ph:desktop-tower",
  external_ssd: "ph:hard-drives",
};
const mapNodes = Object.fromEntries(
  nodes.map((node) => [node.id, node]),
) as Record<SystemsMapNode["id"], SystemsMapNode>;
const modes = Object.fromEntries(
  authorityModes.map((mode) => [mode.id, mode]),
) as Record<SystemsAuthorityMode["id"], SystemsAuthorityMode>;
const paths = Object.fromEntries(
  relationships.map((relationship) => [relationship.id, relationship]),
) as Record<SystemsMapRelationship["id"], SystemsMapRelationship>;
---

<figure class="system-map" aria-labelledby="system-map-heading">
  <figcaption class="system-map__caption">
    <h2 id="system-map-heading" class="section-label">{label}</h2>
    <strong>{principle}</strong>
  </figcaption>

  <div class="system-map__canvas" aria-hidden="true">
    <svg viewBox="0 0 1100 750" role="presentation">
      <defs>
        <marker
          id="map-arrow"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="5"
          markerHeight="5"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z"></path>
        </marker>
        <marker
          id="map-loop-arrow"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z"></path>
        </marker>
      </defs>

      <path
        class="map-loop map-loop--attention"
        d="M 575 65 A 505 275 0 1 0 575 615 A 505 275 0 1 0 575 65"></path>
      <path
        class="map-loop map-loop--execution"
        d="M 285 340 A 290 220 0 1 0 865 340 A 290 220 0 1 0 285 340"></path>
      <g class="map-loop-headings">
        <text x="84" y="68">{mapNodes.life.label}</text>
        <text x="685" y="70">{mapNodes.ani.label}</text>
      </g>

      <g class="map-edges">
        <path
          class:list={["map-edge", `map-edge--${paths.life_to_snap.authority}`]}
          d="M 275 242 C 300 215 315 195 330 180"></path>
        <path
          class:list={[
            "map-edge",
            `map-edge--${paths.snap_to_admin.authority}`,
          ]}
          d="M 430 240 C 420 305 415 365 415 440"></path>
        <path
          class:list={["map-edge", `map-edge--${paths.admin_to_ani.authority}`]}
          d="M 520 486 C 545 445 558 405 568 390"></path>
        <path
          class:list={[
            "map-edge",
            `map-edge--${paths.ani_to_agents.authority}`,
          ]}
          d="M 610 300 C 630 250 650 215 680 190"></path>
        <path
          class:list={[
            "map-edge",
            `map-edge--${paths.agents_to_work.authority}`,
          ]}
          d="M 790 250 C 795 275 795 295 790 320"></path>
        <path
          class:list={[
            "map-edge",
            `map-edge--${paths.work_to_record.authority}`,
          ]}
          d="M 760 425 C 740 455 720 470 700 490"></path>
        <path
          class:list={[
            "map-edge",
            `map-edge--${paths.record_to_admin.authority}`,
          ]}
          d="M 610 540 C 565 550 520 535 500 505"></path>
        <path
          class:list={[
            "map-edge",
            `map-edge--${paths.record_to_ani.authority}`,
          ]}
          d="M 650 495 C 625 455 605 415 590 390"></path>
      </g>
      <g class="map-edge-labels">
        <text x="278" y="205">{modes[paths.life_to_snap.authority].label}</text>
        <text x="425" y="342">{modes[paths.snap_to_admin.authority].label}</text
        >
        <text x="518" y="449">{modes[paths.admin_to_ani.authority].label}</text>
        <text x="616" y="274">{modes[paths.ani_to_agents.authority].label}</text
        >
        <text x="800" y="287"
          >{modes[paths.agents_to_work.authority].label}</text
        >
        <text x="744" y="459"
          >{modes[paths.work_to_record.authority].label}</text
        >
        <text x="524" y="558"
          >{modes[paths.record_to_admin.authority].label}</text
        >
        <text x="606" y="446">{modes[paths.record_to_ani.authority].label}</text
        >
      </g>
      <g class="map-currents">
        <path
          class="map-current map-current--attention"
          d="M 575 65 A 505 275 0 1 0 575 615 A 505 275 0 1 0 575 65"></path>
        <path
          class="map-current map-current--execution"
          d="M 285 340 A 290 220 0 1 0 865 340 A 290 220 0 1 0 285 340"></path>
      </g>

      <rect class="map-group" x="55" y="155" width="220" height="360" rx="24"
      ></rect>
      <foreignObject x="75" y="174" width="180" height="325">
        <div class="map-life">
          <span class="map-kicker">{mapNodes.life.title}</span>
          {
            domains.map((domain) => (
              <div class="map-domain">
                <span class="map-identity">
                  <Icon
                    name={domainIcons[domain.label] ?? "ph:circle"}
                    class="map-icon"
                    size={17}
                    aria-hidden="true"
                  />
                  <strong>{domain.label}</strong>
                </span>
                {domain.children.length > 0 && (
                  <span>{domain.children.join(" / ")}</span>
                )}
              </div>
            ))
          }
        </div>
      </foreignObject>

      <rect class="map-node" x="320" y="100" width="255" height="140" rx="22"
      ></rect>
      <foreignObject x="340" y="118" width="215" height="106">
        <div class="map-copy">
          <span class="map-kicker">{mapNodes.snap_store.label}</span>
          <strong>{mapNodes.snap_store.title}</strong>
          <div class="map-node-items">
            {mapNodes.snap_store.items.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </foreignObject>

      <rect class="map-node" x="305" y="440" width="215" height="125" rx="22"
      ></rect>
      <foreignObject x="325" y="454" width="175" height="100">
        <div class="map-copy">
          <span class="map-kicker">{mapNodes.admin.label}</span>
          <strong>{mapNodes.admin.title}</strong>
          <span class="map-detail">{mapNodes.admin.detail}</span>
          <div class="map-node-items">
            {mapNodes.admin.items.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </foreignObject>

      <rect class="map-center" x="535" y="280" width="80" height="120" rx="40"
      ></rect>
      <foreignObject x="542" y="304" width="66" height="72">
        <div class="map-center-copy">
          <Icon
            name="ph:user-focus"
            class="map-center-icon"
            size={19}
            aria-hidden="true"
          />
          <strong>{mapNodes.ani.title}</strong>
          <span>{mapNodes.ani.label}</span>
        </div>
      </foreignObject>

      <rect class="map-node" x="660" y="100" width="265" height="150" rx="22"
      ></rect>
      <foreignObject x="682" y="120" width="221" height="112">
        <div class="map-copy">
          <span class="map-kicker">{mapNodes.agents.label}</span>
          <div class="map-agent-list">
            <span class="map-agent"
              ><AgentMark
                provider="openai"
                class="map-agent-icon map-agent-icon--openai"
                size={18}
              /><strong>{mapNodes.agents.items[0]}</strong></span
            >
            <span class="map-agent"
              ><AgentMark
                provider="claude"
                class="map-agent-icon map-agent-icon--claude"
                size={18}
              /><strong>{mapNodes.agents.items[1]}</strong></span
            >
          </div>
          <span class="map-detail">{mapNodes.agents.detail}</span>
        </div>
      </foreignObject>

      <rect class="map-node" x="680" y="320" width="220" height="105" rx="22"
      ></rect>
      <foreignObject x="700" y="339" width="180" height="70">
        <div class="map-copy">
          <span class="map-kicker">{mapNodes.work.label}</span><strong
            >{mapNodes.work.title}</strong
          ><span class="map-detail">{mapNodes.work.detail}</span>
        </div>
      </foreignObject>

      <rect class="map-node" x="610" y="490" width="230" height="105" rx="22"
      ></rect>
      <foreignObject x="630" y="508" width="190" height="70">
        <div class="map-copy">
          <span class="map-kicker">{mapNodes.record.label}</span><strong
            >{mapNodes.record.title}</strong
          ><span class="map-detail">{mapNodes.record.detail}</span>
        </div>
      </foreignObject>

      <text class="map-foundation-heading" x="75" y="647"
        >{foundationLabel}</text
      >
      <rect class="map-support" x="55" y="655" width="990" height="70" rx="20"
      ></rect>
      <foreignObject x="75" y="668" width="950" height="44">
        <div class="map-support-copy">
          {
            foundations.map((foundation) => (
              <span>
                <Icon
                  name={foundationIcons[foundation.id] ?? "ph:circle"}
                  class="map-icon"
                  size={17}
                  aria-hidden="true"
                />
                <span>
                  <>
                    <strong>{foundation.title}</strong>
                    <small>{foundation.detail}</small>
                  </>
                </span>
              </span>
            ))
          }
        </div>
      </foreignObject>
    </svg>
  </div>

  <div class="system-map__semantic">
    <section class="map-semantic-card" aria-labelledby="map-semantic-life">
      <span class="map-semantic-label">{mapNodes.life.label}</span>
      <h3 id="map-semantic-life">{mapNodes.life.title}</h3>
      <p>{mapNodes.life.detail}</p>
      <div class="map-semantic-domains">
        {
          domains.map((domain) => (
            <span>
              <Icon
                name={domainIcons[domain.label] ?? "ph:circle"}
                size={18}
                aria-hidden="true"
              />
              <strong>{domain.label}</strong>
              <small>{domain.children.join(" / ")}</small>
            </span>
          ))
        }
      </div>
    </section>

    <section class="map-semantic-card" aria-labelledby="map-semantic-context">
      <span class="map-semantic-label">{mapNodes.snap_store.label}</span>
      <h3 id="map-semantic-context">{mapNodes.snap_store.title}</h3>
      <p>{mapNodes.snap_store.detail}</p>
      <div class="map-semantic-pills">
        {mapNodes.snap_store.items.map((item) => <span>{item}</span>)}
      </div>
      <div class="map-semantic-subnode">
        <span class="map-semantic-label">{mapNodes.admin.label}</span>
        <strong>{mapNodes.admin.title}</strong>
        <p>{mapNodes.admin.detail}</p>
        <div class="map-semantic-pills">
          {mapNodes.admin.items.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </section>

    <section
      class="map-semantic-card map-semantic-card--execution"
      aria-labelledby="map-semantic-execution"
    >
      <span class="map-semantic-label">{mapNodes.ani.label}</span>
      <h3 id="map-semantic-execution">{mapNodes.ani.title}</h3>
      <p>{mapNodes.ani.detail}</p>
      <div class="map-semantic-agent-list" aria-label={mapNodes.agents.title}>
        <span
          ><AgentMark provider="openai" size={18} /><strong
            >{mapNodes.agents.items[0]}</strong
          ></span
        >
        <span
          ><AgentMark provider="claude" size={18} /><strong
            >{mapNodes.agents.items[1]}</strong
          ></span
        >
      </div>
      <div class="map-semantic-execution-steps">
        <span
          ><Icon name="ph:activity" size={18} aria-hidden="true" /><span
            ><strong>{mapNodes.work.title}</strong><small
              >{mapNodes.work.detail}</small
            ></span
          ></span
        >
        <span
          ><Icon name="ph:seal-check" size={18} aria-hidden="true" /><span
            ><strong>{mapNodes.record.title}</strong><small
              >{mapNodes.record.detail}</small
            ></span
          ></span
        >
      </div>
    </section>

    <section class="map-semantic-card" aria-labelledby="map-semantic-paths">
      <h3 id="map-semantic-paths">{authorityLabel}</h3>
      <ol class="map-semantic-paths">
        {
          relationships.map((relationship) => (
            <li>
              <span
                class:list={[
                  "legend-line",
                  `legend-line--${relationship.authority}`,
                ]}
              />
              <span>
                <strong>
                  {mapNodes[relationship.source].title}
                  <span aria-hidden="true"> → </span>
                  <span class="sr-only">to </span>
                  {mapNodes[relationship.destination].title}
                </strong>
                <small>
                  {modes[relationship.authority].label}: {relationship.detail}
                </small>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="map-semantic-card"
      aria-labelledby="map-semantic-foundation"
    >
      <h3 id="map-semantic-foundation">{foundationLabel}</h3>
      <div class="map-semantic-foundations">
        {
          foundations.map((foundation) => (
            <span>
              <Icon
                name={foundationIcons[foundation.id] ?? "ph:circle"}
                size={18}
                aria-hidden="true"
              />
              <span>
                <>
                  <strong>{foundation.title}</strong>
                  <small>{foundation.detail}</small>
                </>
              </span>
            </span>
          ))
        }
      </div>
    </section>
  </div>

  <div class="system-map__authority" aria-label={authorityLabel}>
    <span class="system-map__authority-label">{authorityLabel}</span>
    {
      authorityModes.map((mode) => (
        <span class="system-map__authority-mode">
          <i class:list={["legend-line", `legend-line--${mode.id}`]} />
          <span>
            <>
              <strong>{mode.label}</strong>
              <small>{mode.detail}</small>
            </>
          </span>
        </span>
      ))
    }
  </div>
</figure>

<style>
  .system-map {
    display: grid;
    gap: var(--s-4);
    margin: 0;
  }
  .system-map__caption {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--s-5);
  }
  .system-map__caption strong {
    justify-self: end;
    max-width: 56ch;
    color: var(--ink);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.35;
    text-align: right;
  }
  .system-map__canvas {
    padding: clamp(0.35rem, 1.5vw, 0.85rem);
    border-radius: var(--paper-radius);
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
    overflow: hidden;
  }
  .system-map__canvas > svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--paper-ink);
  }
  .map-loop {
    stroke-width: 1.5;
    marker-end: url(#map-loop-arrow);
  }
  .map-loop--attention {
    fill: color-mix(in srgb, var(--paper-accent) 4%, transparent);
    stroke: color-mix(in srgb, var(--paper-accent) 32%, transparent);
  }
  .map-loop--execution {
    fill: color-mix(in srgb, var(--paper-accent) 6%, transparent);
    stroke: color-mix(in srgb, var(--paper-accent) 42%, transparent);
  }
  :global(#map-loop-arrow path) {
    fill: var(--paper-accent);
  }
  .map-group,
  .map-node,
  .map-support {
    fill: var(--paper-surface-hover);
    stroke: color-mix(in srgb, var(--paper-muted) 24%, transparent);
    stroke-width: 1.4;
  }
  .map-group {
    fill: color-mix(
      in srgb,
      var(--paper-surface-hover) 82%,
      var(--paper-accent)
    );
  }
  .map-support {
    fill: color-mix(
      in srgb,
      var(--paper-surface-hover) 92%,
      var(--paper-accent)
    );
  }
  .map-center {
    fill: var(--paper-ink);
  }
  .map-life,
  .map-copy,
  .map-center-copy,
  .map-support-copy {
    width: 100%;
    height: 100%;
    color: var(--paper-ink);
    font-family: var(--sans);
  }
  .map-life {
    display: grid;
    align-content: start;
    gap: 0.62rem;
  }
  .map-domain {
    display: grid;
    gap: 0.18rem;
    padding: 0.54rem 0.62rem;
    border-radius: 0.55rem;
    background: var(--paper-surface);
  }
  .map-domain strong,
  .map-copy strong {
    font-size: 0.93rem;
    line-height: 1.08;
  }
  .map-domain > span:last-child,
  .map-detail {
    color: var(--paper-muted);
    font-size: 0.68rem;
    line-height: 1.3;
  }
  .map-identity,
  .map-agent {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    min-width: 0;
  }
  :global(.map-icon) {
    flex: 0 0 auto;
    width: 17px;
    height: 17px;
    color: var(--paper-accent);
  }
  .map-copy {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .map-kicker,
  .map-semantic-label,
  .system-map__authority-label {
    color: var(--paper-muted);
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .map-node-items,
  .map-semantic-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
  }
  .map-node-items span,
  .map-semantic-pills span {
    padding: 0.2rem 0.42rem;
    border-radius: 99px;
    background: color-mix(in srgb, var(--paper-accent) 10%, transparent);
    color: var(--paper-muted);
    font-size: 0.61rem;
    font-weight: 650;
    line-height: 1.2;
  }
  .map-center-copy {
    display: grid;
    place-content: center;
    gap: 0.08rem;
    color: var(--interactive-ink);
    text-align: center;
  }
  :global(.map-center-icon) {
    width: 19px;
    height: 19px;
    margin: 0 auto 0.12rem;
  }
  .map-center-copy strong {
    font-size: 0.82rem;
    line-height: 1;
  }
  .map-center-copy span {
    margin-top: 0.2rem;
    font-size: 0.55rem;
    opacity: 0.78;
  }
  .map-agent-list {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .map-agent strong {
    font-size: 0.78rem;
  }
  :global(.map-agent-icon) {
    width: 18px;
    height: 18px;
  }
  :global(.map-agent-icon--openai) {
    color: var(--paper-ink);
  }
  :global(.map-agent-icon--claude) {
    color: #d97757;
  }
  .map-support-copy {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 1rem;
  }
  .map-support-copy > span {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .map-support-copy > span > span {
    display: grid;
    gap: 0.08rem;
  }
  .map-support-copy strong {
    font-size: 0.76rem;
    line-height: 1.1;
  }
  .map-support-copy small {
    color: var(--paper-muted);
    font-size: 0.68rem;
    line-height: 1.2;
  }
  .map-loop-headings,
  .map-foundation-heading,
  .map-edge-labels {
    fill: var(--paper-muted);
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
  }
  .map-loop-headings {
    font-size: 12px;
    letter-spacing: 0.09em;
  }
  .map-foundation-heading {
    font-size: 10px;
    letter-spacing: 0.06em;
  }
  .map-edge-labels {
    font-size: 10.5px;
    letter-spacing: 0.025em;
  }
  .map-edge,
  .map-current {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map-edge {
    marker-end: url(#map-arrow);
    stroke: color-mix(in srgb, var(--paper-muted) 68%, transparent);
    stroke-width: 1.8;
  }
  .map-edge--with_me {
    stroke-dasharray: 2 7;
  }
  .map-edge--mixed {
    stroke-dasharray: 12 5 2 5;
  }
  :global(#map-arrow path) {
    fill: var(--paper-muted);
  }
  .map-current {
    stroke: var(--paper-accent);
    stroke-width: 3.6;
  }
  .map-current--attention {
    stroke-dasharray: 44 3260;
    animation: attention-current 13s linear infinite;
  }
  .map-current--execution {
    stroke-dasharray: 36 2100;
    animation: execution-current 9.5s linear infinite;
  }

  .system-map__semantic {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .system-map__authority {
    display: grid;
    grid-template-columns: auto repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--paper-radius);
    background: color-mix(in srgb, var(--paper-surface) 88%, transparent);
    color: var(--paper-ink);
  }
  .system-map__authority-mode {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2);
  }
  .system-map__authority-mode > span {
    display: grid;
    gap: 0.1rem;
  }
  .system-map__authority-mode strong {
    font-size: 0.75rem;
    line-height: 1.1;
  }
  .system-map__authority-mode small {
    color: var(--paper-muted);
    font-size: 0.64rem;
    line-height: 1.25;
  }
  .legend-line {
    width: 2rem;
    border-top: 2px solid var(--paper-muted);
