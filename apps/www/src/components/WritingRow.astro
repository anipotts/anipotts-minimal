---
import { formatDate, writingSlug, type Writing } from "../lib/content";

interface Props {
  item: Writing;
}

const { item } = Astro.props;
const slug = writingSlug(item);
const { title, summary, published_at, tags } = item.data;
---

<a href={`/writing/${slug}`} class="row-link">
  <span class="row-title">{title}</span>
  <span class="row-meta mono">
    {published_at && <span>{formatDate(published_at)}</span>}
    {tags.slice(0, 4).map((t) => <span>{t}</span>)}
  </span>
  <span class="row-dek">{summary}</span>
</a>

<style>
  .row-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .row-dek {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }
</style>
