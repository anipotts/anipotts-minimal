---
interface Props {
  mode?: "link" | "form";
  lede?: string;
  href?: string;
  ctaLabel?: string;
  footerText?: string;
  successMessage?: string;
  errorMessage?: string;
}

const {
  mode = "link",
  lede = "notes on agent workflows and product builds, including the parts that broke while shipping.",
  href = "https://news.anipotts.com",
  ctaLabel = "subscribe",
  footerText = "",
  successMessage = "subscribed. check your inbox.",
  errorMessage = "could not subscribe. try again in a minute.",
} = Astro.props;
---

<div class="subscribe card">
  <div class="copy">
    <span class="label mono">newsletter</span>
    <p class="lede">{lede}</p>
  </div>
  {
    mode === "form" ? (
      <>
        <form
          id="subscribe-form"
          class="row"
          data-success-message={successMessage}
          data-error-message={errorMessage}
        >
          <input
            class="hp"
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <input
            class="field"
            type="email"
            name="email"
            placeholder="you@wherever.com"
            aria-label="email address"
            required
          />
          <button class="fill" type="submit">
            {ctaLabel}
          </button>
        </form>
        <p class="status mono" id="subscribe-status" aria-live="polite" />
      </>
    ) : (
      <a class="fill cta" href={href}>
        {ctaLabel}
      </a>
    )
  }
  {footerText && <p class="footer mono">{footerText}</p>}
</div>

<style>
  .subscribe {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.82fr);
    align-items: end;
    gap: var(--s-5);
    width: 100%;
    max-width: none;
    padding: var(--s-4) 0;
    background: transparent;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-radius: 0;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .label {
    color: var(--ink-muted);
    font-size: 0.72rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .lede {
    margin: 0;
    max-width: none;
    color: var(--ink);
    font-size: var(--p-body);
    line-height: 1.45;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-2);
  }

  .row .field {
    min-width: 0;
    height: 44px;
    padding: 0;
    background: transparent;
    border-radius: 0;
    border-bottom: 1px solid var(--border);
    color: var(--ink-muted);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .row .field:focus {
    box-shadow: none;
    border-color: var(--accent);
  }

  .row .fill {
    height: 44px;
    min-height: 44px;
    border-radius: 0.45rem;
    padding-inline: var(--s-4);
  }

  .cta {
    justify-self: end;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.45rem;
    padding-inline: var(--s-4);
    text-decoration: none;
  }

  .status {
    grid-column: 2;
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
    min-height: 1em;
  }

  .footer {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  .status.ok {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .subscribe {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .row {
      grid-template-columns: 1fr;
    }

    .cta {
      justify-self: stretch;
    }

    .status {
      grid-column: auto;
    }
  }
</style>

<script>
  const form = document.getElementById("subscribe-form");
  const status = document.getElementById("subscribe-status");

  if (form instanceof HTMLFormElement && status) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const emailInput = form.elements.namedItem("email");
      if (!(emailInput instanceof HTMLInputElement)) return;

      const email = emailInput.value.trim();
      if (!email) return;
      status.textContent = "subscribing...";
      status.classList.remove("ok");

      try {
        const websiteInput = form.elements.namedItem("website");
        const website =
          websiteInput instanceof HTMLInputElement ? websiteInput.value : "";
        const res = await fetch("/api/newsletter/subscribe", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email, website }),
        });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent =
          form.dataset.successMessage ?? "subscribed. check your inbox.";
        status.classList.add("ok");
        form.reset();
        window.posthog?.capture?.("newsletter_subscribed");
      } catch {
        status.textContent =
          form.dataset.errorMessage ??
          "could not subscribe. try again in a minute.";
      }
    });
  }
</script>
