---
import InlineMention from "./InlineMention.astro";
import {
  segmentHomepageSummaryParagraph,
  type HomepageMention,
} from "@anipotts/content/public";

interface Props {
  paragraphs: string[];
  mentionKeys: string[];
  mentions: Record<string, HomepageMention>;
}

const { paragraphs, mentionKeys, mentions } = Astro.props;
const renderedParagraphs = paragraphs.map((paragraph) =>
  segmentHomepageSummaryParagraph(paragraph, mentionKeys, mentions),
);
---

{
  renderedParagraphs.map((segments) => (
    <span class="hero-sentence">
      {segments.map((segment) =>
        segment.kind === "text" ? (
          segment.text
        ) : (
          <InlineMention
            {...mentions[segment.key]}
            label={segment.text}
            suffix={segment.suffix}
          />
        ),
      )}
    </span>
  ))
}
