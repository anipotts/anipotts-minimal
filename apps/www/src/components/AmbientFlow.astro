---
interface Props {
  kind: "work" | "writing";
  seed: string;
  variant?: number;
}
const { kind, seed, variant } = Astro.props;
const mirrored =
  (variant ?? [...seed].reduce((sum, char) => sum + char.charCodeAt(0), 0)) %
    2 ===
  1;
// The same landscape is cropped at different scales, never stretched.
const paths = [
  "M-80 410C90 185 220 170 410 300S715 425 880 240 1100 135 1280 230V680H-80Z",
  "M-80 500C95 335 245 320 425 415S735 520 910 360 1110 285 1280 335V680H-80Z",
  "M-80 595C120 470 295 470 465 535S760 600 930 470 1120 435 1280 460V680H-80Z",
];
---

<span class:list={["ambient-flow", `ambient-flow--${kind}`]} aria-hidden="true">
  <svg
    viewBox="0 0 1200 600"
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
  >
    <g transform={mirrored ? "translate(1200 0) scale(-1 1)" : undefined}>
      {
        paths.map((d, index) => (
          <path
            class={`ambient-flow__shape ambient-flow__shape--${index + 1}`}
            d={d}
          />
        ))
      }
    </g>
  </svg>
</span>

<style>
  .ambient-flow {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    contain: strict;
    --flow-1: #83c7f4;
    --flow-2: #4d8bea;
    --flow-3: #174ee8;
    --flow-opacity: 0.64;
    --flow-shift: 0px;
  }
  .ambient-flow svg {
    position: absolute;
    inset: -6px;
    width: calc(100% + 12px);
    height: calc(100% + 12px);
    display: block;
    opacity: var(--flow-opacity);
    transform: translateY(var(--flow-shift));
    transition:
      transform 220ms ease,
      opacity 220ms ease;
  }
  .ambient-flow__shape--1 {
    fill: var(--flow-1);
  }
  .ambient-flow__shape--2 {
    fill: var(--flow-2);
  }
  .ambient-flow__shape--3 {
    fill: var(--flow-3);
  }
  .ambient-flow--writing {
    inset: auto -2rem -3rem auto;
    width: 20rem;
    height: 10rem;
    mask-image: linear-gradient(to right, transparent, black 45%);
    --flow-opacity: 0.28;
  }
  :global(html[data-theme="dark"]) .ambient-flow {
    --flow-1: #61abea;
    --flow-2: #3e82e8;
    --flow-3: #2459d8;
    --flow-opacity: 0.38;
  }
  :global(html[data-theme="dark"]) .ambient-flow--writing {
    --flow-opacity: 0.22;
  }

  @media (min-width: 880px) and (prefers-reduced-motion: no-preference) {
    :global(a:focus-visible) > .ambient-flow,
    :global(a:focus-visible .landscape-frame) > .ambient-flow {
      --flow-shift: -4px;
      --flow-opacity: 0.76;
    }
    :global(a:focus-visible) > .ambient-flow--writing {
      --flow-opacity: 0.4;
    }
  }
  @media (min-width: 880px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .ambient-flow,
    :global(a:hover .landscape-frame) > .ambient-flow {
      --flow-shift: -4px;
      --flow-opacity: 0.76;
    }
    :global(a:hover) > .ambient-flow--writing {
      --flow-opacity: 0.4;
    }
  }
  @media (width < 880px), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .ambient-flow__shape--3 {
      display: none;
    }
    .ambient-flow svg {
      transition: none;
      transform: none;
    }
    .ambient-flow--writing {
      width: 16rem;
      height: 8rem;
      bottom: -2.5rem;
    }
  }
</style>
