---
import type {
  SystemsAuthorityMode,
  SystemsMapDevice,
  SystemsMapDomain,
  SystemsMapFoundation,
  SystemsMapNode,
  SystemsMapRelationship,
} from "@anipotts/content/public";

// The single assistive-technology representation of the system. Every
// exploration renders exactly one of these alongside its decorative (aria
// hidden) diagram, at every viewport. It is not a visual fallback and is never
// shown; the diagram stays a diagram on every screen size.

interface Props {
  id: string;
  principle: string;
  domains: SystemsMapDomain[];
  nodes: SystemsMapNode[];
  foundationLabel: string;
  foundations: SystemsMapFoundation[];
  deviceLabel: string;
  devices: SystemsMapDevice[];
  authorityLabel: string;
  authorityModes: SystemsAuthorityMode[];
  relationships: SystemsMapRelationship[];
}

const {
  id,
  principle,
  domains,
  nodes,
  foundationLabel,
  foundations,
  deviceLabel,
  devices,
  authorityLabel,
  authorityModes,
  relationships,
} = Astro.props;

const nodeById = Object.fromEntries(nodes.map((n) => [n.id, n])) as Record<
  SystemsMapNode["id"],
  SystemsMapNode
>;
const modeById = Object.fromEntries(
  authorityModes.map((m) => [m.id, m]),
) as Record<SystemsAuthorityMode["id"], SystemsAuthorityMode>;
---

<div class="sr-only" id={id}>
  <h3>System topology, described</h3>
  <p>{principle}</p>

  <h4>{nodeById.life.title}</h4>
  <p>{nodeById.life.detail}</p>
  <dl>
    {
      domains.map((domain) => (
        <>
          <dt>{domain.label}</dt>
          <dd>
            {domain.detail}. Signals:{" "}
            {domain.sources
              .filter(({ kind }) => kind === "signal")
              .map((source) => `${source.label} (${source.mode})`)
              .join(", ")}
            . Authoritative records:{" "}
            {domain.sources
              .filter(({ kind }) => kind === "record")
              .map((source) => `${source.label} (${source.mode})`)
              .join(", ")}
            .
          </dd>
        </>
      ))
    }
  </dl>

  <h4>{nodeById.calendar.title}</h4>
  <p>{nodeById.calendar.detail}</p>

  <h4>{nodeById.ani.title}, {nodeById.ani.label}</h4>
  <p>{nodeById.ani.detail}</p>

  <h4>{nodeById.agents.title}</h4>
  <p>{nodeById.agents.detail}</p>

  <h4>Signal path</h4>
  <ol>
    {
      relationships.map((rel) => (
        <li>
          {rel.kind.replaceAll("_", " ")}: {nodeById[rel.source].title} to{" "}
          {nodeById[rel.destination].title}. {modeById[rel.authority].label}.{" "}
          {rel.detail}
        </li>
      ))
    }
  </ol>

  <h4>{authorityLabel}</h4>
  <ul>
    {
      authorityModes.map((mode) => (
        <li>
          {mode.label}: {mode.detail}
        </li>
      ))
    }
  </ul>

  <h4>{foundationLabel}</h4>
  <ul>
    {
      foundations.map((foundation) => (
        <li>
          {foundation.title}, {foundation.role} ({foundation.state}):{" "}
          {foundation.detail}
        </li>
      ))
    }
  </ul>

  <h4>{deviceLabel}</h4>
  <p>{nodeById.infrastructure.detail}</p>
  <ul>
    {
      devices.map((device) => (
        <li>
          {device.title}: {device.detail}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
