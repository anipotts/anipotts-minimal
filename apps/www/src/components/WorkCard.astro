---
import { Icon } from "astro-icon/components";
import type { Project } from "../lib/content";

interface Props {
  project: Project;
  variant?: "experience" | "project";
}

const { project, variant = project.data.kind } = Astro.props;
const d = project.data;
const identity = d.identity;
const preview = d.preview_media;
---

<a href={d.detail_path} class:list={["work-card", `work-card--${variant}`]}>
  {
    preview && (
      <span class="work-card__media" aria-hidden="true">
        {preview.kind === "video" ? (
          <video src={preview.src} muted playsinline preload="metadata" />
        ) : (
          <img src={preview.src} alt="" loading="lazy" decoding="async" />
        )}
      </span>
    )
  }
  <span class="work-card__body">
    <span class="work-card__header">
      <span class="work-card__identity">
        <span class="work-card__name">{d.title}</span>
        {
          identity.logo_src ? (
            <img
              class="work-card__mark"
              src={identity.logo_src}
              alt={identity.logo_alt ?? ""}
              loading="lazy"
              decoding="async"
            />
          ) : identity.icon ? (
            <Icon
              name={`ph:${identity.icon}`}
              class="work-card__mark work-card__glyph"
              aria-hidden="true"
            />
          ) : null
        }
      </span>
      <Icon name="ph:arrow-bend-right-up" class="work-card__affordance" />
    </span>
    <span class="work-card__copy">{d.card_copy}</span>
    {
      variant === "project" && (
        <span class="work-card__state mono">
          {d.status}
          <span aria-hidden="true">·</span>
          {d.year}
        </span>
      )
    }
  </span>
</a>

<style>
  .work-card {
    position: relative;
    display: block;
    min-height: 12rem;
    overflow: hidden;
    padding: var(--s-5);
    border-radius: 0.75rem;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      background 160ms ease,
      transform 160ms ease;
  }

  .work-card:hover {
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .work-card--experience {
    min-height: 13rem;
  }

  .work-card__media {
    grid-column: 1 / -1;
    margin: calc(-1 * var(--s-5)) calc(-1 * var(--s-5)) var(--s-4);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--accent-soft);
  }

  .work-card__media :is(img, video) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .work-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    justify-content: center;
  }

  .work-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .work-card__identity {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    width: fit-content;
  }

  .work-card__name {
    font-family: var(--display);
    font-size: var(--p-h2);
    font-weight: 900;
    line-height: 1;
    font-synthesis: none;
  }

  .work-card__mark {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    object-fit: contain;
  }

  .work-card__glyph {
    color: var(--ink-muted);
  }

  .work-card__copy {
    max-width: 38ch;
    color: var(--ink-muted);
    font-size: var(--p-small);
    line-height: 1.45;
  }

  .work-card__state {
    color: var(--ink-muted);
    font-size: 0.78rem;
  }

  .work-card__affordance {
    flex: 0 0 auto;
    color: var(--ink-muted);
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .work-card:hover .work-card__affordance {
    color: var(--interactive);
    transform: translate(0.14em, -0.14em);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-card__affordance {
      transition: none;
    }

    .work-card:hover {
      transform: none;
    }
  }
</style>
