---
import { Icon } from "astro-icon/components";
---

<footer id="contact" class="frame foot">
  <div class="contact-copy">
    <span>have a project, question, or useful overlap?</span>
    <a href="mailto:contact@anipotts.com" class="quiet-link mono"
      >contact@anipotts.com</a
    >
  </div>
  <span class="glyphs">
    <a
      href="https://github.com/anipotts"
      class="glyph"
      aria-label="github"
      target="_blank"
      rel="noopener noreferrer"><Icon name="ph:github-logo" /></a
    >
    <a
      href="https://x.com/anipottsbuilds"
      class="glyph"
      aria-label="x"
      target="_blank"
      rel="noopener noreferrer"><Icon name="ph:x-logo" /></a
    >
    <a
      href="https://www.linkedin.com/in/anipotts"
      class="glyph"
      aria-label="linkedin"
      target="_blank"
      rel="noopener noreferrer"><Icon name="ph:linkedin-logo" /></a
    >
    <a href="https://news.anipotts.com" class="glyph" aria-label="newsletter"
      ><Icon name="ph:envelope-open" /></a
    >
    <a href="/feed.xml" class="glyph" aria-label="rss feed"
      ><Icon name="ph:rss-simple" /></a
    >
    <a href="/admin" class="glyph admin-glyph" aria-label="admin"
      ><Icon name="ph:lock-key" /></a
    >
  </span>
</footer>

<style>
  .foot {
    margin-top: var(--s-8);
    padding-block: var(--s-6);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-5);
    font-size: var(--p-small);
  }

  .glyphs {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-2);
  }

  .contact-copy {
    display: grid;
    gap: 0.35rem;
  }

  .glyph {
    color: var(--ink-muted);
    transition: color 0.2s;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .glyph:hover {
    color: var(--interactive);
  }

  .admin-glyph {
    font-size: 0.95rem;
    opacity: 0.78;
  }
</style>
