---
import { Icon } from "astro-icon/components";
interface Mark {
  label: string;
  icon?: string;
  image?: string;
  darkImage?: string;
  color?: string;
  mono?: boolean;
}
const marks: Record<string, Mark> = {
  messages: {
    label: "Messages",
    image: "/brand/sources/messages.png",
  },
  gmail: { label: "Gmail", icon: "logos:google-gmail" },
  calendar: { label: "Google Calendar", icon: "logos:google-calendar" },
  notes: { label: "Apple Notes", image: "/brand/sources/notes.png" },
  youtube: { label: "YouTube", icon: "logos:youtube-icon" },
  x: { label: "X", icon: "simple-icons:x", mono: true },
  instagram: {
    label: "Instagram",
    image: "/brand/sources/instagram.jpg",
  },
  chrome: { label: "Chrome", icon: "logos:chrome" },
  linkedin: { label: "LinkedIn", image: "/brand/sources/linkedin.jpg" },
  spotify: { label: "Spotify", image: "/brand/sources/spotify.jpg" },
  whatsapp: { label: "WhatsApp", image: "/brand/sources/whatsapp.jpg" },
  granola: { label: "Granola", image: "/brand/sources/granola.png" },
  mercury: { label: "Mercury", image: "/brand/sources/mercury.jpg" },
  stripe: { label: "Stripe", image: "/brand/sources/stripe.jpg" },
  "mac-mini": { label: "Mac mini", image: "/brand/sources/mac-mini.png" },
  github: { label: "GitHub", icon: "simple-icons:github", mono: true },
  linear: { label: "Linear", icon: "simple-icons:linear", mono: true },
  tailscale: { label: "Tailscale", icon: "simple-icons:tailscale", mono: true },
  "1password": {
    label: "1Password",
    image: "/brand/sources/1password.png",
  },
  obsidian: { label: "Obsidian", image: "/brand/sources/obsidian.svg" },
  codex: {
    label: "Codex",
    image: "/brand/sources/codex-light.png",
    darkImage: "/brand/sources/codex.png",
  },
  claude: { label: "Claude Code", icon: "logos:claude-icon" },
};
interface Props {
  id: string;
  grouped?: boolean;
}
const { id, grouped = false } = Astro.props;
const mark = marks[id];
if (!mark) throw new Error(`Unknown workflow provider: ${id}`);
---

<span
  class:list={["provider-mark", { mono: mark.mono, grouped }]}
  data-provider={id}
  title={mark.label}
  style={mark.color ? `--provider-color:${mark.color}` : undefined}
>
  {
    mark.image ? (
      <>
        <img
          class:list={[id, { light: !!mark.darkImage }]}
          src={mark.image}
          width="36"
          height="36"
          alt={mark.label}
        />
        {mark.darkImage && (
          <img
            class:list={[id, "dark"]}
            src={mark.darkImage}
            width="36"
            height="36"
            alt={mark.label}
          />
        )}
      </>
    ) : (
      <Icon name={mark.icon!} size={26} title={mark.label} />
    )
  }
</span>
<style>
  .provider-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    box-sizing: border-box;
    border: 1px solid var(--app-tile-border);
    border-radius: 9px;
    background: var(--app-tile-bg);
    box-shadow: 0 1px 3px rgb(0 0 0 / 16%);
    color: var(--provider-color, #171717);
  }
  .grouped {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }
  :global([data-theme="dark"]) .mono {
    color: #fff;
  }
  img {
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 5px;
    max-width: none;
    object-fit: contain;
  }
  img.messages,
  img.notes,
  img[class="1password"] {
    width: 36px;
    height: 36px;
    border-radius: 0;
  }
  img.codex {
    width: 43px;
    height: 43px;
  }
  img.mac-mini {
    width: 48px;
    height: 48px;
  }
  .dark,
  :global([data-theme="dark"]) .light {
    display: none;
  }
  :global([data-theme="dark"]) .dark {
    display: block;
  }
</style>
