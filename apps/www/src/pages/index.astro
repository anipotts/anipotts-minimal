---
import Shell from "../layouts/Shell.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WritingRow from "../components/WritingRow.astro";
import NewsletterSubscribe from "../components/NewsletterSubscribe.astro";
import HomepageContextRail from "../components/HomepageContextRail.astro";
import { Icon } from "astro-icon/components";
import { publishedWriting, visibleProjects } from "../lib/content";
import {
  DEFAULT_HOMEPAGE_CONTENT,
  DEFAULT_NEWSLETTER_CONTENT,
  homepageSummaryText,
  normalizeHomepageContent,
  normalizeNewsletterContent,
} from "@anipotts/content/public";

export const prerender = false;

const cmsHome = normalizeHomepageContent(DEFAULT_HOMEPAGE_CONTENT);
const newsletterCopy = normalizeNewsletterContent(DEFAULT_NEWSLETTER_CONTENT);
const intro = cmsHome.sections.intro;
const work = cmsHome.sections.past_work;
const writing = cmsHome.sections.latest_thoughts;
const heading = intro.heading;
const proofCards = cmsHome.proof_cards;
const mentionMap = cmsHome.mentions;
const contextKeys = intro.mention_keys ?? [];
const selectedMakingSlugs = work.project_slugs ?? [];
const selectedWritingSlugs = writing.writing_slugs ?? [];
const homeMakingOrder = new Map<string, number>(
  selectedMakingSlugs.map((slug, index) => [slug, index]),
);
const homeWritingOrder = new Map<string, number>(
  selectedWritingSlugs.map((slug, index) => [slug, index]),
);
const projects = (await visibleProjects())
  .filter((project) => homeMakingOrder.has(project.slug))
  .sort(
    (a, b) =>
      (homeMakingOrder.get(a.slug) ?? 0) - (homeMakingOrder.get(b.slug) ?? 0),
  )
  .slice(0, work.limit ?? 4);
const writingEntries = (await publishedWriting())
  .filter((item) => homeWritingOrder.has(item.slug))
  .sort(
    (a, b) =>
      (homeWritingOrder.get(a.slug) ?? 0) - (homeWritingOrder.get(b.slug) ?? 0),
  )
  .slice(0, writing.limit ?? 3);
const workLabel = work.label || "making";
const workHref = work.view_all ?? work.links?.[0]?.href ?? "/making";
const summaryText = homepageSummaryText(cmsHome);
const summaryParts = summaryText.match(/^(.+?\.)\s+(.+)$/);
const introParagraphs =
  intro.paragraphs && intro.paragraphs.length > 1
    ? intro.paragraphs
    : summaryParts
      ? summaryParts.slice(1)
      : [summaryText];
const profileLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "Ani Potts",
    url: "https://anipotts.com",
    jobTitle: "builder and writer working with agents",
    sameAs: [
      "https://github.com/anipotts",
      "https://www.linkedin.com/in/anipotts",
      "https://x.com/anipottsbuilds",
      "https://news.anipotts.com",
    ],
  },
};
---

<Shell title="ani potts" description={summaryText} path="/" jsonLd={profileLd}>
  <section data-rise>
    <h1 class="home-hero">
      {heading}.
    </h1>
    <div class="hero-copy">
      {
        introParagraphs.map((paragraph, index) => (
          <p class:list={{ "hero-line": true, "hero-line-history": index > 0 }}>
            {paragraph}
          </p>
        ))
      }
    </div>
    <HomepageContextRail keys={contextKeys} mentions={mentionMap} />
    <div
      class="proof-grid mobile-carousel"
      aria-label="selected engineering proof"
    >
      {
        proofCards.map((item) => (
          <a href={item.href} class="proof-card">
            <span class="proof-label mono">{item.label}</span>
            <span class="proof-title">{item.title}</span>
            <span class="proof-detail">{item.detail}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    work.visible && (
      <section data-rise class="stack">
        <span class="head-row">
          <h2 class="section-label">{workLabel}</h2>
          <a href={workHref} class="quiet-link mono view-all">
            {work.links?.[0]?.label ?? "view all"}
            <Icon name="ph:arrow-bend-right-up" />
          </a>
        </span>
        <div class="grid mobile-carousel">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  {
    writing.visible && (
      <section data-rise class="stack">
        <span class="head-row">
          <h2 class="section-label">{writing.label}</h2>
          <a
            href={writing.view_all ?? "/writing"}
            class="quiet-link mono view-all"
          >
            {writing.links?.[0]?.label ?? "view all"}
            <Icon name="ph:arrow-bend-right-up" />
          </a>
        </span>
        <div class="list">
          {writingEntries.map((item) => (
            <WritingRow item={item} />
          ))}
        </div>
      </section>
    )
  }

  <section data-rise>
    <NewsletterSubscribe
      lede={newsletterCopy.deck}
      href={newsletterCopy.buttondown_url}
      ctaLabel={newsletterCopy.cta_label}
      footerText={newsletterCopy.footer_text}
    />
  </section>
</Shell>

<style>
  .home-hero {
    font-size: clamp(3rem, 12vw, 7rem);
    letter-spacing: 0;
    line-height: 0.9;
    margin-bottom: var(--s-4);
    font-weight: 900;
  }

  .hero-copy {
    display: grid;
    max-width: 45rem;
    gap: var(--s-2);
  }

  .hero-line {
    margin: 0;
    color: var(--ink);
    max-width: 43rem;
    font-size: clamp(1.08rem, 2.2vw, 1.42rem);
    line-height: 1.48;
    text-wrap: pretty;
  }

  .hero-line-history {
    max-width: 42rem;
    color: var(--ink-muted);
    font-size: clamp(0.98rem, 1.7vw, 1.12rem);
  }

  .text-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .text-link:hover {
    color: var(--interactive);
    text-decoration-color: var(--interactive);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .proof-card {
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-4);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .proof-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .proof-label {
    color: var(--ink-muted);
    font-size: 0.72rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .proof-title {
    font-family: var(--display);
    color: var(--ink);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
    font-synthesis: none;
  }

  .proof-detail {
    color: var(--ink-muted);
    font-size: var(--p-small);
    line-height: 1.45;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.85rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-4);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  @media (max-width: 960px) {
    .proof-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      margin-bottom: var(--s-3);
    }

    .hero-line {
      font-size: 1.05rem;
    }

    .proof-grid {
      grid-template-columns: 1fr;
    }

    .proof-card {
      min-height: 0;
    }
  }
</style>
