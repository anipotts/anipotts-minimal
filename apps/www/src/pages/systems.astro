---
import Shell from "../layouts/Shell.astro";
import SystemMap from "../components/SystemMap.astro";
import {
  DEFAULT_SYSTEMS_CONTENT,
  normalizeSystemsPageContent,
} from "@anipotts/content/public";

export const prerender = true;

const content = normalizeSystemsPageContent(DEFAULT_SYSTEMS_CONTENT);
---

<Shell title={content.title} description={content.description} path="/systems">
  <section>
    <h1 class="hero-title">{content.hero_title}</h1>
    <p class="hero-summary">{content.hero_summary}</p>
  </section>

  <section class="stack" aria-label="Working with agents">
    <p class="intro">{content.workflow.intro}</p>
    <SystemMap workflow={content.workflow} />
    <section class="example" aria-labelledby="example-heading">
      <h2 id="example-heading">{content.workflow.example.title}</h2>
      <p>{content.workflow.example.body}</p>
      <a href={content.workflow.example.href}
        >{content.workflow.example.link_label}</a
      >
    </section>
  </section>
</Shell>

<style>
  .stack {
    display: grid;
    gap: var(--s-6);
  }

  .intro,
  .example {
    max-width: 65ch;
  }
  .intro {
    font-size: 1.15rem;
    line-height: 1.65;
    margin: 0;
  }
  .example h2 {
    font-family: var(--sans);
    font-size: 1.35rem;
    font-weight: 650;
    margin: 0 0 var(--s-3);
  }
  .example p {
    color: var(--ink-muted);
    line-height: 1.7;
    margin: 0 0 var(--s-3);
  }
  .example a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    display: inline-block;
    padding-block: 0.5rem;
  }
  .example a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  @media (max-width: 699px) {
    .intro {
      font-size: 1.05rem;
    }
  }

  .hero-title {
    margin-bottom: var(--s-4);
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 0.9;
  }

  .hero-summary {
    max-width: none;
    font-size: clamp(1.08rem, 2.2vw, 1.42rem);
    line-height: 1.52;
    text-wrap: pretty;
  }

  @media (max-width: 620px) {
    .hero-title {
      margin-bottom: var(--s-3);
    }

    .hero-summary {
      font-size: 1.05rem;
    }
  }
</style>
