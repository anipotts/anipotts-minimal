---
import Shell from "../layouts/Shell.astro";
import NewsletterSubscribe from "../components/NewsletterSubscribe.astro";
import {
  fetchPageContent,
  normalizeNewsletterContent,
} from "@anipotts/lib/cms";
import { setDB } from "@anipotts/lib/db";
import type { D1Database } from "@anipotts/lib/db";

const archiveUrl = "/archive";
export const prerender = false;

setDB(Astro.locals.runtime.env.DB as unknown as D1Database);
const page = await fetchPageContent("newsletter");
const copy = normalizeNewsletterContent(page?.content);
---

<Shell
  title="newsletter"
  description="ani's notes on building with agents, software, and the small systems around them."
  path="/newsletter"
  canonicalUrl="https://news.anipotts.com"
>
  <section data-rise class="hero">
    <p class="section-label">newsletter</p>
    <h1 class="hero-title">{copy.headline}</h1>
    <p class="hero-summary">
      {copy.deck}
    </p>
  </section>

  <section data-rise>
    <NewsletterSubscribe
      mode="form"
      lede={copy.deck}
      ctaLabel={copy.cta_label}
      footerText={copy.footer_text}
      successMessage={copy.success_message}
      errorMessage={copy.error_message}
    />
  </section>

  <section data-rise class="stack">
    <h2 class="section-label">archive</h2>
    <p class="copy">published notes live here as the archive fills in.</p>
    <a href={archiveUrl} class="quiet-link archive"> read the archive </a>
  </section>
</Shell>

<style>
  .hero,
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-label {
    margin: 0;
  }

  .copy {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .archive {
    align-self: flex-start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
