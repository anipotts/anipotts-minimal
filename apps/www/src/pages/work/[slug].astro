---
import WorkDetail from "../../components/WorkDetail.astro";
import NotFoundPage from "../../components/NotFoundPage.astro";
import { projectSlug, visibleProjects } from "../../lib/content";

export const prerender = false;
const project = (await visibleProjects()).find(
  (candidate) => projectSlug(candidate) === (Astro.params.slug ?? ""),
);
if (!project) Astro.response.status = 404;
---

{project ? <WorkDetail project={project} /> : <NotFoundPage />}
