---
import WritingDetail from "../../components/WritingDetail.astro";
import NotFoundPage from "../../components/NotFoundPage.astro";
import { publishedWriting, writingSlug } from "../../lib/content";

export const prerender = false;
const item = (await publishedWriting()).find(
  (candidate) => writingSlug(candidate) === (Astro.params.slug ?? ""),
);
if (!item) Astro.response.status = 404;
---

{item ? <WritingDetail item={item} /> : <NotFoundPage />}
