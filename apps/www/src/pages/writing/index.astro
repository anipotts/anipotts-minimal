---
import Shell from "../../layouts/Shell.astro";
import WritingRow from "../../components/WritingRow.astro";
import { Icon } from "astro-icon/components";
import { publishedWriting } from "../../lib/content";
import {
  DEFAULT_WRITING_INDEX_CONTENT,
  normalizeListingPageContent,
} from "@anipotts/content/public";

export const prerender = false;

const writingEntries = await publishedWriting();
const copy = normalizeListingPageContent(
  DEFAULT_WRITING_INDEX_CONTENT,
  DEFAULT_WRITING_INDEX_CONTENT,
);
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/writing"
  mood="drowsy"
>
  <section data-rise>
    <h1 class="hero-title">{copy.hero_title}</h1>
    <p class="hero-summary">{copy.hero_summary}</p>
  </section>

  <section data-rise class="stack">
    <label class="search-wrap" for="writing-search">
      <Icon name="ph:magnifying-glass" class="search-glyph" />
      <input
        id="writing-search"
        class="field search"
        type="search"
        aria-label="search writing"
        placeholder={copy.search_placeholder ?? "search writing"}
        autocomplete="off"
      />
    </label>
    <p class="count mono" id="search-count" aria-live="polite"></p>
    <div class="list" id="writing-list">
      {writingEntries.map((item) => <WritingRow item={item} />)}
    </div>
    <template id="writing-result-template">
      <a class="card writing-card">
        <span class="head">
          <span class="title"></span>
          <Icon name="ph:arrow-bend-right-up" class="affordance" />
        </span>
        <span class="sub"></span>
        <span class="meta mono"><span class="search-date"></span></span>
      </a>
    </template>
  </section>
</Shell>

<style>
  .hero-title {
    margin-bottom: var(--s-3);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .search-wrap {
    position: relative;
    display: block;
    max-width: 28rem;
  }

  .search-glyph {
    position: absolute;
    left: var(--s-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-muted);
    pointer-events: none;
  }

  .search {
    padding-left: 2.6rem;
  }

  .count {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
    min-height: 1em;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .search-date {
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .search-summary {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }
</style>

<script>
  const input = document.getElementById("writing-search") as HTMLInputElement;
  const list = document.getElementById("writing-list")!;
  const count = document.getElementById("search-count")!;
  const resultTemplate = document.getElementById(
    "writing-result-template",
  ) as HTMLTemplateElement;
  const original = list.innerHTML;

  let timer: ReturnType<typeof setTimeout>;

  function resultRow(r: {
    slug: string;
    title: string;
    summary: string;
    date: string;
  }) {
    const row = resultTemplate.content.firstElementChild!.cloneNode(
      true,
    ) as HTMLAnchorElement;
    row.href = "/writing/" + encodeURIComponent(r.slug);
    row.querySelector<HTMLElement>(".title")!.textContent = r.title;
    row.querySelector<HTMLElement>(".sub")!.textContent = r.summary;
    row.querySelector<HTMLElement>(".search-date")!.textContent = r.date.slice(
      0,
      10,
    );
    return row;
  }

  async function run(q: string) {
    if (!q) {
      list.innerHTML = original;
      count.textContent = "";
      return;
    }
    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as {
        results: {
          slug: string;
          title: string;
          summary: string;
          date: string;
        }[];
      };
      count.textContent = `${data.results.length} result${data.results.length === 1 ? "" : "s"}`;
      list.replaceChildren(...data.results.map(resultRow));
    } catch {
      count.textContent = "search unavailable, showing everything";
      list.innerHTML = original;
    }
  }

  input?.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => run(input.value.trim()), 250);
  });
</script>
