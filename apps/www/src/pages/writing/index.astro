---
import Shell from "../../layouts/Shell.astro";
import WritingRow from "../../components/WritingRow.astro";
import { Icon } from "astro-icon/components";
import { publishedWriting } from "../../lib/content";
import { setDB } from "@anipotts/lib/db";
import type { D1Database } from "@anipotts/lib/db";

export const prerender = false;

setDB(Astro.locals.runtime.env.DB as unknown as D1Database);
const writingEntries = await publishedWriting();
---

<Shell
  title="writing"
  description="things ani's written. claude code workflows, ai builds, the occasional music take."
  path="/writing"
  mood="drowsy"
>
  <section data-rise>
    <h1 class="hero-title">writing</h1>
    <p class="hero-summary">stuff i've figured out and wanted to write down.</p>
  </section>

  <section data-rise class="stack">
    <label class="search-wrap" for="writing-search">
      <Icon name="ph:magnifying-glass" class="search-glyph" />
      <input
        id="writing-search"
        class="field search"
        type="search"
        placeholder="search writing"
        autocomplete="off"
      />
    </label>
    <p class="count mono" id="search-count" aria-live="polite"></p>
    <div class="list" id="writing-list">
      {writingEntries.map((item) => <WritingRow item={item} />)}
    </div>
  </section>
</Shell>

<style>
  .hero-title {
    margin-bottom: var(--s-3);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .search-wrap {
    position: relative;
    display: block;
    max-width: 28rem;
  }

  .search-glyph {
    position: absolute;
    left: var(--s-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-muted);
    pointer-events: none;
  }

  .search {
    padding-left: 2.6rem;
  }

  .count {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
    min-height: 1em;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .search-date {
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .search-summary {
    color: var(--ink-muted);
    font-size: var(--p-small);
  }
</style>

<script>
  const input = document.getElementById("writing-search") as HTMLInputElement;
  const list = document.getElementById("writing-list")!;
  const count = document.getElementById("search-count")!;
  const original = list.innerHTML;

  let timer: ReturnType<typeof setTimeout>;

  function resultRow(r: {
    slug: string;
    title: string;
    summary: string;
    date: string;
  }) {
    const row = document.createElement("a");
    row.href = "/writing/" + encodeURIComponent(r.slug);
    row.className = "row-link";

    const title = document.createElement("span");
    title.className = "row-title";
    title.textContent = r.title;

    const date = document.createElement("span");
    date.className = "mono search-date";
    date.textContent = r.date.slice(0, 10);

    const summary = document.createElement("span");
    summary.className = "search-summary";
    summary.textContent = r.summary;

    row.appendChild(title);
    row.appendChild(date);
    row.appendChild(summary);
    return row;
  }

  async function run(q: string) {
    if (!q) {
      list.innerHTML = original;
      count.textContent = "";
      return;
    }
    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as {
        results: {
          slug: string;
          title: string;
          summary: string;
          date: string;
        }[];
      };
      count.textContent = `${data.results.length} result${data.results.length === 1 ? "" : "s"}`;
      list.replaceChildren(...data.results.map(resultRow));
    } catch {
      count.textContent = "search unavailable, showing everything";
      list.innerHTML = original;
    }
  }

  input?.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => run(input.value.trim()), 250);
  });
</script>
