---
import Shell from "../../layouts/Shell.astro";
import WritingRow from "../../components/WritingRow.astro";
import PageHero from "../../components/PageHero.astro";
import { publishedWriting } from "../../lib/content";
import {
  DEFAULT_WRITING_INDEX_CONTENT,
  normalizeListingPageContent,
} from "@anipotts/content/public";

export const prerender = true;

const writingEntries = await publishedWriting();
const copy = normalizeListingPageContent(
  DEFAULT_WRITING_INDEX_CONTENT,
  DEFAULT_WRITING_INDEX_CONTENT,
);
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/writing"
  mood="drowsy"
>
  <PageHero title={copy.hero_title} summary={copy.hero_summary} />

  <section data-rise class="stack">
    <div class="list">
      {
        writingEntries.map((item, index) => (
          <WritingRow item={item} flowVariant={index} />
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
</style>
