---
import Shell from "../../layouts/Shell.astro";
import { Icon } from "astro-icon/components";
import { visibleProjects } from "../../lib/content";
import {
  DEFAULT_PROJECTS_INDEX_CONTENT,
  normalizeListingPageContent,
} from "@anipotts/content/public";

export const prerender = true;

const projects = await visibleProjects();
const copy = normalizeListingPageContent(
  DEFAULT_PROJECTS_INDEX_CONTENT,
  DEFAULT_PROJECTS_INDEX_CONTENT,
);
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/projects"
  mood="alert"
>
  <section data-rise>
    <h1 class="hero-title">{copy.hero_title}</h1>
    <p class="hero-summary">
      {copy.hero_summary}
      {
        copy.hero_link_label && copy.hero_link_href && (
          <>
            {" "}
            <a href={copy.hero_link_href} class="accent-link">
              {copy.hero_link_label}
            </a>
            .
          </>
        )
      }
    </p>
  </section>

  <section data-rise class="list">
    {
      projects.map((p) => (
        <a href={p.data.detail_path} class="row-link entry">
          <span class="line">
            <span class="row-title">{p.data.title}</span>
            <span class="mono muted">{p.data.year}</span>
            <span class="mono muted">{p.data.status}</span>
            <Icon name="ph:arrow-bend-right-up" class="affordance" />
          </span>
          <span class="dek">{p.data.card_copy}</span>
        </a>
      ))
    }
  </section>
</Shell>

<style>
  .hero-title {
    margin-bottom: var(--s-3);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .line .affordance {
    color: var(--ink-muted);
    margin-left: auto;
    transition:
      color 0.2s,
      transform 0.2s;
  }

  .entry:hover .affordance {
    color: var(--interactive);
    transform: translate(0.14em, -0.14em);
  }

  .dek {
    color: var(--ink-muted);
    font-size: var(--p-small);
    max-width: var(--measure);
  }
</style>
