---
import { render } from "astro:content";
import Shell from "../../../layouts/Shell.astro";
import { Icon } from "astro-icon/components";
import { formatDate, weeklyDigests } from "../../../lib/content";

export async function getStaticPaths() {
  const weeks = await weeklyDigests();
  return weeks.map((week) => ({
    params: { slug: week.data.week },
    props: { week },
  }));
}

const { week } = Astro.props;
const { Content } = await render(week);
const d = week.data;
---

<Shell
  title={`${d.week} digest`}
  description={`Autonomous activity for week ${d.week}: ${d.events} events across ${d.agents} agents`}
  path={`/running/weekly/${d.week}`}
>
  <section data-rise class="head">
    <a href="/running" class="quiet-link mono back">
      <Icon name="ph:arrow-bend-up-left" /> running
    </a>
    <h1 class="hero-title">{d.week}</h1>
    <p class="meta mono muted">
      <span>{formatDate(d.window_start)} to {formatDate(d.window_end)}</span>
      <span>{d.events} events{d.events_total ? ` of ${d.events_total} total` : ""}</span>
      <span>{d.agents} agents</span>
    </p>
    {
      d.highlights.length > 0 && (
        <ul class="highlights">
          {d.highlights.map((h) => (
            <li class="mono">{h}</li>
          ))}
        </ul>
      )
    }
  </section>

  <div data-rise class="article-body digest">
    <Content />
  </div>

  {
    d.generated_by && (
      <p data-rise class="mono muted gen">
        generated by {d.generated_by}
        {d.generated_at && ` at ${d.generated_at.toISOString()}`}
      </p>
    )
  }
</Shell>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.85rem;
    width: fit-content;
    min-height: 44px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin: 0;
    font-size: 0.85rem;
  }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    color: var(--accent);
    font-size: 0.85rem;
  }

  .digest {
    max-width: none;
  }

  .gen {
    font-size: 0.8rem;
  }
</style>
