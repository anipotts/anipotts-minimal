---
import Shell from "../../layouts/Shell.astro";
import {
  experimentSlug,
  formatDate,
  publishedExperiments,
  weeklyDigests,
} from "../../lib/content";

const weeks = await weeklyDigests();
const experiments = await publishedExperiments();
---

<Shell
  title="running"
  description="cron-written weekly digests, half-finished experiments, things in motion."
  path="/running"
  mood="jittery"
>
  <section data-rise>
    <h1 class="hero-title">running</h1>
    <p class="hero-summary">
      what's in motion. cron jobs writing weekly digests, half-finished
      experiments, the framework itself. finished work is everywhere else.
    </p>
  </section>

  <section data-rise class="stack">
    <h2 class="section-label">weekly digests</h2>
    <div class="list">
      {
        weeks.map((w) => (
          <a href={`/running/weekly/${w.data.week}`} class="row-link entry">
            <span class="row-title">{w.data.week}</span>
            <span class="meta mono">
              <span>
                {formatDate(w.data.window_start)} to{" "}
                {formatDate(w.data.window_end)}
              </span>
              <span>{w.data.events} events</span>
              <span>{w.data.agents} agents</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section data-rise class="stack">
    <h2 class="section-label">experiments</h2>
    <div class="list">
      {
        experiments.map((e) => (
          <a href={`/running/experiments/${experimentSlug(e)}`} class="row-link entry">
            <span class="row-title">{e.data.title}</span>
            <span class="meta mono">
              <span>{formatDate(e.data.date)}</span>
              {e.data.tags.map((t) => (
                <span>{t}</span>
              ))}
            </span>
            {e.data.summary && <span class="dek">{e.data.summary}</span>}
          </a>
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .hero-title {
    margin-bottom: var(--s-3);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .dek {
    color: var(--ink-muted);
    font-size: var(--p-small);
    max-width: var(--measure);
  }
</style>
