---
import Shell from "../../layouts/Shell.astro";
import {
  DEFAULT_NEWSLETTER_ARCHIVE_CONTENT,
  normalizeListingPageContent,
  type ListingPageContent,
} from "@anipotts/content/public";
import { fetchPageContent } from "@anipotts/lib/cms";
import { setDB } from "@anipotts/lib/db";
import type { D1Database } from "@anipotts/lib/db";
import { env } from "cloudflare:workers";

export const prerender = false;

setDB(env.DB as unknown as D1Database);
const page = await fetchPageContent<ListingPageContent>("newsletter_archive");
const copy = normalizeListingPageContent(
  page?.content,
  DEFAULT_NEWSLETTER_ARCHIVE_CONTENT,
);
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/newsletter/archive"
  canonicalUrl="https://news.anipotts.com/archive"
>
  <section data-rise class="stack">
    <p class="section-label">{copy.section_label || "archive"}</p>
    <h1 class="hero-title">{copy.hero_title}</h1>
    <p class="hero-summary">{copy.hero_summary}</p>
  </section>
</Shell>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-label {
    margin: 0;
  }
</style>
