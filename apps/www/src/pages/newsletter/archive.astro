---
import Shell from "../../layouts/Shell.astro";
import {
  DEFAULT_NEWSLETTER_ARCHIVE_CONTENT,
  normalizeListingPageContent,
} from "@anipotts/content/public";

export const prerender = false;

const copy = normalizeListingPageContent(
  DEFAULT_NEWSLETTER_ARCHIVE_CONTENT,
  DEFAULT_NEWSLETTER_ARCHIVE_CONTENT,
);
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/newsletter/archive"
  canonicalUrl="https://news.anipotts.com/archive"
>
  <section data-rise class="stack">
    <p class="section-label">{copy.section_label || "archive"}</p>
    <h1 class="hero-title">{copy.hero_title}</h1>
    <p class="hero-summary">{copy.hero_summary}</p>
  </section>
</Shell>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-label {
    margin: 0;
  }
</style>
