---
import Shell from "../layouts/Shell.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { visibleProjects, type Project } from "../lib/content";
import { setDB } from "@anipotts/lib/db";
import type { D1Database } from "@anipotts/lib/db";

export const prerender = false;

setDB(Astro.locals.runtime.env.DB as unknown as D1Database);
const ORCHESTRATING_PROJECTS = new Set(["claude-code-tips", "imessage-mcp"]);
const projects = (await visibleProjects()).filter(
  (project) => !ORCHESTRATING_PROJECTS.has(project.slug),
);

type BucketId = "active" | "past" | "archive";
const bucketFor = (project: Project): BucketId => {
  if (project.data.status === "archived") return "archive";
  const range = `${project.data.year} ${project.data.duration}`.toLowerCase();
  if (
    project.data.status === "wip" ||
    range.includes("ongoing") ||
    /2025-|2026-/.test(range)
  ) {
    return "active";
  }
  return "past";
};

const buckets: Array<{
  id: BucketId;
  label: string;
  note: string;
  projects: Project[];
}> = [
  {
    id: "active",
    label: "active",
    note: "things still moving or maintained",
    projects: projects.filter((project) => bucketFor(project) === "active"),
  },
  {
    id: "past",
    label: "past",
    note: "finished work and older receipts",
    projects: projects.filter((project) => bucketFor(project) === "past"),
  },
  {
    id: "archive",
    label: "archive",
    note: "sunsetted projects kept for context",
    projects: projects.filter((project) => bucketFor(project) === "archive"),
  },
];
---

<Shell
  title="making"
  description="projects, experiments, weekly traces, and small utilities from ani potts."
  path="/making"
  mood="alert"
>
  <section data-rise>
    <h1 class="hero-title">making</h1>
    <p class="hero-summary">
      work i built or helped ship. product surfaces, data systems, quant tools,
      and the older pieces that still explain how i think.
    </p>
  </section>

  <section data-rise class="catalog">
    <span class="section-head">
      <h2 class="section-label">projects</h2>
      <span class="mono muted">{projects.length} visible</span>
    </span>

    <div class="groups">
      {
        buckets
          .filter((bucket) => bucket.projects.length > 0)
          .map((bucket) => (
            <section class="bucket" aria-labelledby={`bucket-${bucket.id}`}>
              <span class="bucket-head">
                <h3 id={`bucket-${bucket.id}`} class="bucket-title">{bucket.label}</h3>
                <span class="mono muted">{bucket.note}</span>
              </span>
              <div class="grid mobile-carousel">
                {bucket.projects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            </section>
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .hero-title {
    margin-bottom: var(--s-3);
  }

  .catalog,
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .catalog {
    gap: var(--s-6);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }

  .bucket {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .bucket-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .bucket-title {
    font-size: var(--d-section);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-4);
  }

  @media (max-width: 720px) {
    .section-head,
    .bucket-head {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--s-1);
    }
  }
</style>
