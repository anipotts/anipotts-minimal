---
import Shell from "../layouts/Shell.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { visibleProjects, type Project } from "../lib/content";
import {
  DEFAULT_MAKING_INDEX_CONTENT,
  normalizeListingPageContent,
} from "@anipotts/content/public";

export const prerender = false;

const ORCHESTRATING_PROJECTS = new Set(["claude-code-tips", "imessage-mcp"]);
const allProjects = await visibleProjects();
const copy = normalizeListingPageContent(
  DEFAULT_MAKING_INDEX_CONTENT,
  DEFAULT_MAKING_INDEX_CONTENT,
);
const projects = allProjects.filter(
  (project) => !ORCHESTRATING_PROJECTS.has(project.slug),
);

type BucketId = "active" | "past" | "archive";
const bucketFor = (project: Project): BucketId => {
  if (project.data.status === "archived") return "archive";
  const range = `${project.data.year} ${project.data.duration}`.toLowerCase();
  if (
    project.data.status === "wip" ||
    range.includes("ongoing") ||
    /2025-|2026-/.test(range)
  ) {
    return "active";
  }
  return "past";
};
const bucketCopy = new Map(
  (copy.buckets ?? []).map((bucket) => [bucket.id, bucket]),
);
const bucketLabel = (id: BucketId) => bucketCopy.get(id)?.label ?? id;
const bucketNote = (id: BucketId) => bucketCopy.get(id)?.note ?? "";

const buckets: Array<{
  id: BucketId;
  label: string;
  note: string;
  projects: Project[];
}> = [
  {
    id: "active",
    label: bucketLabel("active"),
    note: bucketNote("active"),
    projects: projects.filter((project) => bucketFor(project) === "active"),
  },
  {
    id: "past",
    label: bucketLabel("past"),
    note: bucketNote("past"),
    projects: projects.filter((project) => bucketFor(project) === "past"),
  },
  {
    id: "archive",
    label: bucketLabel("archive"),
    note: bucketNote("archive"),
    projects: projects.filter((project) => bucketFor(project) === "archive"),
  },
];
---

<Shell
  title={copy.title}
  description={copy.description}
  path="/making"
  mood="alert"
>
  <section data-rise>
    <h1 class="hero-title">{copy.hero_title}</h1>
    <p class="hero-summary">{copy.hero_summary}</p>
  </section>

  <section data-rise class="catalog">
    <span class="section-head">
      <h2 class="section-label">projects</h2>
      <span class="mono muted">{projects.length} visible</span>
    </span>

    <div class="groups">
      {
        buckets
          .filter((bucket) => bucket.projects.length > 0)
          .map((bucket) => (
            <section class="bucket" aria-labelledby={`bucket-${bucket.id}`}>
              <span class="bucket-head">
                <h3 id={`bucket-${bucket.id}`} class="bucket-title">
                  {bucket.label}
                </h3>
                <span class="mono muted">{bucket.note}</span>
              </span>
              <div class="grid mobile-carousel">
                {bucket.projects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            </section>
          ))
      }
    </div>
  </section>
</Shell>

<style>
  .hero-title {
    margin-bottom: var(--s-3);
  }

  .catalog,
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .catalog {
    gap: var(--s-6);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }

  .bucket {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .bucket-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .bucket-title {
    font-size: var(--d-section);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-4);
  }

  @media (max-width: 720px) {
    .section-head,
    .bucket-head {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--s-1);
    }
  }
</style>
