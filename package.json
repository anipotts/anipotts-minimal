{
  "name": "anipotts.com",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Ani Potts",
  "homepage": "https://anipotts.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/anipotts/anipotts.com"
  },
  "description": "Personal website and content platform for anipotts.com",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "dev:www": "turbo dev --filter=@anipotts/www",
    "github:audit": "node scripts/github/audit-public-repos.mjs anipotts",
    "demo:capture": "node scripts/demos/capture-project-demo.mjs",
    "demo:capture:all": "node scripts/demos/capture-all-demos.mjs",
    "sync-thoughts": "npx tsx scripts/sync-thoughts.ts",
    "update-claude-stats": "node scripts/claude/generate-claude-stats.mjs",
    "update-claude-stats:commit": "scripts/claude/refresh-claude-stats.sh",
    "test:unit": "turbo test",
    "test:e2e": "pnpm --filter @anipotts/www test:e2e",
    "test": "pnpm test:unit && pnpm test:e2e",
    "validate": "turbo build && turbo lint && turbo typecheck && turbo test",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/www/**/*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored -c apps/www/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch@<4": "3.1.4",
      "minimatch@>=9": "9.0.7",
      "rollup@>=4 <4.59.0": "4.59.0",
      "flatted@<=3.4.1": "3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4"
    }
  },
  "devDependencies": {
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
