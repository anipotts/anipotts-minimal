<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.anipotts.claude-stats</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>cd /Users/anipotts/Code/active/websites/anipotts.com && ./scripts/claude/refresh-claude-stats.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/anipotts/Library/Logs/claude-stats.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anipotts/Library/Logs/claude-stats-error.log</string>
  </dict>
</plist>
