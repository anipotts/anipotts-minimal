{
  "name": "@anipotts/lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase/index.js"
    },
    "./posthog": {
      "types": "./dist/posthog/index.d.ts",
      "import": "./dist/posthog/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/index.d.ts",
      "import": "./dist/feature-flags/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "import": "./dist/status/index.js"
    },
    "./typefully": {
      "types": "./dist/typefully/index.d.ts",
      "import": "./dist/typefully/index.js"
    },
    "./cms": {
      "types": "./dist/cms/index.d.ts",
      "import": "./dist/cms/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anipotts/types": "workspace:*",
    "@supabase/supabase-js": "^2.86.0",
    "clsx": "^2.1.1",
    "posthog-node": "^5.17.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
